[system/proxy]
mode='manual'
use-same-proxy=true
ignore-hosts=['localhost', '127.0.0.1', '::1', '*.local', '10.*', '192.168.*', '172.16.*', '172.17.*', '172.18.*', '172.19.*', '172.20.*', '172.21.*', '172.22.*', '172.23.*', '172.24.*', '172.25.*', '172.26.*', '172.27.*', '172.28.*', '172.29.*', '172.30.*', '172.31.*']

[system/proxy/http]
host='127.0.0.1'
port=1

[system/proxy/https]
host='127.0.0.1'
port=1

[system/proxy/ftp]
host='127.0.0.1'
port=1

[system/proxy/socks]
host='127.0.0.1'
port=1
