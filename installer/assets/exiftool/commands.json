{
  "schema": 1,
  "integration": "exiftool",
  "purpose": "Inspect and remove embedded metadata; never delete files",
  "backend": "/usr/bin/exiftool",
  "gui": "shai-metadata",
  "offline": true,
  "execution": "argument-array-without-shell",
  "run_as": "desktop-user",
  "target": "user-selected absolute path; no symlink, device or filesystem root",
  "write_requires_confirmation": true,
  "keep_original_backups": true,
  "recipes": {
    "inspect_file": {"writes": false, "argv": ["/usr/bin/exiftool", "-json", "-G1", "--", "{target}"]},
    "inspect_folder_recursive": {"writes": false, "argv": ["/usr/bin/exiftool", "-json", "-G1", "-r", "--", "{target}"]},
    "remove_file_metadata": {"writes": true, "argv": ["/usr/bin/exiftool", "-all=", "--", "{target}"]},
    "remove_folder_metadata_recursive": {"writes": true, "argv": ["/usr/bin/exiftool", "-all=", "-r", "--", "{target}"]}
  },
  "not_supported": ["file deletion", "secure erasure", "unapproved background writes", "guaranteed anonymization"]
}
