[Unit]
Description=SHAI read-only host and container network snapshot
After=network.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/lib/shai-installer/shai-network-snapshot
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=shai
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadOnlyPaths=-/etc/shai -/run/docker.sock
ReadWritePaths=/run/shai
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

