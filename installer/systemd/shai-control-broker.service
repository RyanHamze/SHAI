[Unit]
Description=SHAI local Control Broker
After=network.target

[Service]
Type=simple
ExecStart=/usr/lib/shai-installer/shai-control-broker
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/shai /var/lib/shai/control /var/log/shai/control
StateDirectory=shai/control
StateDirectoryMode=0750
LogsDirectory=shai/control
LogsDirectoryMode=0750
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32

[Install]
WantedBy=multi-user.target
