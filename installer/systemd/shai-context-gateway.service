[Unit]
Description=SHAI private local AI context gateway
After=shai-aia-model.service
ConditionPathExists=%h/.local/state/shai/aia/server-api-key
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/lib/shai-installer/shai-context-gateway
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
NoNewPrivileges=true
# User mount namespaces block /proc peer-FD checks on Ubuntu. Preserve the
# upstream identity gate; this fixed-path helper remains an unprivileged UID.
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
MemoryMax=192M
CPUQuota=20%

[Install]
WantedBy=default.target
