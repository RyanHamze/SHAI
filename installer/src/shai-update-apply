#!/usr/bin/env python3
"""Fixed maintenance tasks, invoked only by SHAPP's approved sudo terminal."""
import argparse
import os
from pathlib import Path
import pwd
import re
import shutil
import subprocess

LIB = Path('/usr/lib/shai-installer')
ORDER = ('apt-refresh', 'apt-upgrade', 'apt-autoremove', 'apt-autoclean',
         'apt-dist-upgrade', 'snap-refresh', 'flatpak-update',
         'firmware-refresh', 'firmware-update', 'apt-check')
APT = ['apt-get', '-o', 'Acquire::ForceIPv4=true']
COMMANDS = {
    'apt-refresh': [[*APT, 'update']],
    'apt-upgrade': [[*APT, '--no-remove', '-y', 'upgrade']],
    'apt-dist-upgrade': [[*APT, '--no-remove', '-y', 'dist-upgrade']],
    'snap-refresh': [['snap', 'refresh']],
    'firmware-refresh': [['fwupdmgr', 'refresh']],
    'firmware-update': [['fwupdmgr', 'update', '-y', '--no-reboot-check', '--no-unreported-check']],
    'apt-autoclean': [[*APT, 'autoclean']],
    'apt-check': [[*APT, 'check'], ['dpkg', '--audit']],
}

def validate_tasks(tasks):
    if not isinstance(tasks, list) or any(not isinstance(item, str) for item in tasks):
        raise ValueError('updates must be a list of task IDs')
    if len(tasks) != len(set(tasks)) or not set(tasks) <= set(ORDER):
        raise ValueError('unknown or duplicate maintenance task')
    return [task for task in ORDER if task in tasks]

def invoke(command, *, capture=False, codes=(0,)):
    print('+', ' '.join(command), flush=True)
    result = subprocess.run(command, check=False, text=True,
                            stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.STDOUT if capture else None)
    if capture and result.stdout:
        print(result.stdout, end='', flush=True)
    if result.returncode not in codes:
        raise subprocess.CalledProcessError(result.returncode, command, output=result.stdout)
    if result.returncode == 2 and command[0] == 'fwupdmgr':
        print('No firmware action needed (fwupd exit 2).', flush=True)
    return result

def removed_packages(output):
    return sorted({line.split()[1].split(':')[0] for line in output.splitlines()
                   if line.startswith(('Remv ', 'Purg ')) and len(line.split()) > 1})

def protected(package):
    if package == 'shai-installer' or package.startswith(('linux-', 'grub', 'shim')):
        return True
    return any(re.search(line, package) for line in (LIB / 'PROTECTED_PACKAGES.regex').read_text().splitlines()
               if line and not line.startswith('#'))

def guarded_autoremove():
    preview = invoke([*APT, '-s', 'autoremove'], capture=True)
    candidates = removed_packages(preview.stdout)
    safe = [name for name in candidates if not protected(name)]
    skipped = sorted(set(candidates) - set(safe))
    if skipped:
        print('Preserving protected/kernel packages:', ', '.join(skipped), flush=True)
    if not safe:
        print('No safe unused dependencies to remove.', flush=True)
        return
    # An exact second simulation must not introduce collateral removals or installs.
    simulation = invoke([*APT, '-s', 'remove', '--', *safe], capture=True)
    if any(line.startswith('Inst ') for line in simulation.stdout.splitlines()):
        raise ValueError('Dependency cleanup would install packages; use Ubuntu package management')
    removed = removed_packages(simulation.stdout)
    if set(removed) - set(safe) or any(protected(name) for name in removed):
        raise ValueError('Dependency cleanup would remove additional/protected packages; nothing removed')
    invoke([*APT, '-y', 'remove', '--', *safe])

def audit(user, event, task, detail):
    subprocess.run([str(LIB / 'shai-shapp-log'), '--user', user, event,
                    'maintenance', task, detail], check=False)

def execute_task(task, account):
    executable = 'flatpak' if task == 'flatpak-update' else ('apt-get' if task == 'apt-autoremove' else COMMANDS[task][0][0])
    if not shutil.which(executable):
        message = f'Skipped: {executable} is not installed; no tool was installed automatically.'
        print(message, flush=True)
        audit(account.pw_name, 'SKIPPED', task, message)
        return
    if task == 'apt-autoremove':
        guarded_autoremove()
    elif task == 'flatpak-update':
        invoke(['flatpak', 'update', '--system', '-y'])
        invoke(['runuser', '-u', account.pw_name, '--', 'env', f'HOME={account.pw_dir}',
                f'XDG_RUNTIME_DIR=/run/user/{account.pw_uid}',
                f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{account.pw_uid}/bus',
                'flatpak', 'update', '--user', '-y'])
    else:
        if task in {'apt-upgrade', 'apt-dist-upgrade'}:
            mode = 'dist-upgrade' if task == 'apt-dist-upgrade' else 'upgrade'
            preview = invoke([*APT, '-s', mode], capture=True)
            if removed_packages(preview.stdout):
                raise ValueError('This update would remove packages. No removals are approved by an update checkbox; review through Ubuntu package management.')
        for command in COMMANDS[task]:
            invoke(command, codes=(0, 2) if command[0] == 'fwupdmgr' else (0,))
    audit(account.pw_name, 'UPDATED', task, 'Selected maintenance task completed; review terminal output')

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--user', required=True)
    parser.add_argument('--tasks', required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit('Use the approved SHAPP sudo terminal')
    account = pwd.getpwnam(args.user)
    if account.pw_uid < 1000:
        raise SystemExit('A regular desktop user is required')
    tasks = validate_tasks(args.tasks.split(',') if args.tasks else [])
    for task in tasks:
        print(f'\n=== {task} ===', flush=True)
        audit(account.pw_name, 'UPDATE_STARTED', task, 'Explicitly selected in SHAPP')
        try:
            execute_task(task, account)
        except (OSError, ValueError, subprocess.CalledProcessError) as exc:
            audit(account.pw_name, 'FAILED', task, str(exc))
            raise
    print('Selected maintenance tasks finished. Automatic updates and network policy were not changed.', flush=True)
    if Path('/var/run/reboot-required').exists():
        print('Ubuntu reports a reboot is required. Reboot manually when ready.', flush=True)

if __name__ == '__main__':
    try:
        main()
    except (OSError, KeyError, ValueError, subprocess.SubprocessError) as exc:
        raise SystemExit(f'Maintenance stopped: {exc}. Earlier tasks may already have completed; review this terminal and daily log.')
