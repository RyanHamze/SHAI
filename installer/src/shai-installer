#!/usr/bin/env bash
set -Eeuo pipefail

readonly SHAI_VERSION="0.1.2"
readonly LIB_DIR="/usr/lib/shai-installer"
readonly STATE_DIR="/var/lib/shai-installer"
readonly LOG_DIR="/var/log/shai-installer"
readonly LOCK_FILE="/run/lock/shai-installer.lock"

MODE="apply"
TARGET_USER="${SUDO_USER:-}"
CHECKPOINT_LABEL=""

usage() {
    cat <<'EOF'
Usage: sudo shai-installer [--assess|--status] [--user USER] [--checkpoint LABEL]

  --assess   Simulate and report without changing the computer.
  --status   Show whether the SHAI test profile has been applied.
  --user     Desktop user whose GNOME settings should be configured.
  --checkpoint
             Required for apply mode. Name of the verified VM checkpoint.
EOF
}

while (($#)); do
    case "$1" in
        --assess) MODE="assess" ;;
        --status) MODE="status" ;;
        --user)
            shift
            TARGET_USER="${1:?--user requires a username}"
            ;;
        --checkpoint)
            shift
            CHECKPOINT_LABEL="${1:?--checkpoint requires a label}"
            ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if [[ "$MODE" == "status" ]]; then
    if [[ -f "$STATE_DIR/applied-version" ]]; then
        printf 'SHAI test profile applied: %s\n' "$(cat "$STATE_DIR/applied-version")"
        [[ -f "$STATE_DIR/latest-run" ]] && printf 'Latest run: %s\n' "$(cat "$STATE_DIR/latest-run")"
    else
        printf 'SHAI test profile is not recorded as applied.\n'
    fi
    exit 0
fi

if [[ ${EUID} -ne 0 ]]; then
    printf 'Run this command with sudo: sudo shai-installer%s\n' "$([[ "$MODE" == assess ]] && printf ' --assess')" >&2
    exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    printf 'Another SHAI installer run is active.\n' >&2
    exit 1
fi

if [[ -z "$TARGET_USER" || "$TARGET_USER" == root ]]; then
    printf 'Unable to identify the desktop user. Use --user USER.\n' >&2
    exit 1
fi

if ! id "$TARGET_USER" >/dev/null 2>&1; then
    printf 'Desktop user does not exist: %s\n' "$TARGET_USER" >&2
    exit 1
fi

TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
readonly TARGET_HOME
STAMP="$(date +%Y%m%d-%H%M%S)"
readonly STAMP
readonly RUN_DIR="$STATE_DIR/runs/$STAMP"
readonly RUN_LOG="$LOG_DIR/shai-installer-$STAMP.log"

install -d -m 0750 "$RUN_DIR" "$LOG_DIR"
touch "$RUN_LOG"
chmod 0640 "$RUN_LOG"
exec > >(tee -a "$RUN_LOG") 2>&1

on_error() {
    local rc=$?
    printf '\nSHAI stopped after an error (exit %s). Review: %s\n' "$rc" "$RUN_LOG" >&2
    exit "$rc"
}
trap on_error ERR

run_as_user() {
    local uid runtime bus
    uid="$(id -u "$TARGET_USER")"
    runtime="/run/user/$uid"
    bus="$runtime/bus"
    if [[ -S "$bus" ]]; then
        runuser -u "$TARGET_USER" -- env \
            HOME="$TARGET_HOME" \
            XDG_RUNTIME_DIR="$runtime" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            "$@"
    else
        runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" \
            XDG_RUNTIME_DIR="$runtime" dbus-run-session -- "$@"
    fi
}

check_platform() {
    local os_id version arch desktop_ok=0
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    version="${VERSION_ID:-}"
    arch="$(dpkg --print-architecture)"

    [[ "$os_id" == ubuntu ]] || { printf 'Unsupported OS: %s\n' "$os_id" >&2; return 1; }
    [[ "$version" == 26.04 || "$version" == 26.04.1 ]] || {
        printf 'This test package supports Ubuntu 26.04 only; found %s.\n' "$version" >&2
        return 1
    }
    [[ "$arch" == amd64 ]] || { printf 'This test package supports amd64 only; found %s.\n' "$arch" >&2; return 1; }

    dpkg-query -W -f='${db:Status-Abbrev}' gnome-shell 2>/dev/null | grep -q '^ii' && desktop_ok=1
    ((desktop_ok == 1)) || { printf 'GNOME Shell is not installed.\n' >&2; return 1; }

    printf 'Host: %s\n' "$(hostname)"
    printf 'Ubuntu: %s (%s)\n' "$version" "$arch"
    printf 'Desktop user: %s\n' "$TARGET_USER"
    printf 'Network action: none; cached package state only\n'
}

preflight_health() {
    local audit_output available_kb lock
    audit_output="$(dpkg --audit)"
    [[ -z "$audit_output" ]] || {
        printf 'Preflight blocked: dpkg audit findings:\n%s\n' "$audit_output" >&2
        return 1
    }
    apt-get check >/dev/null
    [[ ! -e /var/run/reboot-required ]] || {
        printf 'Preflight blocked: Ubuntu requires a reboot. Reboot, then rerun SHAI.\n' >&2
        return 1
    }
    available_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
    ((available_kb >= 1048576)) || {
        printf 'Preflight blocked: less than 1 GiB is available on /.\n' >&2
        return 1
    }
    if command -v fuser >/dev/null 2>&1; then
        for lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock; do
            if fuser "$lock" >/dev/null 2>&1; then
                printf 'Preflight blocked: package-manager lock is active: %s\n' "$lock" >&2
                return 1
            fi
        done
    fi
    for command in apt-get dconf dbus-run-session dpkg-query flock gsettings python3 runuser snap systemctl; do
        command -v "$command" >/dev/null 2>&1 || {
            printf 'Preflight blocked: required command is missing: %s\n' "$command" >&2
            return 1
        }
    done
    printf 'Preflight health: PASS (dpkg, APT, locks, reboot state, disk, tools)\n'
}

backup_path() {
    local source="$1" destination="$RUN_DIR/backups/files$1"
    if [[ -e "$source" || -L "$source" ]]; then
        install -d "$(dirname "$destination")"
        cp -a -- "$source" "$destination"
        printf 'present\t%s\n' "$source" >> "$RUN_DIR/backups/file-manifest.tsv"
    else
        printf 'absent\t%s\n' "$source" >> "$RUN_DIR/backups/file-manifest.tsv"
    fi
}

capture_prechange_state() {
    local unit
    install -d -m 0700 "$RUN_DIR/backups"
    printf '%s\n' "$CHECKPOINT_LABEL" > "$RUN_DIR/checkpoint-label"
    printf '%s\n' "$TARGET_USER" > "$RUN_DIR/target-user"
    : > "$RUN_DIR/backups/file-manifest.tsv"
    for path in \
        /etc/apt/apt.conf.d/99-shai-manual-updates \
        /etc/dconf/db/local.d/20-shai-web-offline \
        /etc/dconf/profile/user \
        /etc/firefox/policies/policies.json \
        /usr/local/bin/shai-web-connectivity-toggle \
        /usr/share/applications/shai-web-connectivity-toggle.desktop \
        "$TARGET_HOME/Desktop/shai-web-connectivity-toggle.desktop"; do
        backup_path "$path"
    done
    : > "$RUN_DIR/backups/systemd-state.tsv"
    for unit in apt-daily.timer apt-daily-upgrade.timer update-notifier-download.timer \
        update-notifier-motd.timer fwupd-refresh.timer snapd.snap-repair.timer \
        geoclue.service whoopsie.service whoopsie.path; do
        printf '%s\t%s\t%s\n' "$unit" \
            "$(systemctl is-enabled "$unit" 2>/dev/null || true)" \
            "$(systemctl is-active "$unit" 2>/dev/null || true)" \
            >> "$RUN_DIR/backups/systemd-state.tsv"
    done
    {
        printf 'location\t%s\n' "$(run_as_user gsettings get org.gnome.system.location enabled)"
        printf 'reporting\t%s\n' "$(run_as_user gsettings get org.gnome.desktop.privacy report-technical-problems 2>/dev/null || printf unavailable)"
        printf 'proxy-mode\t%s\n' "$(run_as_user gsettings get org.gnome.system.proxy mode)"
        printf 'favorites\t%s\n' "$(run_as_user gsettings get org.gnome.shell favorite-apps)"
    } > "$RUN_DIR/backups/user-gsettings.tsv"
    snap refresh --time > "$RUN_DIR/backups/snap-refresh-time.txt" 2>&1 || true
}

installed_targets() {
    local list_file="$1" pkg
    while IFS= read -r pkg; do
        [[ -n "$pkg" && "$pkg" != \#* ]] || continue
        # Whoopsie is intentionally retained and disabled in the final validated state.
        [[ "$pkg" == whoopsie ]] && continue
        if dpkg-query -W -f='${db:Status-Abbrev}' "$pkg" 2>/dev/null | grep -q '^ii'; then
            printf '%s\n' "$pkg"
        fi
    done < "$list_file"
}

is_allowed_exception() {
    local wave="$1" pkg="$2" allowed
    [[ "$wave" == "02-print-scan-modem" || "$wave" == "combined" ]] || return 1
    while IFS= read -r allowed; do
        [[ -n "$allowed" && "$allowed" != \#* ]] || continue
        [[ "$pkg" == "$allowed" ]] && return 0
    done < "$LIB_DIR/catalog/02-print-scan-modem.allow-removals"
    return 1
}

gate_simulation() {
    local wave="$1" simulation="$2" pkg normalized pattern_file
    pattern_file="$LIB_DIR/PROTECTED_PACKAGES.regex"

    if grep -q '^Inst ' "$simulation"; then
        printf 'BLOCKED: %s would install packages during a removal-only wave.\n' "$wave" >&2
        return 1
    fi

    while read -r pkg; do
        normalized="${pkg%%:*}"
        while IFS= read -r regex; do
            [[ -n "$regex" && "$regex" != \#* ]] || continue
            if [[ "$normalized" =~ $regex ]]; then
                if is_allowed_exception "$wave" "$normalized"; then
                    printf 'Allowed package-set marker removal in %s: %s\n' "$wave" "$normalized"
                    break
                fi
                printf 'BLOCKED: %s simulation removes protected package %s\n' "$wave" "$normalized" >&2
                return 1
            fi
        done < "$pattern_file"
    done < <(awk '/^(Remv|Purg) / {print $2}' "$simulation")
}

prepare_wave() {
    local wave="$1" list_file="$2"
    local -a targets=()
    mapfile -t targets < <(installed_targets "$list_file")
    printf '%s\n' "${targets[@]}" > "$RUN_DIR/targets-$wave.txt"

    if ((${#targets[@]} == 0)); then
        printf '%-31s already clean\n' "$wave"
        return 0
    fi

    printf '%-31s requested=%s\n' "$wave" "${#targets[@]}"
}

simulate_wave() {
    local wave="$1" list_file="$2" simulation
    simulation="$RUN_DIR/simulate-$wave.txt"
    local -a targets=()
    prepare_wave "$wave" "$list_file"
    mapfile -t targets < <(sed '/^$/d' "$RUN_DIR/targets-$wave.txt")

    if ((${#targets[@]} == 0)); then
        : > "$simulation"
        return 0
    fi

    apt-get -s purge -- "${targets[@]}" > "$simulation"
    gate_simulation "$wave" "$simulation"
    printf '%-31s requested=%-3s simulated-removals=%s\n' \
        "$wave" "${#targets[@]}" "$(awk '/^(Remv|Purg) / {count++} END {print count+0}' "$simulation")"
}

simulate_combined() {
    local simulation="$RUN_DIR/simulate-combined.txt"
    local -a targets=()
    mapfile -t targets < <(cat "$RUN_DIR"/targets-*.txt | sed '/^$/d' | sort -u)
    if ((${#targets[@]} == 0)); then
        : > "$simulation"
        printf 'Combined final-state gate: no installed removal targets.\n'
        return 0
    fi
    apt-get -s purge -- "${targets[@]}" > "$simulation"
    gate_simulation combined "$simulation"
    printf 'Combined final-state gate: requested=%s simulated-removals=%s, PASS\n' \
        "${#targets[@]}" "$(awk '/^(Remv|Purg) / {count++} END {print count+0}' "$simulation")"
    awk '/^(Remv|Purg) / {print "  remove " $2}' "$simulation"
}

apply_wave() {
    local wave="$1"
    local -a targets=()
    # Re-simulate against the state produced by all preceding waves. The initial
    # preview is informative; this gate is authoritative for execution.
    simulate_wave "$wave" "$LIB_DIR/catalog/$wave.list"
    mapfile -t targets < <(sed '/^$/d' "$RUN_DIR/targets-$wave.txt")
    ((${#targets[@]} > 0)) || return 0
    printf '\nApplying %s...\n' "$wave"
    DEBIAN_FRONTEND=noninteractive apt-get --no-download -y purge -- "${targets[@]}"
    "$LIB_DIR/collect-debloat-benchmark" "installer-$wave" > "$RUN_DIR/benchmark-$wave.md"
    apt-get check
    dpkg --audit
}

configure_user_settings() {
    local favorites filtered
    run_as_user gsettings set org.gnome.system.location enabled false
    run_as_user gsettings set org.gnome.desktop.privacy report-technical-problems false || true
    run_as_user /usr/local/bin/shai-web-connectivity-toggle offline

    favorites="$(run_as_user gsettings get org.gnome.shell favorite-apps)"
    filtered="$(python3 - "$favorites" <<'PY'
import ast
import sys

items = ast.literal_eval(sys.argv[1])
remove = {
    "firefox_firefox.desktop",
    "snap-store_snap-store.desktop",
    "thunderbird_thunderbird.desktop",
    "org.gnome.Rhythmbox3.desktop",
    "libreoffice-writer.desktop",
    "org.gnome.Yelp.desktop",
}
items = [item for item in items if item not in remove]
if "org.gnome.Nautilus.desktop" not in items:
    items.insert(0, "org.gnome.Nautilus.desktop")
if "org.gnome.Ptyxis.desktop" not in items:
    items.append("org.gnome.Ptyxis.desktop")
print("[" + ", ".join(repr(item) for item in items) + "]")
PY
)"
    run_as_user gsettings set org.gnome.shell favorite-apps "$filtered"
}

install_validated_policy() {
    local desktop_dir="$TARGET_HOME/Desktop" path unit merged_policy
    install -m 0755 "$LIB_DIR/assets/shai-web-connectivity-toggle" /usr/local/bin/shai-web-connectivity-toggle
    install -m 0644 "$LIB_DIR/assets/shai-web-connectivity-toggle.desktop" /usr/share/applications/shai-web-connectivity-toggle.desktop
    install -d -m 0755 /etc/dconf/db/local.d /etc/dconf/profile /etc/firefox/policies
    install -m 0644 "$LIB_DIR/assets/20-shai-web-offline" /etc/dconf/db/local.d/20-shai-web-offline
    if [[ ! -f /etc/dconf/profile/user ]]; then
        install -m 0644 "$LIB_DIR/assets/dconf-user-profile" /etc/dconf/profile/user
    elif ! grep -Fxq 'system-db:local' /etc/dconf/profile/user; then
        printf '\nsystem-db:local\n' >> /etc/dconf/profile/user
    fi
    merged_policy="$RUN_DIR/firefox-policies.json"
    python3 - /etc/firefox/policies/policies.json "$merged_policy" <<'PY'
import json
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
data = json.loads(source.read_text()) if source.exists() else {}
policies = data.setdefault("policies", {})
policies["Proxy"] = {"Mode": "system", "Locked": True}
destination.write_text(json.dumps(data, indent=2) + "\n")
PY
    install -m 0644 "$merged_policy" /etc/firefox/policies/policies.json
    dconf update

    if [[ -d "$desktop_dir" ]]; then
        install -m 0755 -o "$TARGET_USER" -g "$(id -gn "$TARGET_USER")" \
            "$LIB_DIR/assets/shai-web-connectivity-toggle.desktop" \
            "$desktop_dir/shai-web-connectivity-toggle.desktop"
    fi

    "$LIB_DIR/configure-manual-updates"
    for unit in geoclue.service whoopsie.service whoopsie.path; do
        if systemctl cat "$unit" >/dev/null 2>&1; then
            systemctl mask --now "$unit"
        fi
    done

    while IFS= read -r path; do
        [[ -n "$path" && "$path" == /usr/share/themes/Yaru-* || "$path" == /usr/share/icons/Yaru-* ]] || continue
        [[ -e "$path" ]] && rm -rf --one-file-system -- "$path"
    done < "$LIB_DIR/catalog/09-yaru-color-variant-paths.list"

    configure_user_settings
}

health_check() {
    local failures audit_output
    apt-get check
    audit_output="$(dpkg --audit)"
    [[ -z "$audit_output" ]] || {
        printf 'Health check failed: dpkg audit findings:\n%s\n' "$audit_output" >&2
        return 1
    }
    for pkg in gdm3 gnome-shell gnome-control-center nautilus network-manager openssh-server snapd firefox packagekit; do
        dpkg-query -W -f='${db:Status-Abbrev}' "$pkg" 2>/dev/null | grep -q '^ii' || {
            printf 'Health check failed: protected package missing: %s\n' "$pkg" >&2
            return 1
        }
    done
    failures="$(systemctl --failed --no-legend --no-pager | wc -l)"
    [[ "$failures" == 0 ]] || { printf 'Health check failed: %s failed units\n' "$failures" >&2; return 1; }
    printf 'Health checks passed.\n'
}

clear_expected_removed_unit_failures() {
    if ! dpkg-query -W -f='${db:Status-Abbrev}' apport 2>/dev/null | grep -q '^ii'; then
        systemctl reset-failed apport.service 2>/dev/null || true
    fi
}

readonly -a WAVES=(
    01-applications
    02-print-scan-modem
    03-domain-and-remote-desktop
    04-reporting
    05-non-us-dictionaries
    06-filtered-orphans
    07-help
    09-extra-theme-packages
    10-personal-utilities
)

printf 'SHAI checkpoint-test installer %s\n' "$SHAI_VERSION"
printf '================================================\n'
check_platform
preflight_health
dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$RUN_DIR/packages-before.tsv"
"$LIB_DIR/collect-debloat-benchmark" installer-before > "$RUN_DIR/benchmark-before.md"

printf '\nSimulating exact validated removal waves...\n'
for wave in "${WAVES[@]}"; do
    prepare_wave "$wave" "$LIB_DIR/catalog/$wave.list"
done
simulate_combined

if snap list thunderbird >/dev/null 2>&1; then
    printf '%-31s installed and proposed for removal\n' "thunderbird-snap"
else
    printf '%-31s already clean\n' "thunderbird-snap"
fi

cat <<'EOF'

Validated configuration proposal:
  - keep Ubuntu, GNOME, Firefox, Snap, PackageKit, SSH, accessibility, and kernels
  - remove only the exact applications shown above; never broad-autoremove
  - disable scheduled APT, Snap, and firmware refreshes; retain manual updating
  - disable location and reporting services without removing GNOME integration
  - install the proxy-based Web Offline toggle and default Firefox to system proxy
  - unpin Firefox and App Center; pin Terminal; remove stale dock pins

Important: Web Offline is proxy-level control, not host firewall enforcement.
Rollback for this test is the Hyper-V checkpoint.
EOF

if [[ "$MODE" == "assess" ]]; then
    printf '\nAssessment complete. No changes were made.\nEvidence: %s\n' "$RUN_DIR"
    exit 0
fi

if [[ -z "$CHECKPOINT_LABEL" ]]; then
    printf '\nApply mode requires a verified checkpoint name.\n' >&2
    printf 'Example: sudo shai-installer --checkpoint "fresh-ubuntu-updated"\n' >&2
    exit 2
fi

printf '\nType APPLY to perform this exact proposal: '
read -r confirmation
[[ "$confirmation" == APPLY ]] || { printf 'Cancelled. No changes were made.\n'; exit 0; }
capture_prechange_state

for wave in "${WAVES[@]}"; do
    apply_wave "$wave"
done

if snap list thunderbird >/dev/null 2>&1; then
    snap remove thunderbird
fi

install_validated_policy
clear_expected_removed_unit_failures
health_check
dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$RUN_DIR/packages-after.tsv"
"$LIB_DIR/collect-debloat-benchmark" installer-after > "$RUN_DIR/benchmark-after.md"
printf '%s\n' "$SHAI_VERSION" > "$STATE_DIR/applied-version"
printf '%s\n' "$STAMP" > "$STATE_DIR/latest-run"

printf '\nSHAI checkpoint-test profile applied successfully.\n'
printf 'Evidence: %s\nLog: %s\n' "$RUN_DIR" "$RUN_LOG"
printf 'Reboot before completing desktop validation.\n'
