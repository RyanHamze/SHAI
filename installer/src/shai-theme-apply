#!/usr/bin/env bash
set -Eeuo pipefail

readonly THEME_NAME="SHAI"
readonly THEME_ROOT="${SHAI_THEME_ROOT:-/usr/share}"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shai-theme"
readonly PREVIOUS="$STATE_DIR/previous.json"
readonly STATUS="$STATE_DIR/status.json"
readonly GTK_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
readonly GTK_FILE="$GTK_DIR/gtk.css"
readonly GTK_SOURCE="$THEME_ROOT/themes/$THEME_NAME/gtk-4.0/gtk.css"
readonly WALLPAPER="$THEME_ROOT/backgrounds/shai/shai-wallpaper-1920x1080.png"
readonly USER_THEME_ID="user-theme@gnome-shell-extensions.gcampax.github.com"

if [[ ${EUID} -eq 0 ]]; then
    printf 'Run shai-theme-apply as the desktop user, not with sudo.\n' >&2
    exit 1
fi

for path in \
    "$GTK_SOURCE" \
    "$THEME_ROOT/themes/$THEME_NAME/gnome-shell/gnome-shell.css" \
    "$THEME_ROOT/icons/$THEME_NAME/index.theme" \
    "$WALLPAPER"; do
    [[ -f "$path" ]] || { printf 'Required SHAI theme asset is missing: %s\n' "$path" >&2; exit 1; }
done

command -v gsettings >/dev/null || { printf 'gsettings is required.\n' >&2; exit 1; }
install -d -m 0700 "$STATE_DIR" "$GTK_DIR"

if [[ -L "$GTK_FILE" ]]; then
    printf 'Refusing to replace symbolic link: %s\n' "$GTK_FILE" >&2
    exit 1
fi

if [[ ! -f "$PREVIOUS" ]]; then
    python3 - "$PREVIOUS" "$GTK_FILE" "$STATE_DIR/gtk.css.before" <<'PY'
import json
import pathlib
import shutil
import subprocess
import sys

destination = pathlib.Path(sys.argv[1])
gtk_file = pathlib.Path(sys.argv[2])
gtk_backup = pathlib.Path(sys.argv[3])
keys = {
    "color_scheme": ("org.gnome.desktop.interface", "color-scheme"),
    "icon_theme": ("org.gnome.desktop.interface", "icon-theme"),
    "accent_color": ("org.gnome.desktop.interface", "accent-color"),
    "picture_uri": ("org.gnome.desktop.background", "picture-uri"),
    "picture_uri_dark": ("org.gnome.desktop.background", "picture-uri-dark"),
    "picture_options": ("org.gnome.desktop.background", "picture-options"),
    "enabled_extensions": ("org.gnome.shell", "enabled-extensions"),
    "shell_theme": ("org.gnome.shell.extensions.user-theme", "name"),
}

def read(schema, key):
    result = subprocess.run(
        ["gsettings", "get", schema, key],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.stdout.strip() if result.returncode == 0 else None

settings = {name: read(*location) for name, location in keys.items()}
gtk_existed = gtk_file.is_file()
if gtk_existed:
    shutil.copy2(gtk_file, gtk_backup)

payload = {"schema": 1, "settings": settings, "gtk_css_existed": gtk_existed}
temporary = destination.with_suffix(".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
temporary.chmod(0o600)
temporary.replace(destination)
PY
    printf 'Saved the previous desktop theme settings in %s\n' "$PREVIOUS"
fi

gsettings set org.gnome.desktop.interface color-scheme prefer-dark
if gsettings range org.gnome.desktop.interface accent-color 2>/dev/null | grep -qw green; then
    gsettings set org.gnome.desktop.interface accent-color green
fi
gsettings set org.gnome.desktop.interface icon-theme "$THEME_NAME"
gsettings set org.gnome.desktop.background picture-uri "file://$WALLPAPER"
gsettings set org.gnome.desktop.background picture-uri-dark "file://$WALLPAPER"
gsettings set org.gnome.desktop.background picture-options zoom

if command -v shai-terminal-theme-apply >/dev/null 2>&1; then
    shai-terminal-theme-apply
fi

gtk_temp="$(mktemp "$GTK_DIR/.gtk.css.shai.XXXXXX")"
trap 'rm -f -- "$gtk_temp"' EXIT
install -m 0644 "$GTK_SOURCE" "$gtk_temp"
mv -f -- "$gtk_temp" "$GTK_FILE"
trap - EXIT

shell_status="pending-extension"
if gsettings list-schemas | grep -qx org.gnome.shell.extensions.user-theme; then
    enabled_extensions="$(python3 - "$USER_THEME_ID" <<'PY'
import ast
import subprocess
import sys

raw = subprocess.check_output(
    ["gsettings", "get", "org.gnome.shell", "enabled-extensions"], text=True
).strip()
if raw.startswith("@as "):
    raw = raw[4:]
items = ast.literal_eval(raw)
if sys.argv[1] not in items:
    items.append(sys.argv[1])
print(repr(items))
PY
)"
    gsettings set org.gnome.shell enabled-extensions "$enabled_extensions"
    shell_status="pending-login"
    if command -v gnome-extensions >/dev/null \
        && gnome-extensions list | grep -qx "$USER_THEME_ID"; then
        if gnome-extensions enable "$USER_THEME_ID"; then
            shell_status="enabled"
        fi
    fi
    gsettings set org.gnome.shell.extensions.user-theme name "$THEME_NAME"
fi

python3 - "$STATUS" "$shell_status" "$WALLPAPER" <<'PY'
import datetime
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
payload = {
    "schema": 1,
    "applied_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "theme": "SHAI",
    "gtk": "enabled",
    "icons": "enabled",
    "wallpaper": sys.argv[3],
    "shell": sys.argv[2],
}
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
temporary.chmod(0o600)
temporary.replace(path)
PY

printf 'SHAI wallpaper, GTK colors, icons, dark mode, and green accent are active.\n'
case "$shell_status" in
    enabled)
        printf 'SHAI GNOME Shell theme is enabled. Log out and back in if the panel does not refresh.\n'
        ;;
    pending-login)
        printf 'SHAI GNOME Shell theme is selected and will finish after the next login.\n'
        ;;
    *)
        printf 'GNOME Shell styling is pending. The optional Ubuntu package is gnome-shell-extension-user-theme.\n'
        printf 'SHAI Setup did not download it automatically.\n'
        ;;
esac
