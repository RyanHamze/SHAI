#!/usr/bin/env python3
"""Reviewed upstream installers with scoped keyrings and signature verification."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

def run(args, capture=False):
    print('+', ' '.join(args), flush=True)
    return subprocess.check_output(args, text=True) if capture else subprocess.run(args, check=True)

def download(url, target):
    run(['wget', '-4', '--https-only', '-O', str(target), url])

def check_key(path, expected):
    output = run(['gpg', '--batch', '--show-keys', '--with-colons', str(path)], True)
    fingerprints = [line.split(':')[9] for line in output.splitlines() if line.startswith('fpr:')]
    if not fingerprints or fingerprints[0] != expected:
        raise SystemExit('Publisher signing key fingerprint mismatch; refusing installation')

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('action', choices=['install', 'remove'])
    parser.add_argument('app', choices=['zeek', 'ntopng', 'veracrypt'])
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit('Use the approved SHAPP terminal')
    packages = {'zeek': 'zeek-9.0', 'ntopng': 'ntopng', 'veracrypt': 'veracrypt'}
    package = packages[args.app]
    if args.action == 'install' and args.app == 'ntopng':
        active = subprocess.run(['systemctl','is-active','--quiet','ntopng.service']).returncode == 0
        if active:
            raise SystemExit('An existing ntopng service is running. Preserve it and review its configuration before reinstalling through SHAPP.')
    if args.action == 'remove':
        output = run(['apt-get', '-s', 'remove', package], True)
        removed = [line.split()[1] for line in output.splitlines() if line.startswith('Remv ')]
        if any(name != package and not (args.app == 'zeek' and name.startswith(('zeek-9.0','zeekctl-9.0','libbroker-9.0'))) for name in removed):
            raise SystemExit('Removal affects other applications; use Ubuntu package management')
        run(['apt-get', '-y', 'remove', package])
        return
    release = {}
    for line in Path('/etc/os-release').read_text().splitlines():
        if '=' in line:
            key, value = line.split('=', 1); release[key] = value.strip('"')
    version = release.get('VERSION_ID')
    if release.get('ID') != 'ubuntu' or version not in {'24.04','26.04','26.10'}:
        raise SystemExit('No reviewed upstream recipe for this Ubuntu release; refusing a cross-release repository')
    arch = run(['dpkg', '--print-architecture'], True).strip()
    if arch not in {'amd64','arm64'}:
        raise SystemExit('No reviewed recipe for this architecture')
    if args.app == 'veracrypt' and arch != 'amd64':
        raise SystemExit('This reviewed Ubuntu DEB is amd64 only')
    run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', '-y', 'install', 'wget', 'ca-certificates', 'gnupg'])
    cache = Path('/var/cache/shai') / args.app
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    if args.app == 'veracrypt':
        filename = f'veracrypt-1.26.30-Ubuntu-{version}-amd64.deb'
        url = 'https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_1.26.30/' + filename
        key = cache / 'publisher.asc'
        download('https://amcrypto.jp/VeraCrypt/VeraCrypt_PGP_public_key.asc', key)
        check_key(key, '5069A233D55A0EEB174A5FC3821ACD02680D16DE')
        target = cache / filename
        signature = cache / (filename + '.sig')
        download(url, target); download(url + '.sig', signature)
        with tempfile.TemporaryDirectory() as home:
            run(['gpg', '--batch', '--homedir', home, '--import', str(key)])
            run(['gpg', '--batch', '--homedir', home, '--verify', str(signature), str(target)])
        run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', '-y', 'install', str(target)])
        print('VeraCrypt GUI installed. No containers, volumes or disks were encrypted.')
        return
    if args.app == 'zeek':
        url = f'https://download.opensuse.org/repositories/security:/zeek/xUbuntu_{version}/'
        key_url = url + 'Release.key'
        fingerprint = 'F9FA0223B56B116C363737EF5DA57BDD6DD785CA'
        suites, components = '/', ''
    else:
        url = f'https://packages.ntop.org/apt-stable/{version}/'
        key_url = 'https://packages.ntop.org/apt/ntop-minimal.key'
        fingerprint = '8E07231F05757F56FECE39773D84C955924F7599'
        suites, components = ('x64/' if arch == 'amd64' else 'arm64/'), ''
    key = cache / 'publisher.asc'; download(key_url, key); check_key(key, fingerprint)
    keyring = Path('/etc/apt/keyrings') / f'shai-{args.app}.gpg'
    keyring.parent.mkdir(parents=True, exist_ok=True)
    run(['gpg', '--batch', '--yes', '--dearmor', '--output', str(keyring), str(key)])
    keyring.chmod(0o644)
    source = Path('/etc/apt/sources.list.d') / f'shai-{args.app}.sources'
    text = f'Types: deb\nURIs: {url}\nSuites: {suites}\nArchitectures: {arch}\nSigned-By: {keyring}\n'
    if args.app == 'ntopng':
        text += f'\nTypes: deb\nURIs: {url}\nSuites: all/\nArchitectures: {arch}\nSigned-By: {keyring}\n'
    source.write_text(text); source.chmod(0o644)
    run(['apt-get', '-o', 'Acquire::ForceIPv4=true', 'update'])
    if args.app == 'ntopng':
        run(['systemctl', 'mask', '--runtime', 'ntopng.service'])
    try:
        run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', '--no-install-recommends', '-y', 'install', package])
    finally:
        if args.app == 'ntopng':
            subprocess.run(['systemctl', 'disable', '--now', 'ntopng.service'], check=False)
            subprocess.run(['systemctl', 'unmask', '--runtime', 'ntopng.service'], check=False)
    print('Runtime installed; packet capture is not activated. Configure an interface and privileges separately.')

if __name__ == '__main__': main()
