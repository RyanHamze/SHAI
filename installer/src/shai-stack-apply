#!/usr/bin/env python3
"""Apply a validated SHAI Advanced Compose service selection as root."""

from __future__ import annotations

import argparse
import json
import os
import platform
import pwd
import secrets
import shutil
import subprocess
import sys
from pathlib import Path


CATALOG = Path("/usr/lib/shai-installer/catalog/shai-stack-services.json")
ETC = Path("/etc/shai")
STACK = ETC / "stack"
SECRETS = ETC / "secrets"
DATA = Path("/var/lib/shai/stack")
STATE = DATA / "installed.json"
REGISTRY = ETC / "service-registry.json"
LOCK = STACK / "images.lock.json"
SUPPORTED = {"mosquitto", "home-assistant", "zigbee2mqtt", "open-webui", 'esphome', 'node-red', 'openhab', 'jellyfin', 'plex', 'emby', 'navidrome', 'zwavejs', 'adguard-home', 'pi-hole', 'emoncms', 'matter-server'}


def run(args: list[str], *, input_text: str | None = None, capture: bool = False) -> str:
    print("+", " ".join(args), flush=True)
    result = subprocess.run(
        args, check=True, text=True, input=input_text,
        stdout=subprocess.PIPE if capture else None,
    )
    return result.stdout.strip() if capture else ""


def load_catalog() -> dict[str, dict[str, object]]:
    data = json.loads(CATALOG.read_text(encoding="utf-8"))
    return data["services"]


def observer_image() -> str:
    data = json.loads(CATALOG.read_text(encoding="utf-8"))
    return str(data["infrastructure"]["engine-observer"]["image"])


def installed() -> set[str]:
    try:
        data = json.loads(STATE.read_text(encoding="utf-8"))
        return set(data.get("services", [])) & SUPPORTED
    except (OSError, json.JSONDecodeError, AttributeError):
        return set()


def hardware_assessment(selected: set[str], catalog: dict[str, dict[str, object]]) -> None:
    logical = os.cpu_count() or 0
    machine = platform.machine().lower()
    mem_kb = 0
    for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
        if line.startswith("MemTotal:"):
            mem_kb = int(line.split()[1]); break
    total_ram = mem_kb // 1024
    free_disk = shutil.disk_usage("/var/lib").free // (1024 * 1024)
    workload_ram = sum(int(catalog[item]["minimum_ram_mb"]) for item in selected)
    workload_disk = sum(int(catalog[item]["minimum_disk_mb"]) for item in selected)
    required_ram = 2048 + workload_ram
    required_disk = 10240 + workload_disk
    failures = []
    if machine not in {"x86_64", "amd64", "aarch64", "arm64"}:
        failures.append(f"architecture {machine} is not in SHAI's tested 64-bit set")
    if logical < 2:
        failures.append(f"{logical} logical CPU detected; at least 2 required")
    if total_ram < required_ram:
        failures.append(f"{total_ram} MB RAM detected; selected workload plus Ubuntu reserve requires {required_ram} MB")
    if free_disk < required_disk:
        failures.append(f"{free_disk} MB free on /var/lib; selected workload plus safety reserve requires {required_disk} MB")
    print("\nSHAI Advanced hardware assessment")
    print(f"  CPU: {logical} logical cores ({machine})")
    print(f"  RAM: {total_ram} MB installed; {required_ram} MB selected-workload requirement")
    print(f"  Disk: {free_disk} MB free; {required_disk} MB selected-workload requirement")
    if failures:
        print("\nNOT SUFFICIENT HARDWARE RESOURCES FOR THE SELECTED DOCKER WORKLOAD", file=sys.stderr)
        for failure in failures:
            print(f"  FAIL: {failure}", file=sys.stderr)
        raise SystemExit(3)
    print("  Overall: PASS")


def install_engine() -> None:
    if shutil.which("docker"):
        run(["docker", "version"])
        run(["docker", "compose", "version"])
        return
    conflicts = [
        package for package in ("docker.io", "docker-compose", "docker-compose-v2", "podman-docker", "containerd", "runc")
        if subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}", package],
                          check=False, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL).stdout.startswith("ii")
    ]
    if conflicts:
        raise SystemExit(
            "Existing container packages require a manual migration review before installing "
            f"Docker Engine: {', '.join(conflicts)}"
        )
    run(["apt-get", "update"])
    run(["apt-get", "-y", "install", "ca-certificates", "curl"])
    Path("/etc/apt/keyrings").mkdir(parents=True, exist_ok=True)
    run(["curl", "-fsSL", "https://download.docker.com/linux/ubuntu/gpg", "-o", "/etc/apt/keyrings/docker.asc"])
    Path("/etc/apt/keyrings/docker.asc").chmod(0o644)
    os_release = {}
    for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
        if "=" in line:
            key, value = line.split("=", 1); os_release[key] = value.strip('"')
    codename = os_release.get("VERSION_CODENAME", "")
    if not codename:
        raise SystemExit("Ubuntu VERSION_CODENAME is unavailable")
    architecture = run(["dpkg", "--print-architecture"], capture=True)
    source = Path("/etc/apt/sources.list.d/docker.sources")
    source.write_text(
        "Types: deb\nURIs: https://download.docker.com/linux/ubuntu\n"
        f"Suites: {codename}\nComponents: stable\nArchitectures: {architecture}\n"
        "Signed-By: /etc/apt/keyrings/docker.asc\n",
        encoding="utf-8",
    )
    source.chmod(0o644)
    run(["apt-get", "update"])
    run(["apt-get", "-y", "install", "docker-ce", "docker-ce-cli", "containerd.io",
         "docker-buildx-plugin", "docker-compose-plugin"])
    run(["systemctl", "enable", "--now", "docker.service", "containerd.service"])
    run(["docker", "version"]); run(["docker", "compose", "version"])


def serial_device() -> str:
    devices = sorted(Path("/dev/serial/by-id").glob("*")) if Path("/dev/serial/by-id").is_dir() else []
    if len(devices) != 1:
        found = ", ".join(str(item) for item in devices) or "none"
        raise SystemExit(
            "Zigbee2MQTT requires exactly one reviewed stable /dev/serial/by-id device for this "
            f"initial backend; detected: {found}"
        )
    return str(devices[0])


def ensure_mqtt_credentials(image: str) -> tuple[str, str]:
    credentials = SECRETS / "mqtt-credentials.json"
    passwd = DATA / "mosquitto/config/passwd"
    if credentials.exists() and passwd.exists():
        data = json.loads(credentials.read_text(encoding="utf-8"))
        return str(data["username"]), str(data["password"])
    username, password = "shai", secrets.token_urlsafe(24)
    credentials.write_text(json.dumps({"username": username, "password": password}, indent=2) + "\n", encoding="utf-8")
    credentials.chmod(0o600)
    passwd.parent.mkdir(parents=True, exist_ok=True)
    run(["docker", "run", "--rm", "-i", "-v", f"{passwd.parent}:/work", image,
         "sh", "-c", "read -r password; mosquitto_passwd -b -c /work/passwd shai \"$password\""],
        input_text=password + "\n")
    passwd.chmod(0o644)
    return username, password


def aia_credentials() -> tuple[str, str]:
    """Return the selected desktop user's local AIA API key and a stable UI secret."""
    user = os.environ.get("SUDO_USER", "")
    if not user:
        raise SystemExit("Open WebUI requires SHAPP to run from a desktop user's visible sudo terminal")
    try:
        home = Path(pwd.getpwnam(user).pw_dir)
    except KeyError as exc:
        raise SystemExit(f"Open WebUI desktop user does not exist: {user}") from exc
    config_path = home / ".config/shai/aia.json"
    key_path = home / ".local/state/shai/aia/server-api-key"
    try:
        active = str(json.loads(config_path.read_text(encoding="utf-8")).get("active_model", ""))
        api_key = key_path.read_text(encoding="utf-8").strip()
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit("Open AIA, choose an active local model, and wait for its model service before installing Open WebUI") from exc
    if not active or not api_key:
        raise SystemExit("Open AIA, choose an active local model, and wait for its model service before installing Open WebUI")
    secret_path = SECRETS / "open-webui-secret"
    if secret_path.exists():
        webui_secret = secret_path.read_text(encoding="utf-8").strip()
    else:
        webui_secret = secrets.token_urlsafe(48)
        secret_path.write_text(webui_secret + "\n", encoding="utf-8")
        secret_path.chmod(0o600)
    return api_key, webui_secret


def control_credentials() -> str:
    """Ensure and return the proposal-only Open WebUI credential."""
    token_path = SECRETS / "control-webui-token"
    if token_path.exists():
        return token_path.read_text(encoding="utf-8").strip()
    value = secrets.token_urlsafe(48)
    token_path.write_text(value + "\n", encoding="utf-8")
    token_path.chmod(0o600)
    return value


def compose_text(
    selected: set[str],
    catalog: dict[str, dict[str, object]],
    zigbee: str | None,
    observer: str,
) -> str:
    lines = ["name: shai", "services:"]
    lines += [
        "  engine-observer:",
        f"    image: {observer}",
        "    container_name: shai-engine-observer",
        "    restart: unless-stopped",
        "    read_only: true",
        "    security_opt: [no-new-privileges:true]",
        "    cap_drop: [ALL]",
        "    environment:",
        "      CONTAINERS: '1'",
        "      EVENTS: '1'",
        "      INFO: '1'",
        "      PING: '1'",
        "      VERSION: '1'",
        "      POST: '0'",
        "      EXEC: '0'",
        "      IMAGES: '0'",
        "      NETWORKS: '0'",
        "      VOLUMES: '0'",
        "      SYSTEM: '0'",
        "    volumes:",
        "      - /var/run/docker.sock:/var/run/docker.sock:ro",
        "    tmpfs:",
        "      - /tmp:rw,noexec,nosuid,size=8m",
        "      - /run:rw,noexec,nosuid,size=8m",
        "    networks: [shai-observer]",
        "    profiles: [observer]",
    ]
    if "mosquitto" in selected:
        lines += [
            "  mosquitto:", f"    image: {catalog['mosquitto']['image']}",
            "    container_name: shai-mosquitto", "    restart: unless-stopped",
            "    security_opt: [no-new-privileges:true]",
            "    volumes:", "      - /var/lib/shai/stack/mosquitto/config:/mosquitto/config:ro",
            "      - /var/lib/shai/stack/mosquitto/data:/mosquitto/data",
            "      - /var/lib/shai/stack/mosquitto/log:/mosquitto/log",
            "    networks: [shai-automation]", "    profiles: [mosquitto]",
        ]
    if "home-assistant" in selected:
        lines += [
            "  home-assistant:", f"    image: {catalog['home-assistant']['image']}",
            "    container_name: shai-home-assistant", "    restart: unless-stopped",
            "    stop_grace_period: 60s", "    security_opt: [no-new-privileges:true]",
            "    environment:", "      TZ: ${TZ}",
            "    volumes:", "      - /var/lib/shai/stack/homeassistant:/config",
            "    ports:", "      - 127.0.0.1:8123:8123",
            "    networks: [shai-automation, shai-lan]", "    profiles: [home-assistant]",
        ]
    if "zigbee2mqtt" in selected and zigbee:
        lines += [
            "  zigbee2mqtt:", f"    image: {catalog['zigbee2mqtt']['image']}",
            "    container_name: shai-zigbee2mqtt", "    restart: unless-stopped",
            "    security_opt: [no-new-privileges:true]",
            "    environment:", "      TZ: ${TZ}",
            "    volumes:", "      - /var/lib/shai/stack/zigbee2mqtt:/app/data",
            "    devices:", f"      - {zigbee}:/dev/ttyZigbee",
            "    ports:", "      - 127.0.0.1:8080:8080",
            "    networks: [shai-automation]", "    profiles: [zigbee2mqtt]",
        ]
    if "open-webui" in selected:
        lines += [
            "  open-webui:", f"    image: {catalog['open-webui']['image']}",
            "    container_name: shai-open-webui", "    restart: unless-stopped",
            "    network_mode: host", "    security_opt: [no-new-privileges:true]",
            "    cap_drop: [ALL]", "    environment:",
            "      HOST: 127.0.0.1", "      PORT: '3000'", "      WEBUI_AUTH: 'true'",
            "      ENABLE_SIGNUP: 'true'", "      ENABLE_OLLAMA_API: 'false'",
            "      ENABLE_OPENAI_API: 'true'", "      OPENAI_API_BASE_URL: http://127.0.0.1:11435/v1",
            "      OPENAI_API_KEY: ${AIA_API_KEY}", "      WEBUI_SECRET_KEY: ${OPEN_WEBUI_SECRET}",
            "      ENABLE_PERSISTENT_CONFIG: 'false'", "      ENABLE_TOOL_SERVERS: 'true'",
            "      TOOL_SERVER_CONNECTIONS: '[{\"type\":\"openapi\",\"url\":\"http://127.0.0.1:11500\",\"spec_type\":\"url\",\"spec\":\"\",\"path\":\"openapi.json\",\"auth_type\":\"bearer\",\"key\":\"${SHAI_CONTROL_TOKEN}\",\"config\":{\"enable\":true},\"info\":{\"id\":\"shai-local-control\",\"name\":\"SHAI Local Control\",\"description\":\"Read SHAI inventory and create approval-required proposals.\"}}]'",
            "      SHAI_CONTROL_URL: http://127.0.0.1:11500/v1",
            "      SHAI_CONTROL_TOKEN: ${SHAI_CONTROL_TOKEN}",
            "      OFFLINE_MODE: 'true'", "      HF_HUB_OFFLINE: '1'",
            "      DO_NOT_TRACK: 'true'", "      ANONYMIZED_TELEMETRY: 'false'",
            "      CORS_ALLOW_ORIGIN: http://127.0.0.1:3000;http://localhost:3000",
            "      REFERRER_POLICY: no-referrer", "      XCONTENT_TYPE: nosniff",
            "      XFRAME_OPTIONS: SAMEORIGIN",
            "    volumes:", "      - /var/lib/shai/stack/openwebui:/app/backend/data",
            "    tmpfs:", "      - /tmp:rw,noexec,nosuid,size=64m",
            "    profiles: [open-webui]",
        ]
    for service in sorted(selected):
        entry = catalog[service]
        recipe = entry.get('generic')
        if not recipe:
            continue
        block = {
            'image': entry['image'], 'container_name': f'shai-{service}', 'restart': 'unless-stopped',
            'security_opt': ['no-new-privileges:true'],
            'ports': [f"127.0.0.1:{entry['ports'][0]['port']}:{recipe['container_port']}"],
            'volumes': [f"{DATA / service / mount['folder']}:{mount['target']}" + (':ro' if mount['folder'] == 'media' else '') for mount in recipe['mounts']],
            'networks': ['shai-lan'] if recipe.get('outbound') else ['shai-automation'],
            'profiles': [service],
            'logging': {'driver': 'json-file', 'options': {'max-size': '10m', 'max-file': '3'}},
        }
        if service == 'esphome':
            block['command'] = ['dashboard', '/config', '--port', '6052']
        if service == 'zwavejs':
            block['devices'] = [f'{serial_device()}:/dev/ttyZWave']
        if service == 'navidrome':
            block['environment'] = {'ND_ENABLEINSIGHTSCOLLECTOR': 'false'}
        if service == 'pi-hole':
            block['environment'] = {'FTLCONF_webserver_api_password': '${PIHOLE_PASSWORD}', 'FTLCONF_dns_listeningMode': 'all'}
        if service == 'matter-server':
            block['environment'] = {'LISTEN_ADDRESS':'127.0.0.1','DCL_OFFLINE':'true'}
        if service == 'emoncms':
            block['environment'] = {'MYSQL_HOST':'emoncms-db','MYSQL_DATABASE':'emoncms','MYSQL_USER':'emoncms', 'MYSQL_PASSWORD':'${EMONCMS_PASSWORD}',
                                    'REDIS_ENABLED':'true','REDIS_HOST':'emoncms-redis','MQTT_ENABLED':'false','EMONCMS_DATADIR':'/var/opt/emoncms'}
            block['depends_on'] = {'emoncms-db': {'condition':'service_healthy'}, 'emoncms-redis': {'condition':'service_started'}}
            for component, image in entry.get('components', {}).items():
                extra = {'image':image, 'restart':'unless-stopped','networks':['shai-automation'], 'profiles':[service],
                         'volumes':[f'{DATA / service / component}:' + ('/var/lib/mysql' if component == 'db' else '/data')],
                         'logging':{'driver':'json-file','options':{'max-size':'10m','max-file':'3'}}}
                if component == 'db':
                    extra['environment'] = {'MYSQL_DATABASE':'emoncms','MYSQL_USER':'emoncms','MYSQL_PASSWORD':'${EMONCMS_PASSWORD}','MYSQL_ROOT_PASSWORD':'${EMONCMS_ROOT_PASSWORD}'}
                    extra['healthcheck'] = {'test':['CMD','healthcheck.sh','--connect','--innodb_initialized'],'interval':'5s','timeout':'5s','retries':30}
                lines.append(f'  emoncms-{component}:')
                for key, value in extra.items():
                    lines.append(f'    {key}: {json.dumps(value)}')
        lines.append(f'  {service}:')
        for key, value in block.items():
            lines.append(f'    {key}: {json.dumps(value)}')
    lines += [
        "networks:",
        "  shai-automation:",
        "    name: shai-automation",
        "    driver: bridge",
        "    internal: true",
        "  shai-lan:",
        "    name: shai-lan",
        "    driver: bridge",
        "  shai-observer:",
        "    name: shai-observer",
        "    driver: bridge",
        "    internal: true",
    ]
    return "\n".join(lines) + "\n"


def write_configuration(selected: set[str], catalog: dict[str, dict[str, object]]) -> list[str]:
    for path in (ETC, STACK, SECRETS, DATA):
        path.mkdir(parents=True, exist_ok=True)
    SECRETS.chmod(0o700); STACK.chmod(0o750)
    for service in SUPPORTED:
        (DATA / service.replace("-", "")).mkdir(parents=True, exist_ok=True)
    for service in selected:
        for mount in catalog[service].get('generic', {}).get('mounts', []):
            directory = DATA / service / mount['folder']
            if not directory.exists():
                directory.mkdir(parents=True, exist_ok=True)
                uid = catalog[service]['generic'].get('uid')
                if uid:
                    os.chown(directory, uid, uid)
    zigbee = serial_device() if "zigbee2mqtt" in selected else None
    observer = observer_image()
    pulled = [observer]
    run(["docker", "pull", observer])
    previous_locks = json.loads(LOCK.read_text()).get('images', {}) if LOCK.exists() else {}
    for item in sorted(selected):
        image = str(catalog[item]["image"])
        locked = previous_locks.get(image, [])
        if locked:
            catalog[item]['image'] = locked[0]
            run(['docker', 'image', 'inspect', locked[0]], capture=True)
        else:
            run(["docker", "pull", image])
            digest = json.loads(run(['docker', 'image', 'inspect', image, '--format', '{{json .RepoDigests}}'], capture=True))
            if not digest:
                raise SystemExit(f'Pulled image has no immutable digest: {image}')
            catalog[item]['image'] = digest[0]
        pulled.append(image)
        for component, child_image in catalog[item].get('components', {}).items():
            locked_child = previous_locks.get(child_image, [])
            if not locked_child:
                run(['docker','pull',child_image])
                locked_child = json.loads(run(['docker','image','inspect',child_image,'--format','{{json .RepoDigests}}'],capture=True))
            if not locked_child:
                raise SystemExit(f'Missing immutable image digest for {child_image}')
            catalog[item]['components'][component] = locked_child[0]
            pulled.append(child_image)
    if "mosquitto" in selected:
        username, password = ensure_mqtt_credentials(str(catalog["mosquitto"]["image"]))
        config = DATA / "mosquitto/config/mosquitto.conf"
        if not config.exists():
            config.write_text(
            "listener 1883 0.0.0.0\nallow_anonymous false\n"
            "password_file /mosquitto/config/passwd\npersistence true\n"
            "persistence_location /mosquitto/data/\nlog_dest file /mosquitto/log/mosquitto.log\n",
            encoding="utf-8",
        ); config.chmod(0o644)
        if "zigbee2mqtt" in selected:
            zconfig = DATA / "zigbee2mqtt/configuration.yaml"
            if not zconfig.exists():
                zconfig.write_text(
                "homeassistant: false\npermit_join: false\nfrontend:\n  enabled: true\n  port: 8080\n"
                f"mqtt:\n  server: mqtt://mosquitto:1883\n  user: {username}\n  password: {password}\n"
                "serial:\n  port: /dev/ttyZigbee\n",
                encoding="utf-8",
            ); zconfig.chmod(0o600)
    webui_env = ""
    if 'emoncms' in selected:
        for name in ['EMONCMS_PASSWORD','EMONCMS_ROOT_PASSWORD']:
            secret_path = SECRETS / name.lower()
            if not secret_path.exists():
                secret_path.write_text(secrets.token_urlsafe(32) + '\n'); secret_path.chmod(0o600)
            webui_env += name + '=' + secret_path.read_text().strip() + '\n'
    if 'pi-hole' in selected:
        secret_path = SECRETS / 'pihole-password'
        if not secret_path.exists():
            secret_path.write_text(secrets.token_urlsafe(32) + '\n')
            secret_path.chmod(0o600)
        webui_env += 'PIHOLE_PASSWORD=' + secret_path.read_text().strip() + '\n'
        print('Pi-hole setup password is stored in /etc/shai/secrets/pihole-password; not printed in logs.')
    if "open-webui" in selected:
        api_key, webui_secret = aia_credentials()
        control_token = control_credentials()
        webui_env += f"AIA_API_KEY={api_key}\nOPEN_WEBUI_SECRET={webui_secret}\nSHAI_CONTROL_TOKEN={control_token}\n"
    timezone = Path("/etc/timezone").read_text(encoding="utf-8").strip() if Path("/etc/timezone").exists() else "UTC"
    (STACK / ".env").write_text(f"TZ={timezone}\n{webui_env}", encoding="utf-8"); (STACK / ".env").chmod(0o600)
    if (STACK / 'compose.yaml').exists():
        shutil.copy2(STACK / 'compose.yaml', STACK / 'compose.previous.yaml')
    (STACK / "compose.yaml").write_text(
        compose_text(selected, catalog, zigbee, observer), encoding="utf-8"
    )
    (STACK / "compose.yaml").chmod(0o640)
    locks = {}
    for image in pulled:
        output = run(["docker", "image", "inspect", image, "--format", "{{json .RepoDigests}}"], capture=True)
        try: locks[image] = json.loads(output)
        except json.JSONDecodeError: locks[image] = []
    LOCK.write_text(json.dumps({"schema": 1, "images": locks}, indent=2) + "\n", encoding="utf-8"); LOCK.chmod(0o640)
    services = []
    for item in sorted(selected):
        entry = catalog[item]
        networks = (["host loopback"] if item == "open-webui" else
                    ["shai-automation", "shai-lan"] if item == "home-assistant" else ["shai-automation"])
        services.append({"id": item, "name": entry["name"], "container": f"shai-{item}",
                         "purpose": f"SHAI managed {entry['name']}", "ports": entry["ports"],
                         "networks": networks})
    REGISTRY.write_text(json.dumps({"schema": 1, "services": services}, indent=2) + "\n", encoding="utf-8")
    REGISTRY.chmod(0o644)
    return ["observer", *sorted(selected)]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--install", default="")
    parser.add_argument("--remove", default="")
    parser.add_argument("--assess", action="store_true", help="assess only; make no changes")
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit("run through SHAPP's visible sudo approval terminal")
    requested_install = {item for item in args.install.split(",") if item}
    requested_remove = {item for item in args.remove.split(",") if item}
    if not requested_install <= SUPPORTED or not requested_remove <= SUPPORTED:
        raise SystemExit("unsupported SHAI stack service ID")
    if requested_install & requested_remove:
        raise SystemExit("the same service cannot be installed and removed in one plan")
    current = installed()
    final = (current | requested_install) - requested_remove
    if 'mosquitto' in requested_remove and 'zigbee2mqtt' in final:
        raise SystemExit("Remove Zigbee2MQTT too before removing its MQTT dependency")
    if "zigbee2mqtt" in final:
        final.add("mosquitto")
    catalog = load_catalog()
    if final and requested_install:
        hardware_assessment(final, catalog)
    if args.assess:
        print("Assessment only. No Docker, package, service, or file changes were made.")
        return 0
    if not requested_install:
        removing = current & requested_remove
        if removing:
            if not (STACK / 'compose.yaml').is_file():
                raise SystemExit('Managed Compose configuration is missing; cannot safely remove services')
            command = ['docker', 'compose', '--project-directory', str(STACK)]
            if final:
                services = set(removing)
                for service in removing:
                    services.update(f'{service}-{component}' for component in catalog[service].get('components', {}))
                # Retain the last configuration and secrets until the next install rebuilds it.
                # Removing named containers needs no pulls, hardware, or retained-service restart.
                run([*command, '--profile', '*', 'rm', '--stop', '--force', *sorted(services)])
            else:
                run([*command, '--profile', '*', 'down'])
            if REGISTRY.exists():
                registry = json.loads(REGISTRY.read_text(encoding='utf-8'))
                registry['services'] = [entry for entry in registry.get('services', []) if entry['id'] in final]
                REGISTRY.write_text(json.dumps(registry, indent=2) + '\n', encoding='utf-8')
                REGISTRY.chmod(0o644)
    elif final:
        install_engine(); profiles = write_configuration(final, catalog)
        command = ["docker", "compose", "--project-directory", str(STACK)]
        for profile in profiles: command += ["--profile", profile]
        run([*command, 'config', '--quiet'])
        start_services = {service for service in requested_install & final if not catalog[service].get('generic', {}).get('download_only')}
        if 'zigbee2mqtt' in start_services:
            start_services.add('mosquitto')
        run([*command, "up", "-d", "--remove-orphans", 'engine-observer', *sorted(start_services)])
        for service in sorted(start_services):
            state = run(['docker', 'inspect', f'shai-{service}', '--format', '{{.State.Running}}'], capture=True)
            if state != 'true':
                raise SystemExit(f'{service} did not remain running; inspect its container logs')
    DATA.mkdir(parents=True, exist_ok=True)
    staged = [service for service in final if catalog[service].get('generic', {}).get('download_only')]
    STATE.write_text(json.dumps({"schema": 1, "services": sorted(final), 'staged_services': sorted(staged)}, indent=2) + "\n", encoding="utf-8")
    STATE.chmod(0o644)
    if requested_install:
        run(["systemctl", "enable", "--now", "shai-network-snapshot.timer"])
    print("SHAI Advanced stack applied. Persistent data was preserved.")
    if staged:
        print('Runtime images staged, NOT activated (network permission/configuration required): ' + ', '.join(staged))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
