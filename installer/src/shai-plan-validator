#!/usr/bin/env python3
"""Validate and normalize an unprivileged SHAI Setup Wave A plan."""

from __future__ import annotations

import json
import os
import pwd
import re
import stat
import sys
from pathlib import Path


ARCHITECTURES = {"managed-stack", "direct-host"}
THEMES = {"shai-brand-v2"}
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
PLAN_RE = re.compile(r"^[a-f0-9-]{16,64}$")


def fail(message: str) -> None:
    raise SystemExit(f"Invalid SHAI setup plan: {message}")


def main() -> int:
    if len(sys.argv) != 2:
        fail("usage: shai-plan-validator PLAN.json")

    source = Path(sys.argv[1])
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(source, flags)
    except OSError as exc:
        fail(f"cannot securely open plan: {exc}")
    file_stat = os.fstat(descriptor)
    if not stat.S_ISREG(file_stat.st_mode):
        os.close(descriptor)
        fail("plan must be a regular file")
    if file_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        os.close(descriptor)
        fail("plan must not be writable by group or other users")

    try:
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            data = json.load(stream)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"cannot read JSON: {exc}")

    expected = {
        "schema",
        "plan_id",
        "target_user",
        "confirmed_debloat",
        "architecture",
        "smart_home",
        "local_ai",
        "offline_mode",
        "theme",
    }
    if set(data) != expected:
        fail(f"expected exactly these fields: {', '.join(sorted(expected))}")

    user = data.get("target_user")
    if not isinstance(user, str) or not USER_RE.fullmatch(user):
        fail("target_user is not a valid local username")
    try:
        user_record = pwd.getpwnam(user)
    except KeyError:
        fail("target_user does not exist")
    if file_stat.st_uid != user_record.pw_uid:
        fail("plan owner does not match target_user")

    if data.get("schema") != 1:
        fail("unsupported schema")
    if not isinstance(data.get("plan_id"), str) or not PLAN_RE.fullmatch(data["plan_id"]):
        fail("plan_id is malformed")
    if data.get("confirmed_debloat") is not True:
        fail("debloat confirmation is required")
    if data.get("architecture") not in ARCHITECTURES:
        fail("unsupported architecture")
    if data.get("theme") not in THEMES:
        fail("unsupported theme")
    for field in ("smart_home", "local_ai", "offline_mode"):
        if type(data.get(field)) is not bool:
            fail(f"{field} must be true or false")

    normalized = {key: data[key] for key in sorted(expected)}
    json.dump(normalized, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
