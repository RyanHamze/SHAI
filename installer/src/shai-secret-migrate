#!/usr/bin/env python3
"""Move AIA integration secrets out of user JSON into SHAI's root-owned vault."""
from __future__ import annotations

import json
import os
import pwd
import secrets
import stat
import tempfile
from pathlib import Path

VAULT = Path("/etc/shai/secrets/aia")
SECRET_FIELDS = {"token", "password", "api_key", "secret"}

def write_json(path: Path, value: dict, mode: int) -> None:
    descriptor, filename = tempfile.mkstemp(prefix=".migration-", dir=path.parent)
    temp = Path(filename)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), mode)
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def migrate_account(account) -> int:
    """Anchor user writes to opened directories; never follow user-owned symlinks as root."""
    directories = []
    temporary = None
    migrated = 0
    try:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        directory = os.open(account.pw_dir, flags)
        directories.append(directory)
        for name in (".config", "shai"):
            directory = os.open(name, flags, dir_fd=directory)
            directories.append(directory)
        descriptor = os.open("aia.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            metadata = os.fstat(stream.fileno())
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != account.pw_uid or metadata.st_size > 1024 * 1024:
                return 0
            config = json.load(stream)
        if not isinstance(config, dict) or not isinstance(config.get("integrations"), dict):
            return 0
        for name, values in config["integrations"].items():
            if not name.replace("-", "").isalnum() or not isinstance(values, dict):
                continue
            private = {key: value for key, value in values.items() if key in SECRET_FIELDS and str(value).strip()}
            if not private:
                continue
            target_dir = VAULT / account.pw_name
            target_dir.mkdir(exist_ok=True, mode=0o700); target_dir.chmod(0o700)
            target = target_dir / f"{name}.json"
            existing = json.loads(target.read_text(encoding="utf-8")) if target.exists() else {"values": {}}
            if not isinstance(existing, dict) or not isinstance(existing.get("values"), dict):
                continue
            write_json(target, {"schema": 1, "owner": account.pw_name, "integration": name,
                                "values": {**existing["values"], **private}}, 0o600)
            for key in private:
                del values[key]
            values["secret_ref"] = f"vault://aia/{account.pw_name}/{name}"
            migrated += 1
        if migrated:
            temporary = ".aia-migration-" + secrets.token_hex(16)
            descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                os.fchown(stream.fileno(), account.pw_uid, account.pw_gid)
                json.dump(config, stream, indent=2, sort_keys=True)
                stream.write("\n")
            os.replace(temporary, "aia.json", src_dir_fd=directory, dst_dir_fd=directory)
            temporary = None
    except (OSError, UnicodeError, ValueError):
        # Keep legacy secrets in place when the account/config cannot be safely migrated.
        return 0
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=directories[-1])
            except FileNotFoundError:
                pass
        for directory in reversed(directories):
            os.close(directory)
    return migrated

def main() -> None:
    if os.geteuid() != 0: raise SystemExit("run as root")
    VAULT.mkdir(parents=True, exist_ok=True); VAULT.chmod(0o700)
    migrated = 0
    for account in pwd.getpwall():
        if account.pw_uid < 1000 or not account.pw_dir.startswith("/home/"): continue
        if not account.pw_name.replace("-", "").replace("_", "").isalnum(): continue
        migrated += migrate_account(account)
    print(f"Migrated {migrated} integration secret record(s) to the root-owned SHAI vault.")

if __name__ == "__main__": main()
