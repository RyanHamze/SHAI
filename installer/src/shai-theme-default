#!/usr/bin/env bash
set -Eeuo pipefail

readonly THEME_ROOT="${SHAI_THEME_ROOT:-/usr/share}"
readonly GTK_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
readonly GTK_SOURCE="$THEME_ROOT/themes/SHAI/gtk-4.0/gtk.css"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shai-theme"
readonly STATUS="$STATE_DIR/status.json"
readonly USER_THEME_ID="user-theme@gnome-shell-extensions.gcampax.github.com"

if [[ ${EUID} -eq 0 ]]; then
    printf 'Run shai-theme-default as the desktop user, not with sudo.\n' >&2
    exit 1
fi

for setting in \
    'org.gnome.desktop.interface color-scheme' \
    'org.gnome.desktop.interface accent-color' \
    'org.gnome.desktop.interface icon-theme' \
    'org.gnome.desktop.background picture-uri' \
    'org.gnome.desktop.background picture-uri-dark' \
    'org.gnome.desktop.background picture-options'; do
    read -r schema key <<<"$setting"
    gsettings reset "$schema" "$key"
done

if gsettings list-schemas | grep -qx org.gnome.shell.extensions.user-theme; then
    gsettings reset org.gnome.shell.extensions.user-theme name
fi

enabled_extensions="$(python3 - "$USER_THEME_ID" <<'PY'
import ast
import subprocess
import sys

raw = subprocess.check_output(
    ["gsettings", "get", "org.gnome.shell", "enabled-extensions"], text=True
).strip()
if raw.startswith("@as "):
    raw = raw[4:]
items = [item for item in ast.literal_eval(raw) if item != sys.argv[1]]
print(repr(items))
PY
)"
gsettings set org.gnome.shell enabled-extensions "$enabled_extensions"

if [[ -f "$GTK_FILE" && -f "$GTK_SOURCE" ]] \
    && cmp -s -- "$GTK_FILE" "$GTK_SOURCE"; then
    rm -f -- "$GTK_FILE"
fi

install -d -m 0700 "$STATE_DIR"
python3 - "$STATUS" <<'PY'
import datetime
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
payload = {
    "schema": 1,
    "applied_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "theme": "Ubuntu default",
    "gtk": "default",
    "icons": "default",
    "shell": "default-pending-login",
    "wallpaper": "default",
}
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
temporary.chmod(0o600)
temporary.replace(path)
PY

printf 'Ubuntu desktop appearance defaults restored. Log out and back in to refresh GNOME Shell.\n'
