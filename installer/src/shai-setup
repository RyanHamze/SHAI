    def show_step(self, index: int) -> None:
        self.index = max(0, min(index, len(self.STEPS) - 1))
        self.stack.set_visible_child_name(
            ("debloat", "architecture", "purpose", "review", "apply", "complete")[self.index]
        )
        for position, item in enumerate(self.step_labels):
            item.remove_css_class("step-active")
            item.remove_css_class("step")
            item.add_css_class("step-active" if position == self.index else "step")
        if self.index == 3:
            self.refresh_review()
        self.update_navigation()

    def update_navigation(self) -> None:
        self.back.set_sensitive(0 < self.index < 4)
        self.next.set_visible(self.index < 4)
        self.next.set_sensitive(self.index != 0 or self.debloat_confirm.get_active())
        self.cancel.set_label("No, exit setup" if self.index == 0 else "Exit setup")
        if self.index == 0:
            self.next.set_label("Yes, continue")
        elif self.index == 2:
            self.next.set_label("Review and apply")
        else:
            self.next.set_label("Continue")

    def go_back(self, _button: Gtk.Button) -> None:
        self.show_step(self.index - 1)

    def go_next(self, _button: Gtk.Button) -> None:
        if self.index == 0 and not self.debloat_confirm.get_active():
            return
        self.show_step(self.index + 1)

