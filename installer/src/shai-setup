    def open_readme(self, _button: Gtk.Button) -> None:
        if README.exists():
            Gio.AppInfo.launch_default_for_uri(README.as_uri(), None)
        else:
            self.show_message("README unavailable", str(README))

    def plan(self) -> dict[str, object]:
        return {
            "schema": 1,
            "plan_id": str(uuid.uuid4()),
            "target_user": os.environ.get("USER", ""),
            "confirmed_debloat": bool(self.debloat_confirm.get_active()),
            "architecture": self.architecture(),
            "smart_home": bool(self.smart_home.get_active()),
            "local_ai": bool(self.local_ai.get_active()),
            "offline_mode": bool(self.offline_mode.get_active()),
            "theme": "shai-brand-v2",
        }

    def terminal_command(self, plan_path: Path) -> list[str] | None:
        command = (
            f"sudo /usr/bin/shai-installer --apply-plan {shlex.quote(str(plan_path))}; "
            "rc=$?; echo; "
            "if [ $rc -eq 0 ]; then echo 'SHAI Setup completed successfully.'; "
            "else echo \"SHAI Setup stopped with exit code $rc.\"; fi; "
            "echo 'This window will close in 5 seconds.'; sleep 5; exit $rc"
        )
        if shutil.which("ptyxis"):
            return ["ptyxis", "--standalone", "--title", "SHAI Setup - Apply Changes", "--", "bash", "-lc", command]
        if shutil.which("gnome-terminal"):
            return ["gnome-terminal", "--wait", "--title=SHAI Setup - Apply Changes", "--", "bash", "-lc", command]
        terminal = shutil.which("x-terminal-emulator")
        if terminal:
            return [terminal, "-e", "bash", "-lc", command]
        return None

    def start_apply(self, _button: Gtk.Button) -> None:
        plan = self.plan()
        self.plan_id = str(plan["plan_id"])
        cache = Path.home() / ".cache" / "shai"
        cache.mkdir(parents=True, exist_ok=True, mode=0o700)
        plan_path = cache / f"wave-a-{self.plan_id}.json"
        plan_path.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        plan_path.chmod(0o600)
        command = self.terminal_command(plan_path)
        if command is None:
            self.show_message(
                "Terminal unavailable",
                "SHAI could not find Ptyxis, GNOME Terminal, or x-terminal-emulator.",
            )
            return
        self.apply_button.set_sensitive(False)
        self.apply_status.set_text(
            "The terminal is open. Enter your sudo password there, then leave it open while SHAI applies and verifies your requested changes."
        )
        subprocess.Popen(command, start_new_session=True)
        self.poll_count = 0
        GLib.timeout_add_seconds(1, self.poll_result)

    def poll_result(self) -> bool:
        self.poll_count += 1
        try:
            result = json.loads(RESULT.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            result = {}
        if result.get("plan_id") == self.plan_id:
            if result.get("status") == "success":
                self.apply_status.set_text("SHAI Setup passed all final health checks.")
                try:
                    summary = SUMMARY.read_text(encoding="utf-8")
                except OSError:
                    summary = "System summary was not available. Review the installer log."
                self.complete_summary.get_buffer().set_text(summary)
                self.show_step(5)
                GLib.timeout_add(800, self.open_default_shells)
            else:
                self.apply_status.set_text(
                    f"SHAI Setup stopped safely: {result.get('message', 'Review the terminal and installer log.')}"
                )
                self.apply_button.set_sensitive(True)
            return False
        if self.poll_count >= 3600:
            self.apply_status.set_text("No completion record was received. Review the visible terminal and logs.")
            self.apply_button.set_sensitive(True)
            return False
        return True

    def open_default_shells(self) -> bool:
        if self.shells_opened:
            return False
        self.shells_opened = True
        self.home_process = self.launch_shell("home")
        return False

    @staticmethod
    def launch_shell(mode: str) -> subprocess.Popen | None:
        executable = shutil.which("shai-wave-a-shell")
        if executable:
            return subprocess.Popen([executable, mode], start_new_session=True)
        return None

    def close_home_open_shapp(self, _button: Gtk.Button) -> None:
        if self.home_process and self.home_process.poll() is None:
            self.home_process.terminate()
        self.launch_shell("shapp")
        self.close()

    def show_message(self, title: str, body: str) -> None:
        dialog = Gtk.AlertDialog(message=title, detail=body)
        dialog.show(self)


class SetupApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def do_activate(self) -> None:
        if os.geteuid() == 0:
            raise SystemExit("Run shai-setup as your normal desktop user, without sudo.")
        window = self.props.active_window or SetupWindow(self)
        window.present()


def main() -> int:
    return SetupApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
