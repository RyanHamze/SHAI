#!/usr/bin/env python3
"""Write a sanitized, read-only host and container socket snapshot for SHEALTH."""

from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import time
import urllib.parse
import urllib.request
from pathlib import Path


OUTPUT = Path("/run/shai/network-snapshot.json")
REGISTRY = Path("/etc/shai/service-registry.json")
PROCESS_RE = re.compile(r'users:\(\(\"([^\"]+)\",pid=(\d+)')
MAX_API_RESPONSE = 8 * 1024 * 1024


def run(args: list[str], timeout: int = 8) -> tuple[int, str]:
    try:
        result = subprocess.run(
            args, check=False, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=timeout,
        )
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""


def registry() -> tuple[dict[tuple[str, int], dict[str, object]], list[dict[str, object]]]:
    try:
        data = json.loads(REGISTRY.read_text(encoding="utf-8"))
        services = data.get("services", [])
    except (OSError, json.JSONDecodeError, AttributeError):
        services = []
    ports = {}
    for service in services:
        for port in service.get("ports", []):
            try:
                ports[(str(port.get("protocol", "tcp")), int(port["port"]))] = service
            except (KeyError, TypeError, ValueError):
                pass
    return ports, services


def endpoint_port(endpoint: str) -> int | None:
    try:
        raw = endpoint.rsplit(":", 1)[1].strip("[]")
        return int(raw) if raw not in {"*", ""} else None
    except (IndexError, ValueError):
        return None


def purpose(protocol: str, port: int | None, ports: dict) -> tuple[str, str]:
    if port is None:
        return "unknown", "No numeric port"
    item = ports.get((protocol, port))
    if item:
        return str(item.get("name", "registered service")), str(item.get("purpose", "SHAI registered service"))
    try:
        return socket.getservbyport(port, protocol), "Standard service-name hint; not proof of payload"
    except OSError:
        return "unregistered", "No registered purpose; inspect the owning process"


def parse_ss(
    output: str,
    context: str,
    ports: dict,
) -> list[dict[str, object]]:
    rows = []
    for raw in output.splitlines():
        fields = raw.split()
        if len(fields) < 6:
            continue
        protocol, state, local, peer = fields[0], fields[1], fields[4], fields[5]
        if protocol not in {"tcp", "udp"}:
            continue
        process_match = PROCESS_RE.search(raw)
        owner = process_match.group(1) if process_match else "ownership unavailable"
        pid = int(process_match.group(2)) if process_match else None
        local_port, peer_port = endpoint_port(local), endpoint_port(peer)
        relevant_port = local_port if state.upper() in {"LISTEN", "UNCONN"} else peer_port
        service, description = purpose(protocol, relevant_port, ports)
        rows.append({
            "context": context,
            "protocol": protocol,
            "state": state,
            "source": local,
            "destination": peer,
            "source_port": local_port,
            "destination_port": peer_port,
            "owner": owner,
            "pid": pid,
            "service": service,
            "purpose": description,
            "raw": raw,
        })
    return rows


def api_read(base: str, path: str, timeout: int = 6) -> bytes:
    request = urllib.request.Request(base + path, headers={"Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = response.read(MAX_API_RESPONSE + 1)
    if len(payload) > MAX_API_RESPONSE:
        raise ValueError("observer response exceeded the local safety limit")
    return payload


def api_get(base: str, path: str, timeout: int = 6) -> object:
    return json.loads(api_read(base, path, timeout))


def observer_endpoint() -> str:
    rc, output = run([
        "docker", "inspect", "shai-engine-observer", "--format",
        "{{json .NetworkSettings.Networks}}",
    ])
    if rc or not output:
        raise RuntimeError("SHAI Engine Observer is not running")
    try:
        networks = json.loads(output)
        selected = networks.get("shai-observer", {})
        address = str(selected.get("IPAddress", ""))
    except (json.JSONDecodeError, AttributeError):
        address = ""
    if not address:
        raise RuntimeError("SHAI Engine Observer has no private observer-network address")
    return f"http://{address}:2375"


def cpu_percent(stats: dict[str, object]) -> float:
    current = stats.get("cpu_stats", {})
    previous = stats.get("precpu_stats", {})
    try:
        cpu_delta = int(current["cpu_usage"]["total_usage"]) - int(previous["cpu_usage"]["total_usage"])
        system_delta = int(current["system_cpu_usage"]) - int(previous["system_cpu_usage"])
        cpus = int(current.get("online_cpus") or len(current["cpu_usage"].get("percpu_usage", [])) or 1)
        return max(0.0, cpu_delta / system_delta * cpus * 100) if system_delta > 0 else 0.0
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return 0.0


def containers() -> tuple[list[dict[str, object]], list[dict[str, object]], dict[str, object]]:
    try:
        base = observer_endpoint()
        summaries = api_get(base, "/containers/json?all=1")
        if not isinstance(summaries, list):
            raise ValueError("observer returned an invalid container list")
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        return [], [], {"available": False, "error": str(exc)}
    result = []
    for summary in summaries:
        container_id = str(summary.get("Id", ""))
        if not container_id:
            continue
        encoded = urllib.parse.quote(container_id, safe="")
        try:
            item = api_get(base, f"/containers/{encoded}/json")
        except (OSError, ValueError, json.JSONDecodeError):
            continue
        try:
            stats = api_get(base, f"/containers/{encoded}/stats?stream=false", 8)
        except (OSError, ValueError, json.JSONDecodeError):
            stats = {}
        state = item.get("State", {})
        networks = item.get("NetworkSettings", {}).get("Networks", {})
        memory = stats.get("memory_stats", {}) if isinstance(stats, dict) else {}
        ports = item.get("NetworkSettings", {}).get("Ports", {})
        result.append({
            "id": str(item.get("Id", ""))[:12],
            "name": str(item.get("Name", "")).lstrip("/"),
            "image": str(item.get("Config", {}).get("Image", "")),
            "pid": int(state.get("Pid", 0) or 0),
            "pids": int(stats.get("pids_stats", {}).get("current", 0) or 0),
            "status": str(state.get("Status", "unknown")),
            "health": str(state.get("Health", {}).get("Status", "not configured")),
            "cpu_percent": round(cpu_percent(stats), 2),
            "memory_usage": int(memory.get("usage", 0) or 0),
            "memory_limit": int(memory.get("limit", 0) or 0),
            "ports": ports,
            "networks": {
                name: {"ip": value.get("IPAddress", ""), "gateway": value.get("Gateway", "")}
                for name, value in networks.items()
            },
        })
    now = int(time.time())
    events = []
    try:
        event_data = api_read(base, f"/events?since={now - 35}&until={now}")
        events = [json.loads(line) for line in event_data.splitlines() if line.strip()][-100:]
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    return result, events, {
        "available": True,
        "name": "SHAI Engine Observer",
        "policy": "GET/HEAD containers, events, info, ping, and version only",
        "network": "shai-observer (private; no published port)",
        "source": "https://github.com/RyanHamze/docker-socket-proxy",
        "upstream": "https://github.com/Tecnativa/docker-socket-proxy",
        "license": "Apache-2.0",
    }


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit("shai-network-snapshot must run as the system service")
    ports, services = registry()
    rc, host_output = run(["ss", "-H", "-tunap"])
    connections = parse_ss(host_output if rc == 0 else "", "host", ports)
    container_rows, events, observer = containers()
    for container in container_rows:
        pid = int(container["pid"])
        if pid <= 0:
            continue
        rc, output = run(["nsenter", "-t", str(pid), "-n", "ss", "-H", "-tunap"])
        if rc == 0:
            connections.extend(parse_ss(output, f"container:{container['name']}", ports))
    payload = {
        "schema": 1,
        "generated_at": int(time.time()),
        "services": services,
        "containers": container_rows,
        "container_events": events,
        "observer": observer,
        "connections": connections,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    temporary = OUTPUT.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.chmod(0o644)
    temporary.replace(OUTPUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
