#!/usr/bin/env python3
"""Store one AIA integration secret supplied on standard input as root."""
from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path

SECRET_FIELDS = {"token", "password", "api_key", "secret"}
VAULT = Path("/etc/shai/secrets/aia")

def main() -> None:
    if os.geteuid() != 0 or len(sys.argv) != 3:
        raise SystemExit("usage: shai-secret-store USER INTEGRATION (run as root)")
    user, integration = sys.argv[1:]
    if not user.replace("-", "").replace("_", "").isalnum() or not integration.replace("-", "").isalnum():
        raise SystemExit("invalid vault target")
    value = json.load(sys.stdin)
    if not isinstance(value, dict): raise SystemExit("secret payload must be an object")
    private = {key: str(item) for key, item in value.items() if key.isidentifier() and not key.startswith('_') and len(key) <= 64 and str(item).strip() and len(str(item)) <= 16384}
    if not private: raise SystemExit("no secret fields supplied")
    VAULT.mkdir(parents=True, exist_ok=True, mode=0o700); VAULT.chmod(0o700)
    destination = VAULT / user; destination.mkdir(exist_ok=True, mode=0o700); destination.chmod(0o700)
    target = destination / f"{integration}.json"
    if target.exists():
        previous = json.loads(target.read_text(encoding="utf-8"))
        if not isinstance(previous, dict) or not isinstance(previous.get("values"), dict):
            raise SystemExit("existing vault record is invalid; refusing to overwrite it")
        private = {**previous["values"], **private}
    descriptor, filename = tempfile.mkstemp(prefix=f".{integration}-", dir=destination)
    temporary = Path(filename)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump({"schema": 1, "owner": user, "integration": integration, "values": private}, stream, indent=2, sort_keys=True)
            stream.write("\n")
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)
    print(f"Stored {len(private)} secret field(s) in the SHAI vault.")

if __name__ == "__main__": main()
