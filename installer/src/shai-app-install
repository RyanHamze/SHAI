#!/usr/bin/env python3
"""Allowlisted host app lifecycle, called only from SHAPP's approved terminal."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import pwd
import shutil
import socket
import subprocess
import sys
import urllib.request

STATE = Path('/var/lib/shai/apps')
VOICE = {'piper': 'piper', 'whisper': 'whisper', 'openwakeword': 'openwakeword', 'wyoming': 'wyoming'}
SUPPORTED = {*VOICE, 'esphome', 'sniffnet', 'zeek', 'ntopng', 'veracrypt'}

def run(args, **kwargs):
    print('+', ' '.join(args), flush=True)
    return subprocess.run(args, check=True, **kwargs)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('action', choices=['install', 'remove'])
    parser.add_argument('app', choices=sorted(SUPPORTED))
    parser.add_argument('--user', required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit('Run through the approved SHAPP terminal')
    user = pwd.getpwnam(args.user)
    if user.pw_uid < 1000:
        raise SystemExit('A regular desktop user is required')
    home = Path(user.pw_dir)
    receipt = STATE / args.user / (args.app + '.json')
    if args.action == 'remove' and not receipt.is_file():
        raise SystemExit('Not SHAPP-managed; refusing external removal')
    root = home / '.local/share/shai/apps' / args.app
    as_user = ['runuser', '-u', args.user, '--', 'env', f'HOME={home}']
    if args.app in {'zeek', 'ntopng', 'veracrypt'}:
        if args.action == 'remove' and not receipt.is_file():
            raise SystemExit('Not SHAPP-managed; use Ubuntu to remove external installations')
        run(['python3', '/usr/lib/shai-installer/shai-source-install', args.action, args.app])
    elif args.app in VOICE:
        voice_receipt = home / '.local/share/shai/voice' / VOICE[args.app] / 'installed.json'
        if args.action == 'install' and voice_receipt.is_file():
            print('Existing AIA-managed runtime detected; reusing it without a duplicate download.')
        else:
            if args.action == 'install':
                run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', 'install', '-y', 'python3-venv'])
            run([*as_user, 'SHAI_VENV_READY=1', 'python3', '/usr/lib/shai-installer/shai-voice-manage', args.action, VOICE[args.app]])
    elif args.app == 'esphome':
        if args.action == 'install':
            run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', 'install', '-y', 'python3-venv'])
            run([*as_user, 'mkdir', '-p', str(root)])
            run([*as_user, 'python3', '-m', 'venv', str(root / 'venv')])
            ipv4 = "import socket,runpy; f=socket.getaddrinfo; socket.getaddrinfo=lambda h,p,family=0,*a,**k:f(h,p,socket.AF_INET,*a,**k); runpy.run_module('pip',run_name='__main__')"
            run([*as_user, str(root / 'venv/bin/python'), '-c', ipv4, 'install', '--index-url', 'https://pypi.org/simple', '--report', str(root / 'install-report.json'), 'esphome'])
            run([*as_user, str(root / 'venv/bin/esphome'), 'version'])
            print('ESPHome runtime installed. Dashboard and firmware builds require separate configuration; no network service started.')
        else:
            if not receipt.is_file():
                raise SystemExit('Not SHAPP-managed; refusing external removal')
            run([*as_user, 'python3', '-c', 'import shutil,sys; shutil.rmtree(sys.argv[1])', str(root / 'venv')])
    elif args.app == 'sniffnet':
        if args.action == 'remove':
            if not receipt.is_file():
                raise SystemExit('Not SHAPP-managed; use Ubuntu to remove external packages')
            simulation = subprocess.check_output(['apt-get', '-s', 'remove', 'sniffnet'], text=True)
            if any(line.startswith('Remv ') and line.split()[1] != 'sniffnet' for line in simulation.splitlines()):
                raise SystemExit('Removal would affect other packages')
            run(['apt-get', 'remove', '-y', 'sniffnet'])
        else:
            run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', 'install', '-y', 'wget', 'ca-certificates'])
            cache = Path('/var/cache/shai/sniffnet')
            cache.mkdir(parents=True, exist_ok=True, mode=0o700)
            architecture = subprocess.check_output(['dpkg', '--print-architecture'], text=True).strip()
            original = socket.getaddrinfo
            socket.getaddrinfo = lambda h,p,family=0,*a,**k: original(h,p,socket.AF_INET,*a,**k)
            request = urllib.request.Request('https://api.github.com/repos/GyulyVGC/sniffnet/releases/latest', headers={'User-Agent': 'SHAI-installer'})
            with urllib.request.urlopen(request, timeout=30) as response:
                release = json.load(response)
            asset = next((a for a in release['assets'] if a['name'] == f'Sniffnet_LinuxDEB_{architecture}.deb'), None)
            if not asset or not str(asset.get('digest', '')).startswith('sha256:'):
                raise SystemExit('Official architecture-specific asset with a SHA-256 digest is unavailable')
            url = asset['browser_download_url']
            if not url.startswith('https://github.com/GyulyVGC/sniffnet/releases/download/'):
                raise SystemExit('Unexpected release download origin')
            destination = cache / 'sniffnet.deb'
            run(['wget', '-4', '--https-only', '-O', str(destination), url])
            digest = hashlib.sha256(destination.read_bytes()).hexdigest()
            if digest != asset['digest'][7:]:
                raise SystemExit('Official release checksum mismatch')
            package = subprocess.check_output(['dpkg-deb', '-f', str(destination), 'Package'], text=True).strip()
            if package != 'sniffnet':
                raise SystemExit('Unexpected package name')
            run(['apt-get', '-o', 'Acquire::ForceIPv4=true', '--no-remove', 'install', '-y', str(destination)])
            (cache / 'release.json').write_text(json.dumps({'url': url, 'sha256': digest}, indent=2))
            print('Sniffnet installed. Packet-capture permissions are not silently granted.')
    receipt.parent.mkdir(parents=True, exist_ok=True)
    if args.action == 'install':
        receipt.write_text(json.dumps({'app': args.app, 'user': args.user, 'state': 'runtime-installed'}, indent=2) + '\n')
        receipt.chmod(0o644)
    else:
        receipt.unlink(missing_ok=True)

if __name__ == '__main__':
    main()
