#!/usr/bin/env python3
"""Launch the configured AIA model as a persistent, local-only service."""

from __future__ import annotations

import json
import os
import shutil
import secrets
import sys
from pathlib import Path


CONFIG_FILE = Path.home() / ".config/shai/aia.json"
MODEL_DIR = Path.home() / ".local/share/shai/models"
KEY_FILE = Path.home() / ".local/state/shai/aia/server-api-key"
CATALOG = {
    "smollm2-135m-q4": "SmolLM2-135M-Instruct.Q4_K_M.gguf",
    "smollm2-360m-q4": "SmolLM2-360M-Instruct-Q4_K_M.gguf",
    "qwen25-05b-q4": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
    "llama32-1b-q4": "Llama-3.2-1B-Instruct-Q4_K_M.gguf",
}


def fail(message: str) -> None:
    print(f"shai-aia-server: {message}", file=sys.stderr)
    raise SystemExit(78)


def prepare_key() -> None:
    """Explicit, unprivileged install step; never print or rotate an existing key."""
    KEY_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    KEY_FILE.parent.chmod(0o700)
    try:
        descriptor = os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    except FileExistsError:
        if KEY_FILE.is_symlink() or not KEY_FILE.is_file():
            fail('private API key path is not a regular file')
        if not KEY_FILE.read_text(encoding='utf-8').strip():
            fail('existing private API key is empty; repair it before starting inference')
        KEY_FILE.chmod(0o600)
    else:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
            stream.write(secrets.token_urlsafe(32) + '\n')


def load_config() -> dict[str, object]:
    try:
        value = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read {CONFIG_FILE}: {exc}")
    if not isinstance(value, dict):
        fail(f"invalid configuration in {CONFIG_FILE}")
    return value


def active_model(config: dict[str, object]) -> Path:
    active_id = str(config.get("active_model", ""))
    if active_id in CATALOG:
        return MODEL_DIR / CATALOG[active_id]
    imported = config.get("imported_models", [])
    if isinstance(imported, list):
        for item in imported:
            if isinstance(item, dict) and str(item.get("id", "")) == active_id:
                return Path(str(item.get("path", ""))).expanduser()
    fail("no active model is configured")


def main() -> None:
    runtime = shutil.which("llama-server")
    if not runtime:
        fail("llama-server is not installed")
    model = active_model(load_config())
    if not model.is_file():
        fail(f"active model does not exist: {model}")
    if KEY_FILE.is_symlink() or not KEY_FILE.is_file():
        fail(f"private API key does not exist: {KEY_FILE}")
    key_mode = KEY_FILE.stat().st_mode & 0o777
    if key_mode & 0o077:
        fail(f"private API key permissions are too broad: {oct(key_mode)}")
    if not KEY_FILE.read_text(encoding='utf-8').strip():
        fail('private API key is empty')

    threads = max(1, min(4, (os.cpu_count() or 1) // 5))
    arguments = [
        runtime,
        "--model", str(model),
        "--alias", "local",
        "--host", "127.0.0.1",
        "--port", "11435",
        "--ctx-size", "2048",
        "--threads", str(threads),
        "--parallel", "1",
        "--no-webui",
        "--api-key-file", str(KEY_FILE),
    ]
    os.execv(runtime, arguments)


if __name__ == "__main__":
    if sys.argv[1:] == ['--prepare-key']:
        if os.geteuid() == 0:
            fail('prepare the key as the desktop user, without sudo')
        prepare_key()
    elif sys.argv[1:]:
        fail('unknown arguments')
    else:
        main()
