#!/usr/bin/env python3
"""Collect a stable, local-only post-setup system summary."""

from __future__ import annotations

import grp
import json
import os
import platform
import pwd
import shutil
import subprocess
import sys
from pathlib import Path


def command(*args: str) -> str:
    result = subprocess.run(
        args,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value.strip('"')
    except OSError:
        pass
    return values


def first_readable(paths: tuple[str, ...]) -> str:
    for name in paths:
        try:
            value = Path(name).read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if value:
            return value
    return "Unavailable"


def memory_total() -> str:
    try:
        line = next(
            item
            for item in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines()
            if item.startswith("MemTotal:")
        )
        gib = int(line.split()[1]) / 1024 / 1024
        return f"{gib:.1f} GiB"
    except (OSError, StopIteration, ValueError):
        return "Unavailable"


def disk_capacity() -> str:
    total = shutil.disk_usage("/").total
    return f"{total / (1024 ** 3):.1f} GiB root filesystem"


def processor() -> str:
    value = command("lscpu", "-J")
    if value:
        try:
            rows = json.loads(value).get("lscpu", [])
            fields = {row["field"].rstrip(":"): row["data"] for row in rows}
            return fields.get("Model name", fields.get("Architecture", "Unavailable"))
        except (json.JSONDecodeError, KeyError, TypeError):
            pass
    return platform.processor() or "Unavailable"


def users() -> list[dict[str, str]]:
    sudo_members = set()
    try:
        sudo_members.update(grp.getgrnam("sudo").gr_mem)
    except KeyError:
        pass
    result = []
    for entry in pwd.getpwall():
        if not 1000 <= entry.pw_uid < 65534:
            continue
        if entry.pw_shell.endswith(("nologin", "false")):
            continue
        groups = {
            group.gr_name
            for group in grp.getgrall()
            if entry.pw_name in group.gr_mem or group.gr_gid == entry.pw_gid
        }
        role = "Admin" if entry.pw_name in sudo_members or "sudo" in groups else "User"
        result.append({"name": entry.pw_name, "role": role})
    return sorted(result, key=lambda item: item["name"].lower())


def windowing_system(target_user: str) -> str:
    sessions = command("loginctl", "list-sessions", "--no-legend", "--no-pager")
    for line in sessions.splitlines():
        columns = line.split()
        if len(columns) >= 3 and columns[2] == target_user:
            value = command("loginctl", "show-session", columns[0], "-p", "Type", "--value")
            if value:
                return value.capitalize()
    return os.environ.get("XDG_SESSION_TYPE", "Unavailable").capitalize()


def main() -> int:
    if os.geteuid() != 0:
        raise SystemExit("Run shai-system-summary through SHAI Setup as root.")
    if len(sys.argv) != 3:
        raise SystemExit("Usage: shai-system-summary TARGET_USER OUTPUT_DIRECTORY")
    target_user, output_name = sys.argv[1:]
    output = Path(output_name)
    output.mkdir(parents=True, exist_ok=True)
    release = os_release()
    account_rows = users()
    ntp = command("timedatectl", "show", "-p", "NTP", "--value").lower()
    payload = {
        "schema": 1,
        "device_name": command("hostnamectl", "hostname") or platform.node(),
        "hardware_model": first_readable((
            "/sys/class/dmi/id/product_name",
            "/sys/firmware/devicetree/base/model",
        )),
        "processor": processor(),
        "memory": memory_total(),
        "disk_capacity": disk_capacity(),
        "os": release.get("PRETTY_NAME", "Ubuntu"),
        "os_type": f"{platform.architecture()[0]} ({platform.machine()})",
        "gnome_version": command("gnome-shell", "--version") or "Unavailable",
        "windowing_system": windowing_system(target_user),
        "kernel": platform.release(),
        "users": account_rows,
        "automatic_date_time": "Off" if ntp != "yes" else "On",
        "location_services": "Off",
        "media_sharing": "Off",
        "online_account_providers": "Off",
        "wellbeing_tracking": "Off",
    }
    text = [
        "SHAI SETUP SUMMARY",
        "==================",
        "",
        f"Device name: {payload['device_name']}",
        f"Hardware model: {payload['hardware_model']}",
        f"Processor: {payload['processor']}",
        f"Memory: {payload['memory']}",
        f"Disk capacity: {payload['disk_capacity']}",
        f"Operating system: {payload['os']}",
        f"OS type: {payload['os_type']}",
        f"GNOME version: {payload['gnome_version']}",
        f"Windowing system: {payload['windowing_system']}",
        f"Kernel: {payload['kernel']}",
        "",
        "Users with local profiles:",
    ]
    text.extend(
        f"  {item['name']}: {item['role']}" for item in account_rows
    )
    if not account_rows:
        text.append("  None detected")
    text.extend([
        "",
        "Privacy and appliance defaults:",
        f"  Automatic date and time: {payload['automatic_date_time']}",
        "  Location services and existing app location grants: Off",
        "  Media sharing: Off",
        "  Online account providers: Off",
        "  Events and Tasks notifications: Off",
        "  Wellbeing recording and reminders: Off",
        "",
        "Ubuntu remains the operating system and owner of OS updates, security patches,",
        "drivers, firmware, package management, and the terminal.",
    ])
    (output / "system-summary.json").write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    (output / "system-summary.txt").write_text("\n".join(text) + "\n", encoding="utf-8")
    os.chmod(output / "system-summary.json", 0o644)
    os.chmod(output / "system-summary.txt", 0o644)
    print("\n".join(text))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
