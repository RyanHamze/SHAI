        box.append(row)
        state, detail = self.service_status()
        box.append(label(f"Inference: {detail}", "good" if state == "ready" else "warning"))
        try:
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            with opener.open(BROKER_URL + "/health", timeout=2) as response:
                health = json.loads(response.read())
            with opener.open(BROKER_URL + "/proposals", timeout=2) as response:
