    def add_custom_integration(self, *_args: object) -> None:
        dialog = Gtk.Dialog(title="Add custom integration", transient_for=self, modal=True)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Add", Gtk.ResponseType.OK)
        content = dialog.get_content_area()
        content.set_spacing(8)
        name = Gtk.Entry(placeholder_text="Application name")
        content.append(name)
        fields = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        content.append(fields)
        rows = []
        def add_field(*_args: object) -> None:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            key = Gtk.Entry(placeholder_text="Field name (for example host)")
            value = Gtk.Entry(placeholder_text="Value")
            private = Gtk.CheckButton(label="Secret")
            private.connect("toggled", lambda button: value.set_visibility(not button.get_active()))
            row.append(key); row.append(value); row.append(private)
            fields.append(row)
            rows.append((key, value, private))
        add_field()
        another = Gtk.Button(label="Add field")
        another.connect("clicked", add_field)
        content.append(another)
        error = label("", "critical")
        content.append(error)
        def save(window: Gtk.Dialog, response: int) -> None:
            if response != Gtk.ResponseType.OK:
                window.destroy(); return
            app_name = name.get_text().strip()
            names = [key.get_text().strip() for key, _, _ in rows]
            if not app_name or len(set(names)) != len(names) or any(not key.isidentifier() or key.startswith('_') for key in names):
                error.set_text("Supply an app name and unique field names containing letters, numbers or underscores."); return
            integration_id = "custom-" + hashlib.sha256(app_name.encode()).hexdigest()[:12]
            spec = {"id": integration_id, "name": app_name, "kind": "custom", "port": 0,
                    "description": "User-defined configuration; no executable adapter is implied.",
                    "fields": [{"key": key, "secret": private.get_active()} for key, (_, _, private) in zip(names, rows)]}
            self.config.setdefault("custom_integrations", []).append(spec)
            save_config(self.config)
            entries = {key: value for key, (_, value, _) in zip(names, rows)}
            self.integration_response(window, Gtk.ResponseType.OK, spec, entries)
        dialog.connect("response", save)
        dialog.present()

    def integration_application_status(self, spec: dict[str, object]) -> tuple[str, str]:
        if spec["kind"] == "custom":
            return "User-defined", "muted"
        integration_id = str(spec["id"])
        _, listeners = run(["ss", "-lntH"])
        if spec["port"] and f":{spec['port']}" in listeners:
            return "Running", "good"
        commands = {
            "exiftool": ("exiftool",),
            "sniffnet": ("sniffnet",),
            "borgbackup": ("borg",),
            "mosquitto": ("mosquitto", "mosquitto_sub"),
            "esphome": ("esphome",),
            "piper": ("piper", "wyoming-piper"),
            "speech-to-phrase": ("speech-to-phrase", "wyoming-speech-to-phrase"),
            "wyoming": ("wyoming-satellite",),
            "home-assistant": ("hass",),
            "zigbee2mqtt": ("zigbee2mqtt",),
            "jellyfin": ("jellyfin",),
            "zwavejs": ("zwave-js-server",),
        }
        if any(shutil.which(command) for command in commands.get(integration_id, ())):
            return "Installed, not running", "warning"
        code, processes = run(["pgrep", "-a", "-f", integration_id])
        if code == 0 and processes:
            return "Process detected", "good"
        snapshot = read_text("/run/shai/network-snapshot.json")
        if integration_id in snapshot:
            return "Managed service detected", "good"
        return "Not found", "critical"

    def integration_configuration_status(
        self,
        spec: dict[str, object],
        values: dict[str, object],
    ) -> tuple[str, str]:
        if not values:
            return "Not configured", "warning"
        kind = spec["kind"]
        required = {
            "ha": ("url", "token"),
            "mqtt": ("host", "port"),
            "sniffnet": ("adapter",),
            "path": ("path",),
            "endpoint": ("host", "port"),
        }.get(str(kind), ())
        missing = [key for key in required if not str(values.get(key, "")).strip()
                   and not (key == "token" and values.get("secret_ref"))]
        return ("Incomplete (" + ", ".join(missing) + " missing)", "warning") if missing else ("Complete", "good")

    @staticmethod
    def integration_health_status(values: dict[str, object]) -> tuple[str, str]:
        state = str(values.get("_health", "not-tested")) if values else "not-tested"
        if state == "connected":
            return "Connected", "good"
        if state == "attention":
            return "Needs attention", "critical"
        return "Not tested", "warning"

    def integration_summary(self, spec: dict[str, object], values: dict[str, object]) -> str:
        kind = spec["kind"]
        if kind == "custom":
            fields = [f"{key}: {value}" for key, value in values.items() if not key.startswith('_') and key != "secret_ref"]
            if values.get("secret_ref"):
                fields.append("Secrets: stored in vault")
            return " | ".join(fields) or "No values saved"
        if kind == "ha":
            return f"URL: {values.get('url', 'not set')} | Token: {'stored in vault' if values.get('secret_ref') else 'not set'}"
        if kind == "mqtt":
            return f"Broker: {values.get('host', '127.0.0.1')}:{values.get('port', 1883)} | User: {values.get('username') or 'anonymous'}"
        if kind == "sniffnet":
            return f"Adapter: {values.get('adapter', 'automatic')} | Structured network data: SHEALTH"
        if kind == "path":
            return f"Repository: {values.get('path', 'not set')}"
        return f"Endpoint: {values.get('host', '127.0.0.1')}:{values.get('port', spec['port'])}"

    def integration_fields(self, spec: dict[str, object]) -> list[tuple[str, str, str, bool]]:
        kind = spec["kind"]
        if kind == "exiftool":
            return [("path", "Default file or folder", str(Path.home()), False)]
        if kind == "custom":
            return [(field["key"], field["key"], "", bool(field["secret"])) for field in spec.get("fields", [])]
        if kind == "ha":
            return [
                ("url", "Home Assistant URL", "http://127.0.0.1:8123", False),
                ("token", "Long-lived access token", "", True),
            ]
        if kind == "mqtt":
            fields = [
                ("host", "MQTT broker host", "127.0.0.1", False),
                ("port", "MQTT broker port", "1883", False),
                ("username", "MQTT username", "", False),
                ("password", "MQTT password", "", True),
            ]
            if spec["id"] == "zigbee2mqtt":
                fields.append(("base_topic", "Zigbee2MQTT base topic", "zigbee2mqtt", False))
            return fields
        if kind == "sniffnet":
            adapters = [path.name for path in Path("/sys/class/net").iterdir() if path.name != "lo"]
            return [("adapter", "Network adapter", adapters[0] if adapters else "", False)]
        if kind == "path":
            return [("path", "Local Borg repository path", str(Path.home() / "Backups"), False)]
        return [
            ("host", "Service host", "127.0.0.1", False),
            ("port", "Service port", str(spec["port"]), False),
        ]

