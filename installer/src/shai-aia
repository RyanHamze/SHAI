    def online_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.config["online_installs"] = switch.get_active()
        save_config(self.config)
        audit("online-install-policy", "enabled" if switch.get_active() else "disabled")

    def history_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.config["save_chat"] = switch.get_active()
        save_config(self.config)
        audit("chat-history", "enabled" if switch.get_active() else "disabled")
        if not switch.get_active():
            (STATE_DIR / "chat-history.json").unlink(missing_ok=True)

    def clear_chat(self, _button: Gtk.Button) -> None:
        self.chat_messages.clear()
        self.config["save_chat"] = False
        save_config(self.config)
        (STATE_DIR / "chat-history.json").unlink(missing_ok=True)
        audit("chat-cleared", "Local chat history cleared; installed models retained")
        if self.stack.get_visible_child_name() == "Chat":
            self.build_chat()
        else:
            self.build_settings()

    def reset_model(self, _button: Gtk.Button) -> None:
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK_CANCEL,
                                  text="Unload the active model?", secondary_text="Inference stops for AIA and Open WebUI. Installed model files remain. Select a default in Models to resume.")
        def confirmed(window: Gtk.Dialog, response: int) -> None:
            window.destroy()
            if response != Gtk.ResponseType.OK:
                return
            self.config["active_model"] = ""
            save_config(self.config)
            self.ensure_model_service()
            audit("model-reset", "Active model selection reset; model files retained")
            self.update_active_header()
            self.build_settings()
        dialog.connect("response", confirmed)
        dialog.present()

    def scan_timer(self) -> bool:
        fresh_config = load_config()
        if fresh_config != self.config:
            self.config = fresh_config
            self.update_active_header()
            if self.stack.get_visible_child_name() == "Chat":
                self.build_chat()
            elif self.stack.get_visible_child_name() == "Models":
                self.build_models()
        installed = {str(item["id"]) for item in installed_catalog_models()}
        if installed != self.last_installed and self.stack.get_visible_child_name() == "Models":
            self.build_models()
        self.last_installed = installed
        return True

    def error(self, message: str) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, buttons=Gtk.ButtonsType.CLOSE,
            text="AIA could not complete the action", secondary_text=message,
        )
        dialog.connect("response", lambda window, _response: window.destroy())
        dialog.present()


class AIAApplication(Gtk.Application):
    def __init__(self) -> None:
        GLib.set_prgname(APP_ID)
        GLib.set_application_name("AIA AI Assistant")
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def do_command_line(self, command_line: Gio.ApplicationCommandLine) -> int:
        self.activate()
        if "--control-center" in command_line.get_arguments():
            self.props.active_window.show_tab("Control Center")
        return 0

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self) -> None:
        window = self.props.active_window
        if not window:
            window = AIAWindow(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(AIAApplication().run())
