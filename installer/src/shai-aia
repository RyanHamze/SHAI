    def install_response(self, dialog: Gtk.MessageDialog, response: int, model: dict[str, object]) -> None:
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        DATA_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        destination = model_path(model)
        script = STATE_DIR / "approved-model-install.sh"
        body = textwrap.dedent(f"""\
#!/usr/bin/env bash
set -Eeuo pipefail
trap 'printf "\\nInstallation failed on line %s. Review the error above.\\n" "$LINENO"; read -r -p "Press Enter to close..."' ERR
printf '%s\\n' 'AIA approved online model installation' 'Source: {model['url']}' 'Destination: {destination}'
sudo apt-get install -y llama.cpp wget ca-certificates
install -d -m 0700 {shlex.quote(str(DATA_DIR))}
wget -4 --https-only --continue --output-document={shlex.quote(str(destination) + '.part')} {shlex.quote(str(model['url']))}
test "$(stat --format=%s {shlex.quote(str(destination) + '.part')})" -eq {int(model['bytes'])}
printf '%s  %s\\n' '{model['sha256']}' {shlex.quote(str(destination) + '.part')} | sha256sum --check --status
mv -- {shlex.quote(str(destination) + '.part')} {shlex.quote(str(destination))}
printf '%s  %s\\n' '{model['sha256']}' {shlex.quote(str(destination))} > {shlex.quote(str(destination) + '.sha256')}
python3 - {shlex.quote(str(CONFIG_FILE))} {shlex.quote(str(model['id']))} <<'PY'
import json
import os
import pathlib
import sys
path = pathlib.Path(sys.argv[1])
config = json.loads(path.read_text(encoding="utf-8"))
config["active_model"] = sys.argv[2]
config["last_model_error"] = ""
config["last_model_test"] = "Not run yet"
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(config, indent=2, sort_keys=True) + "\\n", encoding="utf-8")
temporary.chmod(0o600)
os.replace(temporary, path)
PY
systemctl --user daemon-reload
systemctl --user enable --now {SERVER_SERVICE}
systemctl --user restart {SERVER_SERVICE}
systemctl --user is-active --quiet {SERVER_SERVICE}
printf '%s\\n' 'Installation complete. Checksum verified, model activated, and local model service restarted.' 'This window will close in five seconds.'
sleep 5
""")
        script.write_text(body, encoding="utf-8")
        script.chmod(0o700)
        audit("install-approved", f"{model['id']} from {model['url']}")
        self.launch_terminal(script)

    def launch_terminal(self, script: Path) -> None:
        if shutil.which("ptyxis"):
            self.launch_command(["ptyxis", "--", "bash", str(script)])
        elif shutil.which("gnome-terminal"):
            self.launch_command(["gnome-terminal", "--", "bash", str(script)])
        else:
            self.error("No supported graphical terminal is installed.")

    def launch_command(self, command: list[str]) -> bool:
        try:
            subprocess.Popen(command)
            return True
        except OSError as exc:
            self.error(f"Could not launch {command[0]}: {exc}")
            return False

