def run(args: list[str], timeout: int = 5) -> tuple[int, str]:
    try:
        result = subprocess.run(
            args, check=False, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, timeout=timeout,
        )
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, str(exc)


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8")
    except OSError:
        return ""


def label(text: str, css: str | None = None, selectable: bool = False) -> Gtk.Label:
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_wrap(True)
    widget.set_selectable(selectable)
    if css:
        widget.add_css_class(css)
    return widget


def load_config() -> dict[str, object]:
    defaults: dict[str, object] = {
        "active_model": "",
        "online_installs": False,
        "save_chat": False,
        "home_assistant_url": "http://127.0.0.1:8123",
        "imported_models": [],
        "integrations": {},
    }
    try:
        loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            defaults.update(loaded)
    except (OSError, json.JSONDecodeError):
        pass
    return defaults


def save_config(config: dict[str, object]) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    CONFIG_FILE.parent.chmod(0o700)
    temporary = CONFIG_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(CONFIG_FILE)


def audit(action: str, detail: str) -> None:
    LOG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE_DIR.chmod(0o700)
    LOG_DIR.chmod(0o700)
    path = LOG_DIR / f"{dt.date.today().isoformat()}.log"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"{dt.datetime.now().astimezone().isoformat()} | {action} | {detail}\n")
    path.chmod(0o600)


def ensure_server_key() -> str:
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE_DIR.chmod(0o700)
    try:
        key = SERVER_KEY.read_text(encoding="utf-8").strip()
    except OSError:
        key = ""
    if not key:
        key = secrets.token_urlsafe(32)
        SERVER_KEY.write_text(key + "\n", encoding="utf-8")
    SERVER_KEY.chmod(0o600)
    return key


def memory_mb() -> tuple[int, int]:
    values: dict[str, int] = {}
    for line in read_text("/proc/meminfo").splitlines():
        if ":" not in line:
            continue
        key, raw = line.split(":", 1)
        try:
            values[key] = int(raw.strip().split()[0]) // 1024
        except (ValueError, IndexError):
            continue
    return values.get("MemTotal", 0), values.get("MemAvailable", 0)


def hardware() -> dict[str, object]:
    _, cpu_text = run(["lscpu"])
    cpu = "Unknown CPU"
    architecture = os.uname().machine
    for line in cpu_text.splitlines():
        if line.startswith("Model name:"):
            cpu = line.split(":", 1)[1].strip()
        elif line.startswith("Architecture:"):
            architecture = line.split(":", 1)[1].strip()
    _, gpu_text = run(["lspci"])
    gpu_lines = [line for line in gpu_text.splitlines() if any(key in line.lower() for key in ("vga", "3d controller", "display controller"))]
    total, available = memory_mb()
    usage = shutil.disk_usage(DATA_DIR.parent if DATA_DIR.parent.exists() else Path.home())
    return {
        "cpu": cpu,
        "architecture": architecture,
        "cores": os.cpu_count() or 1,
        "ram_total_mb": total,
        "ram_available_mb": available,
        "disk_free_mb": usage.free // 1024 // 1024,
        "gpu": "\n".join(gpu_lines) if gpu_lines else "No GPU exposed to this environment",
        "runtime": shutil.which("llama-cli") or "Not installed",
    }


def ipv4_connection(host: str, port: int, timeout: int = 4) -> socket.socket:
    addresses = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)
    last_error: OSError | None = None
    for _family, socktype, proto, _canonname, address in addresses:
        connection = socket.socket(socket.AF_INET, socktype, proto)
        connection.settimeout(timeout)
        try:
            connection.connect(address)
            return connection
        except OSError as exc:
            last_error = exc
            connection.close()
    raise last_error or OSError(f"No IPv4 address found for {host}")


def ipv4_http_status(url: str, headers: dict[str, str]) -> int:
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise ValueError("URL must use http or https and include a hostname")
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    connection_socket = ipv4_connection(parsed.hostname, port)
    if parsed.scheme == "https":
        context = ssl.create_default_context()
        connection_socket = context.wrap_socket(connection_socket, server_hostname=parsed.hostname)
    connection = http.client.HTTPConnection(parsed.hostname, port, timeout=4)
    connection.sock = connection_socket
    path = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
    try:
        connection.request("GET", path, headers=headers)
        response = connection.getresponse()
        response.read(4096)
        return response.status
    finally:
        connection.close()


def model_path(model: dict[str, object]) -> Path:
    return DATA_DIR / str(model["file"])


def installed_catalog_models() -> list[dict[str, object]]:
    return [model for model in MODELS if model_path(model).is_file()]


