    def integration_response(
        self,
        dialog: Gtk.Dialog,
        response: int,
        spec: dict[str, object],
        entries: dict[str, Gtk.Entry],
    ) -> None:
        if response != Gtk.ResponseType.OK:
            dialog.destroy()
            return
        values = {key: entry.get_text().strip() for key, entry in entries.items()}
        integrations = self.config.get("integrations", {})
        if not isinstance(integrations, dict):
            integrations = {}
        integrations[str(spec["id"])] = values
        self.config["integrations"] = integrations
        if spec["id"] == "home-assistant":
            self.config["home_assistant_url"] = values.get("url", "http://127.0.0.1:8123")
        result, success = self.test_integration(spec, values)
        values["_health"] = "connected" if success else "attention"
        values["_health_message"] = result
        values["_tested_at"] = dt.datetime.now().astimezone().isoformat()
        integrations[str(spec["id"])] = values
        save_config(self.config)
        audit("integration-configured", f"{spec['id']} | {'success' if success else 'failed'} | {result}")
        dialog.destroy()
        self.integration_result(str(spec["name"]), result, success)
        self.build_integrations()

    def test_integration(self, spec: dict[str, object], values: dict[str, str]) -> tuple[str, bool]:
        kind = spec["kind"]
        try:
            if kind == "ha":
                url = values.get("url", "http://127.0.0.1:8123").rstrip("/") + "/api/"
                token = values.get("token", "")
                headers = {"Authorization": f"Bearer {token}"} if token else {}
                status = ipv4_http_status(url, headers)
                return f"Home Assistant API responded with HTTP {status}.", status == 200
            if kind == "mqtt":
                host = values.get("host", "127.0.0.1")
                port = int(values.get("port", "1883"))
                with ipv4_connection(host, port):
                    pass
                if spec["id"] == "zigbee2mqtt" and shutil.which("mosquitto_sub"):
                    result = self.zigbee_health(values)
                    if result:
                        return f"MQTT connected; Zigbee2MQTT health response: {result[:180]}", True
                return f"MQTT broker accepted a TCP connection at {host}:{port}. Authentication/topics were not changed.", True
            if kind == "sniffnet":
                return ("Sniffnet is installed and ready to launch." if shutil.which("sniffnet") else "Sniffnet is not installed; install it in SHAPP first.", bool(shutil.which("sniffnet")))
            if kind == "path":
                path = Path(values.get("path", "")).expanduser()
                return (f"Backup destination exists: {path}" if path.is_dir() else f"Destination does not exist yet: {path}", path.is_dir() and bool(shutil.which("borg")))
            host = values.get("host", "127.0.0.1")
            port = int(values.get("port", str(spec["port"])))
            with ipv4_connection(host, port):
                return f"Local service accepted a connection at {host}:{port}.", True
        except (OSError, ValueError, urllib.error.URLError) as exc:
            return f"Connection test failed: {exc}", False

    def zigbee_health(self, values: dict[str, str]) -> str:
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        config_path = STATE_DIR / "mqtt-test.conf"
        lines = [f"--host {values.get('host', '127.0.0.1')}", f"--port {values.get('port', '1883')}"]
        if values.get("username"):
            lines.append(f"--username {values['username']}")
        if values.get("password"):
            lines.append(f"--pw {values['password']}")
        config_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        config_path.chmod(0o600)
        topic = values.get("base_topic", "zigbee2mqtt") + "/bridge/health"
        code, output = run(["mosquitto_sub", "-o", str(config_path), "-t", topic, "-C", "1", "-W", "3"], timeout=5)
        config_path.unlink(missing_ok=True)
        return output if code == 0 else ""

    def integration_result(self, name: str, result: str, success: bool) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            buttons=Gtk.ButtonsType.CLOSE,
            text=f"{name}: {'connected' if success else 'needs attention'}",
            secondary_text=result,
        )
        dialog.connect("response", lambda window, _response: window.destroy())
        dialog.present()

    def test_saved_integration(self, spec: dict[str, object]) -> None:
        integrations = self.config.get("integrations", {})
        if not isinstance(integrations, dict):
            return
        values = integrations.get(str(spec["id"]), {})
        if not isinstance(values, dict):
            return
        result, success = self.test_integration(spec, values)
        values["_health"] = "connected" if success else "attention"
        values["_health_message"] = result
        values["_tested_at"] = dt.datetime.now().astimezone().isoformat()
        integrations[str(spec["id"])] = values
        save_config(self.config)
        audit("integration-tested", f"{spec['id']} | {'success' if success else 'failed'} | {result}")
        self.integration_result(str(spec["name"]), result, success)
        self.build_integrations()

    def open_integration(self, spec: dict[str, object]) -> None:
        configured = self.config.get("integrations", {})
        values = configured.get(spec["id"], {}) if isinstance(configured, dict) else {}
        if spec["kind"] == "sniffnet":
            executable = shutil.which("sniffnet")
            if not executable:
                self.integration_result(str(spec["name"]), "Install Sniffnet in SHAPP first.", False)
                return
            command = [executable]
            if values.get("adapter"):
                command.extend(["--adapter", str(values["adapter"])])
            subprocess.Popen(command)
            audit("integration-opened", "sniffnet")
            return
        if spec["kind"] == "ha":
            url = str(values.get("url", self.config.get("home_assistant_url", "http://127.0.0.1:8123")))
        else:
            host = str(values.get("host", "127.0.0.1"))
            port = str(values.get("port", spec["port"]))
            url = f"http://{host}:{port}"
        subprocess.Popen(["xdg-open", url])
        audit("integration-opened", str(spec["id"]))

    def build_activity(self) -> None:
        box = self.pages["Activity"]
        self.clear(box)
        self.heading(box, "AIA activity", "One append-only local log per day. Prompts are excluded unless chat history is explicitly enabled.")
        path = LOG_DIR / f"{dt.date.today().isoformat()}.log"
        box.append(label(read_text(str(path)) or "No activity recorded today.", "panel", selectable=True))
        open_logs = Gtk.Button(label="Open activity folder")
        open_logs.connect("clicked", lambda *_: subprocess.Popen(["xdg-open", str(LOG_DIR)]))
        box.append(open_logs)

    def build_settings(self) -> None:
        box = self.pages["Settings"]
        self.clear(box)
        self.heading(box, "Settings", "AIA defaults to offline operation and stores configuration only for this user.")
        online_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        online_copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        online_copy.set_hexpand(True)
        online_copy.append(label("Allow approved online installs", "section"))
        online_copy.append(label("Enables labelled install buttons. Every download still requires confirmation in AIA and again in a visible terminal.", "muted"))
        online_row.append(online_copy)
        online = Gtk.Switch()
        online.set_active(bool(self.config.get("online_installs")))
        online.connect("notify::active", self.online_changed)
        online_row.append(online)
        online_row.add_css_class("panel")
        box.append(online_row)

        history_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        history_copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        history_copy.set_hexpand(True)
        history_copy.append(label("Save local chat history", "section"))
        history_copy.append(label("Off by default. When enabled, chat is stored only under your private SHAI state folder.", "muted"))
        history_row.append(history_copy)
        history = Gtk.Switch()
        history.set_active(bool(self.config.get("save_chat")))
        history.connect("notify::active", self.history_changed)
        history_row.append(history)
        history_row.add_css_class("panel")
        box.append(history_row)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        clear_chat = Gtk.Button(label="Clear local chat")
        clear_chat.add_css_class("destructive-action")
        clear_chat.connect("clicked", self.clear_chat)
        actions.append(clear_chat)
        reset_model = Gtk.Button(label="Reset active model")
        reset_model.add_css_class("destructive-action")
        reset_model.connect("clicked", self.reset_model)
        actions.append(reset_model)
        box.append(actions)
        box.append(label("AIA downloads and connection tests use IPv4 only. Ubuntu's system-wide IPv6 setting is not changed.", "muted"))
        box.append(label(f"Models: {DATA_DIR}\nConfiguration: {CONFIG_FILE}\nActivity: {LOG_DIR}\nNo telemetry or automatic update check is implemented.", "muted", selectable=True))

    def online_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.config["online_installs"] = switch.get_active()
        save_config(self.config)
        audit("online-install-policy", "enabled" if switch.get_active() else "disabled")

    def history_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.config["save_chat"] = switch.get_active()
        save_config(self.config)
        audit("chat-history", "enabled" if switch.get_active() else "disabled")
        if not switch.get_active():
            (STATE_DIR / "chat-history.json").unlink(missing_ok=True)

    def clear_chat(self, _button: Gtk.Button) -> None:
        self.chat_messages.clear()
        self.config["save_chat"] = False
        save_config(self.config)
        (STATE_DIR / "chat-history.json").unlink(missing_ok=True)
        audit("chat-cleared", "Local chat history cleared; installed models retained")
        if self.stack.get_visible_child_name() == "Chat":
            self.build_chat()
        else:
            self.build_settings()

    def reset_model(self, _button: Gtk.Button) -> None:
        self.config["active_model"] = ""
        save_config(self.config)
        self.ensure_model_service()
        audit("model-reset", "Active model selection reset; model files retained")
        self.update_active_header()
        self.build_settings()

    def scan_timer(self) -> bool:
        installed = {str(item["id"]) for item in installed_catalog_models()}
        new = installed - self.last_installed
        if new:
            candidates = [item for item in MODELS if item["id"] in installed]
            promoted = max(candidates, key=lambda item: int(item["rank"]))
            self.config["active_model"] = promoted["id"]
            save_config(self.config)
            self.ensure_model_service(restart=True)
            audit("model-auto-promoted", str(promoted["name"]))
            self.update_active_header()
            if self.stack.get_visible_child_name() == "Models":
                self.build_models()
        self.last_installed = installed
        return True

    def error(self, message: str) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, buttons=Gtk.ButtonsType.CLOSE,
            text="AIA could not complete the action", secondary_text=message,
        )
        dialog.connect("response", lambda window, _response: window.destroy())
        dialog.present()


class AIAApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self) -> None:
        window = self.props.active_window
        if not window:
            window = AIAWindow(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(AIAApplication().run())
