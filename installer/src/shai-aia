    def send_chat(self, _widget: Gtk.Widget) -> None:
        if self.busy:
            return
        prompt = self.chat_entry.get_text().strip()
        if not prompt:
            return
        self.chat_entry.set_text("")
        self.chat_messages.append(("You", prompt))
        self.render_chat()
        local_answer = self.local_status_answer(prompt)
        if local_answer:
            self.chat_messages.append(("AIA", local_answer))
            self.render_chat()
            self.record_chat()
            audit("local-status-answer", "Answered from local configuration")
            return
        active_path = self.active_path()
        if active_path and shutil.which("llama-server"):
            self.ensure_model_service()
            self.busy = True
            self.send_button.set_sensitive(False)
            self.chat_messages.append(("AIA", "Thinking locally..."))
            self.render_chat()
            history = list(self.chat_messages[:-2])
            threading.Thread(target=self.run_inference, args=(prompt, history), daemon=True).start()
        else:
            detail = "No active local model is configured" if not active_path else "llama-server is not installed"
            self.set_model_error(detail)
            if self.config.get("active_model"):
                self.chat_messages.append(("AIA", f"Local model unavailable: {detail}. Open Models or Activity for the exact status."))
            else:
                self.chat_messages.append(("AIA", self.deterministic_answer(prompt)))
            self.render_chat()
            self.record_chat()

    def local_status_answer(self, prompt: str) -> str:
        """Answer local-status questions from SHAI state instead of asking a small model to guess."""
        lowered = prompt.casefold()
        integrations = self.config.get("integrations", {})
        if not isinstance(integrations, dict):
            integrations = {}
        if "integrations" in lowered and any(word in lowered for word in ("list", "show", "what", "status")):
            if not integrations:
                return "AIA local status: no integrations are configured yet. Open Integrations to add Home Assistant or another local service."
            lines = []
            for integration_id, values in sorted(integrations.items()):
                state = values.get("_health", "configured") if isinstance(values, dict) else "configured"
                lines.append(f"{integration_id}: {state}")
            return "AIA local integration status: " + "; ".join(lines) + "."
        if "home assistant" in lowered and any(word in lowered for word in ("connect", "integrat", "status", "configured")):
            values = integrations.get("home-assistant", {})
            if not isinstance(values, dict) or not values:
                return "AIA local status: Home Assistant is not configured. Open Integrations, enter its local URL and access token, then test the connection."
            state = str(values.get("_health", "configured"))
            message = str(values.get("_health_message", "No connection test has been run."))
            return f"AIA local status: Home Assistant is {state}. {message}"
        return ""

    def deterministic_answer(self, prompt: str) -> str:
        lowered = prompt.lower()
        if any(word in lowered for word in ("hardware", "ram", "memory", "cpu", "gpu", "disk")):
            return (
                f"Detected {self.hw['cores']} CPU threads on {self.hw['cpu']}, "
                f"{int(self.hw['ram_total_mb']) / 1024:.1f} GiB RAM with "
                f"{int(self.hw['ram_available_mb']) / 1024:.1f} GiB available, and "
                f"{int(self.hw['disk_free_mb']) / 1024:.1f} GiB free disk. GPU: {self.hw['gpu']}."
            )
        if "model" in lowered or "recommend" in lowered or "ai" in lowered:
            choice = self.best_recommendation()
            return (
                f"My current recommendation is {choice['name']} ({choice['params']}). "
                f"Reason: {self.fit(choice)[1]}. Open Models to review sources, license, resource estimates, "
                "and approve any online download."
            )
        if "home assistant" in lowered or lowered.strip() == "ha":
            return (
                "Home Assistant is treated as a separate local service. AIA may explain configuration and "
                "prepare proposed changes, but it will not control devices or modify Home Assistant without approval."
            )
        if "port" in lowered or "network" in lowered or "firewall" in lowered:
            return "Open SHEALTH Network for the live local port, owner, and connection inventory. AIA does not perform a new network scan."
        if "install" in lowered or "command" in lowered:
            return "Chat cannot execute commands. Use a reviewed action in Models or SHAPP; AIA will show the source and open a visible terminal after confirmation."
        return (
            "The lightweight deterministic assistant cannot answer that reliably. Install an approved local model "
            "from Models, or ask about detected hardware, model recommendations, SHAI status, or Home Assistant."
        )

    def run_inference(self, prompt: str, history: list[tuple[str, str]]) -> None:
        try:
            deadline = time.monotonic() + 90
            while time.monotonic() < deadline and not self.server_ready():
                time.sleep(1)
            if not self.server_ready():
                raise ValueError("The persistent local model service did not become ready. Check the model status above or AIA Activity.")
            messages: list[dict[str, str]] = [{"role": "system", "content": self.system_prompt()}]
            messages.append({"role": "user", "content": prompt})
            answer = self.request_completion(messages)
            previous = next((text for role, text in reversed(history) if role == "AIA"), "")
            if previous and answer.casefold().strip() == previous.casefold().strip():
                answer = self.request_completion([
                    {"role": "system", "content": self.system_prompt()},
                    {"role": "user", "content": f"Answer this new question directly and do not repeat the previous answer: {prompt}"},
                ])
        except (OSError, ValueError, TypeError, KeyError, IndexError, http.client.HTTPException) as exc:
            message = f"Local inference failed: {exc}"
            GLib.idle_add(self.finish_inference, message, message)
            return
        GLib.idle_add(self.finish_inference, answer, "")

    def finish_inference(self, answer: str, error: str = "") -> bool:
        if self.chat_messages and self.chat_messages[-1] == ("AIA", "Thinking locally..."):
            self.chat_messages[-1] = ("AIA", answer)
        else:
            self.chat_messages.append(("AIA", answer))
        self.busy = False
        self.send_button.set_sensitive(True)
        if error:
            self.set_model_error(error)
        else:
            self.clear_model_error()
        self.render_chat()
        self.record_chat()
        audit("inference", f"Completed with active model {self.config.get('active_model')}")
        return False

    def test_active_model(self, _button: Gtk.Button) -> None:
        if self.busy or not self.active_model():
            return
        self.busy = True
        threading.Thread(target=self.run_model_test, daemon=True).start()

    def run_model_test(self) -> None:
        try:
            system = self.system_prompt()
            first = self.request_completion([
                {"role": "system", "content": system},
                {"role": "user", "content": "What is 7 plus 5? Answer concisely."},
            ], max_tokens=48)
            second = self.request_completion([
                {"role": "system", "content": system},
                {"role": "user", "content": "Name one primary color. Answer concisely."},
            ], max_tokens=48)
            if first.casefold().strip() == second.casefold().strip():
                raise ValueError("model returned the same response to two distinct prompts")
            result = f"Passed: {first[:72]} | {second[:72]}"
            GLib.idle_add(self.finish_model_test, result, "")
        except (OSError, ValueError, TypeError, KeyError, IndexError, http.client.HTTPException) as exc:
            GLib.idle_add(self.finish_model_test, "Failed", str(exc))

    def finish_model_test(self, result: str, error: str) -> bool:
        self.busy = False
        self.config["last_model_test"] = result
        if error:
            self.set_model_error(f"Model test failed: {error}")
        else:
            self.clear_model_error()
        save_config(self.config)
        audit("model-test", result if not error else f"failed | {error}")
        if self.stack.get_visible_child_name() == "Chat":
            self.build_chat()
        return False

    def record_chat(self) -> None:
        if not bool(self.config.get("save_chat")):
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = STATE_DIR / "chat-history.json"
        path.write_text(json.dumps(self.chat_messages, indent=2) + "\n", encoding="utf-8")
        path.chmod(0o600)

