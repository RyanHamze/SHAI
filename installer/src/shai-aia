    def render_chat(self) -> None:
        if not hasattr(self, "chat_view"):
            return
        if not self.chat_messages:
            text = (
                "AIA: I am ready in deterministic mode. I can summarize detected hardware, "
                "explain model recommendations, and report local SHAI status without an LLM."
            )
        else:
            text = "\n\n".join(f"{role}: {message}" for role, message in self.chat_messages)
        self.chat_view.get_buffer().set_text(text)

    def send_chat(self, _widget: Gtk.Widget) -> None:
        if self.busy:
            return
        prompt = self.chat_entry.get_text().strip()
        if not prompt:
            return
        self.chat_entry.set_text("")
        self.chat_messages.append(("You", prompt))
        self.render_chat()
        active_path = self.active_path()
        if active_path and shutil.which("llama-server"):
            self.ensure_model_service()
            self.busy = True
            self.send_button.set_sensitive(False)
            self.chat_messages.append(("AIA", "Thinking locally..."))
            self.render_chat()
            threading.Thread(target=self.run_inference, args=(prompt,), daemon=True).start()
        else:
            self.chat_messages.append(("AIA", self.deterministic_answer(prompt)))
            self.render_chat()
            self.record_chat()

    def deterministic_answer(self, prompt: str) -> str:
        lowered = prompt.lower()
        if any(word in lowered for word in ("hardware", "ram", "memory", "cpu", "gpu", "disk")):
            return (
                f"Detected {self.hw['cores']} CPU threads on {self.hw['cpu']}, "
                f"{int(self.hw['ram_total_mb']) / 1024:.1f} GiB RAM with "
                f"{int(self.hw['ram_available_mb']) / 1024:.1f} GiB available, and "
                f"{int(self.hw['disk_free_mb']) / 1024:.1f} GiB free disk. GPU: {self.hw['gpu']}."
            )
        if "model" in lowered or "recommend" in lowered or "ai" in lowered:
            choice = self.best_recommendation()
            return (
                f"My current recommendation is {choice['name']} ({choice['params']}). "
                f"Reason: {self.fit(choice)[1]}. Open Models to review sources, license, resource estimates, "
                "and approve any online download."
            )
        if "home assistant" in lowered or lowered.strip() == "ha":
            return (
                "Home Assistant is treated as a separate local service. AIA may explain configuration and "
                "prepare proposed changes, but it will not control devices or modify Home Assistant without approval."
            )
        if "port" in lowered or "network" in lowered or "firewall" in lowered:
            return "Open SHEALTH Network for the live local port, owner, and connection inventory. AIA does not perform a new network scan."
        if "install" in lowered or "command" in lowered:
            return "Chat cannot execute commands. Use a reviewed action in Models or SHAPP; AIA will show the source and open a visible terminal after confirmation."
        return (
            "The lightweight deterministic assistant cannot answer that reliably. Install an approved local model "
            "from Models, or ask about detected hardware, model recommendations, SHAI status, or Home Assistant."
        )

    def run_inference(self, prompt: str) -> None:
        system = (
            "You are AIA, the offline SHAI local assistant. Be concise and honest. Never claim to have "
            "executed commands, changed the host, controlled devices, or accessed the internet. Propose actions "
            "for explicit user approval. Ubuntu remains the host OS."
        )
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline and not self.server_ready():
            time.sleep(1)
        if not self.server_ready():
            GLib.idle_add(self.finish_inference, "The persistent local model service did not become ready. Check AIA Activity for its service status.")
            return
        messages: list[dict[str, str]] = [{"role": "system", "content": system}]
        for role, text in self.chat_messages[-10:-2]:
            if text == "Thinking locally...":
                continue
            messages.append({"role": "user" if role == "You" else "assistant", "content": text})
        messages.append({"role": "user", "content": prompt})
        payload = json.dumps({
            "model": "local",
            "messages": messages,
            "max_tokens": 256,
            "temperature": 0.4,
            "stream": False,
        }).encode("utf-8")
        request = urllib.request.Request(
            SERVER_URL + "/v1/chat/completions",
            data=payload,
            headers={
                "Authorization": f"Bearer {ensure_server_key()}",
                "Content-Type": "application/json",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=180) as response:
                result = json.loads(response.read().decode("utf-8"))
            answer = str(result["choices"][0]["message"]["content"]).strip()
            if not answer:
                raise ValueError("model returned an empty response")
        except (OSError, ValueError, KeyError, IndexError, json.JSONDecodeError, urllib.error.URLError) as exc:
            answer = f"Local inference failed: {exc}"
        GLib.idle_add(self.finish_inference, answer)

    def finish_inference(self, answer: str) -> bool:
        if self.chat_messages and self.chat_messages[-1] == ("AIA", "Thinking locally..."):
            self.chat_messages[-1] = ("AIA", answer)
        else:
            self.chat_messages.append(("AIA", answer))
        self.busy = False
        self.send_button.set_sensitive(True)
        self.render_chat()
        self.record_chat()
        audit("inference", f"Completed with active model {self.config.get('active_model')}")
        return False

    def record_chat(self) -> None:
        if not bool(self.config.get("save_chat")):
