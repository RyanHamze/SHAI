    def import_response(self, chooser: Gtk.FileChooserNative, response: int) -> None:
        if response == Gtk.ResponseType.ACCEPT:
            selected = chooser.get_file().get_path()
            if selected:
                source = Path(selected)
                try:
                    with source.open("rb") as stream:
                        if stream.read(4) != b"GGUF":
                            raise ValueError("This is not a GGUF model file.")
                except (OSError, ValueError) as exc:
                    self.error(str(exc))
                    chooser.destroy()
                    return
                item = {
                    "id": "imported-" + hashlib.sha256(str(source.resolve()).encode()).hexdigest()[:16],
                    "name": source.stem,
                    "path": str(source.resolve()),
                    "publisher": "User-provided",
                    "license": "Not recorded",
                }
                imported = [entry for entry in self.config.get("imported_models", []) if isinstance(entry, dict) and entry.get("id") != item["id"]]
                imported.append(item)
                self.config["imported_models"] = imported
                self.config["active_model"] = item["id"]
                save_config(self.config)
                self.ensure_model_service(restart=True)
                audit("model-imported", str(source.resolve()))
                self.update_active_header()
                self.build_models()
        chooser.destroy()

