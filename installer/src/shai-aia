        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = STATE_DIR / "chat-history.json"
        path.write_text(json.dumps(self.chat_messages, indent=2) + "\n", encoding="utf-8")
        path.chmod(0o600)

