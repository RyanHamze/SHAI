    def remove_imported(self, model: dict[str, object]) -> None:
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.NONE,
                                  text=f"Remove {model['name']} from AIA?",
                                  secondary_text="The original GGUF file is preserved. Both AIA chat and Open WebUI will switch to the remaining default model.")
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Remove", Gtk.ResponseType.OK)
        def confirmed(window: Gtk.Dialog, response: int) -> None:
            window.destroy()
            if response != Gtk.ResponseType.OK:
                return
            self.config["imported_models"] = [x for x in self.config.get("imported_models", []) if x.get("id") != model["id"]]
