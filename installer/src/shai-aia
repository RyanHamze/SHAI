    def active_model(self) -> dict[str, object] | None:
        active_id = str(self.config.get("active_model", ""))
        for model in MODELS:
            if model["id"] == active_id and model_path(model).is_file():
                return model
        for item in self.config.get("imported_models", []):
            if isinstance(item, dict) and item.get("id") == active_id and Path(str(item.get("path", ""))).is_file():
                return item
        return None

    def active_path(self) -> Path | None:
        active = self.active_model()
        if not active:
            return None
        if "path" in active:
            return Path(str(active["path"]))
        return model_path(active)

    def ensure_model_service(self, restart: bool = False) -> None:
        active_path = self.active_path()
        if not active_path or not shutil.which("llama-server"):
            run(["systemctl", "--user", "disable", "--now", SERVER_SERVICE], timeout=8)
            return
        ensure_server_key()
        run(["systemctl", "--user", "daemon-reload"], timeout=8)
        run(["systemctl", "--user", "enable", SERVER_SERVICE], timeout=8)
        action = "restart" if restart else "start"
        run(["systemctl", "--user", "set-property", "--runtime", SERVER_SERVICE,
             f"CPUQuota={max(20, (os.cpu_count() or 1) * 20)}%", "MemoryHigh=20%", "MemoryMax=25%"], timeout=8)
        code, output = run(["systemctl", "--user", action, SERVER_SERVICE], timeout=12)
        audit("model-service", f"{action} | {'ok' if code == 0 else output}")

    def server_ready(self) -> bool:
        if not self.active_path():
            return False
        request = urllib.request.Request(
            SERVER_URL + "/health",
            headers={"Authorization": f"Bearer {ensure_server_key()}"},
        )
        try:
            with urllib.request.urlopen(request, timeout=2) as response:
                return response.status == 200
        except (OSError, urllib.error.URLError):
            return False

    def service_status(self) -> tuple[str, str]:
        code, output = run(
            ["systemctl", "--user", "show", SERVER_SERVICE,
             "--property=ActiveState", "--property=SubState", "--property=MainPID"],
            timeout=4,
        )
        if code != 0:
            return "unavailable", output or "User service manager is unavailable"
        values = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
        state = values.get("ActiveState", "unknown")
        substate = values.get("SubState", "unknown")
        pid = values.get("MainPID", "0")
        active_path = self.active_path()
        command_path = ""
        if pid.isdigit() and int(pid) > 0:
            try:
                command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                index = command.index(b"--model")
                command_path = command[index + 1].decode("utf-8", errors="replace")
            except (OSError, ValueError, IndexError):
                pass
        if state == "active" and active_path and command_path != str(active_path):
            return "error", "Service model does not match the selected model; choose it again or restart AIA"
        if state == "active" and self.server_ready():
            return "ready", f"Service active (PID {pid}) · {active_path.name if active_path else 'no model path'}"
        if state == "active":
            return "starting", f"Service {substate}; local API is not ready yet"
        return "error", f"Service {state}/{substate}; PID {pid}"

    def set_model_error(self, message: str) -> None:
        self.config["last_model_error"] = message
        save_config(self.config)
        audit("model-error", message)

    def clear_model_error(self) -> None:
        if self.config.get("last_model_error"):
            self.config["last_model_error"] = ""
            save_config(self.config)

    def system_prompt(self) -> str:
        active = self.active_model()
        name = str(active["name"]) if active else "No active model"
        status, detail = self.service_status()
        integrations = self.config.get("integrations", {})
        home_assistant = integrations.get("home-assistant", {}) if isinstance(integrations, dict) else {}
        ha_status = str(home_assistant.get("_health", "not configured")) if isinstance(home_assistant, dict) else "not configured"
        return (
            "You are AIA, SHAI's concise local assistant. Answer only the current user question; do not repeat "
            "an unrelated earlier answer. Use one or two direct sentences. Never claim to have executed commands, "
            "changed the host, controlled devices, or accessed the internet. Propose actions for explicit user approval. "
            "Ubuntu remains the host OS. "
            f"Facts: selected local model is {name}; model service is {status} ({detail}); "
            f"Home Assistant integration status is {ha_status}. "
            "AIA can guide Home Assistant setup through its Integrations tab but cannot control devices without approval. "
            "If a fact is not supplied here or by the user, say you do not know."
        )

    def request_completion(self, messages: list[dict[str, str]], max_tokens: int = 256) -> str:
        payload = json.dumps({
            "model": "local",
            "messages": messages,
            "max_tokens": max_tokens,
            "temperature": 0.2,
            "repeat_penalty": 1.15,
            "repeat_last_n": 64,
            "frequency_penalty": 0.2,
            "stream": False,
        }).encode("utf-8")
        request = urllib.request.Request(
            SERVER_URL + "/v1/chat/completions",
            data=payload,
            headers={"Authorization": f"Bearer {ensure_server_key()}", "Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=180) as response:
            result = json.loads(response.read().decode("utf-8"))
        try:
            answer = result["choices"][0]["message"]["content"]
        except (TypeError, KeyError, IndexError) as exc:
            raise ValueError("model returned an invalid completion response") from exc
        if not isinstance(answer, str) or not answer.strip():
            raise ValueError("model returned an empty or non-text response")
        return answer.strip()

    def update_active_header(self) -> None:
        active = self.active_model()
        self.active_header.set_text(f"Active: {active['name']}" if active else "Deterministic mode")

    def fit(self, model: dict[str, object]) -> tuple[bool, str]:
        available = int(self.hw["ram_available_mb"])
        needed = int(model["ram_mb"])
        free_disk = int(self.hw["disk_free_mb"])
        if free_disk < int(model["disk_mb"]) * 2:
            return False, "Not enough free disk space"
        budget = max(0, min(int(self.hw["ram_total_mb"]) // 5, available - RESERVE_MB))
        if needed > budget:
            return False, f"Needs about {needed} MB; shared-host AI budget is {budget} MB (20% RAM target)"
        return True, f"Fits shared-host AI budget ({budget} MB); CPU target 20%, memory safety ceiling 25%"

    def best_recommendation(self) -> dict[str, object]:
        fitting = [model for model in MODELS if self.fit(model)[0]]
        return max(fitting, key=lambda item: int(item["rank"])) if fitting else MODELS[0]

