    def review_proposal(self, item: dict, decision: str) -> None:
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK_CANCEL,
                                  text=f"{'Approve' if decision == 'approve' else 'Reject'} this {item.get('risk', 'normal')}-risk request?",
                                  secondary_text=f"{item['action']}\n{json.dumps(item.get('arguments', {}), indent=2)}\n{item.get('reason', '')}")
        def confirmed(window: Gtk.Dialog, response: int) -> None:
            window.destroy()
            if response != Gtk.ResponseType.OK:
                return
            def worker() -> None:
                code, output = run(["pkexec", "/usr/lib/shai-installer/shai-control-approve", item["id"], decision], timeout=180)
                def finished() -> bool:
                    if code:
                        self.error(output or "Authorization cancelled or control request failed.")
                    self.build_control_center()
                    return False
                GLib.idle_add(finished)
            threading.Thread(target=worker, daemon=True).start()
        dialog.connect("response", confirmed)
        dialog.present()

