            self.ensure_model_service(restart=True)
            self.update_active_header()
            self.build_models()
        dialog.connect("response", confirmed)
        dialog.present()

    def build_control_center(self) -> None:
        box = self.pages["Control Center"]
        self.clear(box)
        self.heading(box, "Control Center", "Live local service state and approval requests. No example devices or sample actions.")
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
