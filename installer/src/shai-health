def label(value: str, css: str | None = None, wrap: bool = True) -> Gtk.Label:
    widget = Gtk.Label(label=value, xalign=0)
    widget.set_wrap(wrap)
    widget.set_selectable(True)
    if css:
        for css_class in css.split():
            widget.add_css_class(css_class)
    return widget


def run(args: list[str], timeout: int = 4) -> tuple[int, str, str]:
    try:
        result = subprocess.run(
            args, check=False, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=timeout,
        )
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8")
    except OSError:
        return ""


def load_settings() -> dict[str, object]:
    data = dict(DEFAULTS)
    try:
        loaded = json.loads(CONFIG.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            data.update(loaded)
    except (OSError, json.JSONDecodeError):
        pass
    return data


def save_settings(data: dict[str, object]) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temp = CONFIG.with_suffix(".tmp")
    temp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    temp.replace(CONFIG)


class HealthStore:
    def __init__(self) -> None:
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.db = sqlite3.connect(DB)
        self.db.row_factory = sqlite3.Row
        self.db.executescript("""
            PRAGMA journal_mode=WAL;
            CREATE TABLE IF NOT EXISTS samples (
              ts INTEGER PRIMARY KEY, cpu REAL, ram REAL, swap REAL, disk REAL,
              rx INTEGER, tx INTEGER, energy_wh REAL, docker_total INTEGER,
              docker_healthy INTEGER, heartbeat INTEGER NOT NULL
            );
            CREATE TABLE IF NOT EXISTS hourly (
              hour INTEGER PRIMARY KEY, cpu_max REAL, ram_max REAL, disk_max REAL,
              energy_wh REAL, worst TEXT, samples INTEGER,
              negative INTEGER DEFAULT 0, checks INTEGER DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS events (
              id INTEGER PRIMARY KEY AUTOINCREMENT, opened INTEGER, closed INTEGER,
              severity TEXT, source TEXT, message TEXT
            );
        """)
        columns = {row["name"] for row in self.db.execute("PRAGMA table_info(hourly)")}
        if "negative" not in columns:
            self.db.execute("ALTER TABLE hourly ADD COLUMN negative INTEGER DEFAULT 0")
        if "checks" not in columns:
            self.db.execute("ALTER TABLE hourly ADD COLUMN checks INTEGER DEFAULT 0")
        self.db.commit()

    def add_sample(self, sample: dict[str, object], settings: dict[str, object]) -> None:
        ts = int(sample["ts"])
        values = (
            ts, sample["cpu"], sample["ram"], sample["swap"], sample["disk"],
            sample["rx"], sample["tx"], sample["energy_wh"], sample["docker_total"],
            sample["docker_healthy"], ts,
        )
        self.db.execute("INSERT OR REPLACE INTO samples VALUES (?,?,?,?,?,?,?,?,?,?,?)", values)
        status = worst_status(sample, settings)
        negative, checks = sample_check_counts(sample, settings)
        hour = ts - ts % 3600
        self.db.execute("""
            INSERT INTO hourly(hour,cpu_max,ram_max,disk_max,energy_wh,worst,samples,negative,checks)
            VALUES (?,?,?,?,?,?,1,?,?)
            ON CONFLICT(hour) DO UPDATE SET
              cpu_max=max(cpu_max,excluded.cpu_max), ram_max=max(ram_max,excluded.ram_max),
              disk_max=max(disk_max,excluded.disk_max), energy_wh=energy_wh+excluded.energy_wh,
              worst=CASE WHEN instr('healthy warning critical',excluded.worst) >
                              instr('healthy warning critical',worst)
                         THEN excluded.worst ELSE worst END,
              samples=samples+1, negative=negative+excluded.negative,
              checks=checks+excluded.checks
        """, (hour, sample["cpu"], sample["ram"], sample["disk"], sample["energy_wh"], status, negative, checks))
        self._events(sample, settings, ts)
        raw_cutoff = ts - int(settings["retention_days"]) * 86400
        hourly_cutoff = ts - int(settings["hourly_retention_days"]) * 86400
        self.db.execute("DELETE FROM samples WHERE ts < ?", (raw_cutoff,))
        self.db.execute("DELETE FROM hourly WHERE hour < ?", (hourly_cutoff,))
        self.db.commit()
        self.export_daily_rollups()

    def export_daily_rollups(self) -> None:
        DAILY.mkdir(parents=True, exist_ok=True, mode=0o700)
        today = dt.date.today().isoformat()
        days = self.db.execute("""
            SELECT DISTINCT date(ts,'unixepoch','localtime') day
            FROM samples WHERE date(ts,'unixepoch','localtime') < ?
        """, (today,)).fetchall()
        for day_row in days:
            day = str(day_row["day"])
            destination = DAILY / f"{day}.json"
            if destination.exists():
                continue
            summary = self.db.execute("""
                SELECT count(*) samples, avg(cpu) cpu_average, max(cpu) cpu_peak,
                       avg(ram) ram_average, max(ram) ram_peak, max(disk) disk_peak,
                       sum(energy_wh) energy_wh
                FROM samples WHERE date(ts,'unixepoch','localtime')=?
            """, (day,)).fetchone()
            payload = {"date": day, **{key: summary[key] for key in summary.keys()}}
            temporary = destination.with_suffix(".tmp")
            temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
            temporary.chmod(0o600)
            temporary.replace(destination)

    def _events(self, sample: dict[str, object], settings: dict[str, object], ts: int) -> None:
        checks = (
            ("CPU", float(sample["cpu"]), float(settings["cpu_critical"])),
            ("Memory", float(sample["ram"]), float(settings["ram_critical"])),
            ("Disk", float(sample["disk"]), float(settings["disk_critical"])),
        )
        for source, value, critical in checks:
            existing = self.db.execute(
                "SELECT id FROM events WHERE source=? AND closed IS NULL", (source,)
            ).fetchone()
            if value >= critical and not existing:
                self.db.execute(
                    "INSERT INTO events(opened,closed,severity,source,message) VALUES(?,NULL,'critical',?,?)",
                    (ts, source, f"{source} reached {value:.1f}%"),
                )
            elif value < critical and existing:
                self.db.execute("UPDATE events SET closed=? WHERE id=?", (ts, existing["id"]))

    def recent(self, limit: int = 60) -> list[sqlite3.Row]:
        return self.db.execute(
            "SELECT * FROM samples ORDER BY ts DESC LIMIT ?", (limit,)
        ).fetchall()

    def heatmap(self, hours: int = 168) -> list[sqlite3.Row]:
        cutoff = int(time.time()) - hours * 3600
        return self.db.execute(
            "SELECT * FROM hourly WHERE hour>=? ORDER BY hour", (cutoff,)
        ).fetchall()

    def hourly_last(self, hours: int = 24) -> list[sqlite3.Row]:
        cutoff = int(time.time()) - hours * 3600
        return self.db.execute(
            "SELECT * FROM hourly WHERE hour>=? ORDER BY hour", (cutoff,)
        ).fetchall()

    def events(self, open_only: bool = False) -> list[sqlite3.Row]:
        where = "WHERE closed IS NULL" if open_only else ""
        return self.db.execute(
            f"SELECT * FROM events {where} ORDER BY opened DESC LIMIT 200"
        ).fetchall()

    def add_event(self, severity: str, source: str, message: str) -> None:
        self.db.execute(
            "INSERT INTO events(opened,closed,severity,source,message) VALUES(?,NULL,?,?,?)",
            (int(time.time()), severity, source, message),
        )
        self.db.commit()


def memory_sample() -> tuple[float, float, int, int]:
    values: dict[str, int] = {}
    for line in read_text("/proc/meminfo").splitlines():
        if ":" in line:
            key, raw = line.split(":", 1)
            try:
                values[key] = int(raw.strip().split()[0])
            except (ValueError, IndexError):
                pass
    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable", 0)
    swap_total = values.get("SwapTotal", 0)
    swap_free = values.get("SwapFree", 0)
    ram = ((total - available) / total * 100) if total else 0.0
    swap = ((swap_total - swap_free) / swap_total * 100) if swap_total else 0.0
    return ram, swap, total // 1024, swap_total // 1024


def cpu_counters() -> tuple[int, int]:
    fields = read_text("/proc/stat").splitlines()[0].split()[1:]
    values = [int(value) for value in fields]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return sum(values), idle


def net_sample() -> tuple[int, int, list[dict[str, object]]]:
    rx = tx = 0
    interfaces = []
    for line in read_text("/proc/net/dev").splitlines()[2:]:
        if ":" not in line:
            continue
        name, raw = line.split(":", 1)
        parts = raw.split()
        if len(parts) < 16:
            continue
        item = {
            "name": name.strip(), "rx": int(parts[0]), "tx": int(parts[8]),
            "rx_errors": int(parts[2]), "tx_errors": int(parts[10]),
            "rx_drop": int(parts[3]), "tx_drop": int(parts[11]),
        }
        interfaces.append(item)
        if item["name"] != "lo":
            rx += int(item["rx"]); tx += int(item["tx"])
    return rx, tx, interfaces


def disk_sample(mount: str = "/") -> dict[str, object]:
    try:
        usage = shutil.disk_usage(mount)
        stats = os.statvfs(mount)
        return {
            "mount": mount, "total": usage.total, "used": usage.used,
            "free": usage.free, "percent": usage.used / usage.total * 100 if usage.total else 0,
            "inodes_total": stats.f_files, "inodes_free": stats.f_ffree,
        }
    except OSError:
        return {"mount": mount, "total": 0, "used": 0, "free": 0, "percent": 0,
                "inodes_total": 0, "inodes_free": 0}


def docker_snapshot(details: bool = False) -> dict[str, object]:
    del details
    try:
        snapshot = json.loads(NETWORK_SNAPSHOT.read_text(encoding="utf-8"))
        observer = snapshot.get("observer", {})
        containers = snapshot.get("containers", [])
        events = snapshot.get("container_events", [])
        if not isinstance(observer, dict) or not isinstance(containers, list):
            raise ValueError("invalid service snapshot")
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as exc:
        return {"available": False, "error": f"Service status is unavailable: {exc}", "containers": [], "events": []}
    if not observer.get("available"):
        return {"available": False, "error": observer.get("error", "Service observer is unavailable"), "containers": [], "events": []}
    healthy = sum(
        item.get("status") == "running" and item.get("health") != "unhealthy"
        for item in containers
    )
    running = sum(item.get("status") == "running" for item in containers)
    return {"available": True, "error": "", "containers": containers,
            "healthy": healthy, "running": running, "events": events,
            "observer": observer}


def host_status() -> dict[str, str]:
    failed_rc, failed, _ = run([
        "systemctl", "--failed", "--no-legend", "--plain",
    ])
    ufw_rc, ufw, _ = run(["ufw", "status"], 3) if shutil.which("ufw") else (127, "", "")
    proxy = run(["gsettings", "get", "org.gnome.system.proxy", "mode"], 3)[1]
    reboot = "required" if Path("/var/run/reboot-required").exists() else "not required"
    return {
        "failed_units": "none" if failed_rc == 0 and not failed.strip() else failed.strip() or "unavailable",
        "firewall": ufw.splitlines()[0] if ufw_rc == 0 and ufw else "status unavailable without approval",
        "connectivity": "web offline" if "manual" in proxy else "web enabled",
        "reboot": reboot,
    }


def worst_status(sample: dict[str, object], settings: dict[str, object]) -> str:
    states = []
    for key, warning, critical in (
        ("cpu", "cpu_warning", "cpu_critical"),
        ("ram", "ram_warning", "ram_critical"),
        ("disk", "disk_warning", "disk_critical"),
    ):
        value = float(sample[key])
        states.append("critical" if value >= float(settings[critical]) else
                      "warning" if value >= float(settings[warning]) else "healthy")
    return "critical" if "critical" in states else "warning" if "warning" in states else "healthy"


def sample_check_counts(
    sample: dict[str, object], settings: dict[str, object]
) -> tuple[int, int]:
    checks = (
        (float(sample["cpu"]), float(settings["cpu_warning"])),
        (float(sample["ram"]), float(settings["ram_warning"])),
        (float(sample["disk"]), float(settings["disk_warning"])),
    )
    return sum(value >= threshold for value, threshold in checks), len(checks)


class Collector:
    def __init__(self, settings: dict[str, object]) -> None:
        self.settings = settings
        self.previous_cpu = cpu_counters()
        self.previous_time = time.monotonic()

    def collect(self) -> dict[str, object]:
        now = int(time.time())
        total, idle = cpu_counters()
        old_total, old_idle = self.previous_cpu
        delta = max(1, total - old_total)
        cpu = max(0.0, min(100.0, (1 - (idle - old_idle) / delta) * 100))
        elapsed = max(0.1, time.monotonic() - self.previous_time)
        self.previous_cpu = (total, idle); self.previous_time = time.monotonic()
        ram, swap, ram_mb, swap_mb = memory_sample()
        disk = disk_sample("/")
        rx, tx, interfaces = net_sample()
        docker = docker_snapshot(False)
        watts = float(self.settings["idle_watts"]) + (
            float(self.settings["max_watts"]) - float(self.settings["idle_watts"])
        ) * cpu / 100
        return {
            "ts": now, "cpu": cpu, "ram": ram, "swap": swap,
            "ram_mb": ram_mb, "swap_mb": swap_mb, "disk": disk["percent"],
            "disk_detail": disk, "rx": rx, "tx": tx, "interfaces": interfaces,
            "energy_wh": watts * elapsed / 3600, "watts": watts,
            "docker_total": len(docker["containers"]),
            "docker_healthy": int(docker.get("healthy", 0)), "docker": docker,
            "uptime": float(read_text("/proc/uptime").split()[0] or 0),
        }


def human_bytes(value: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(value) < 1024:
            return f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} PB"


def duration(seconds: float) -> str:
    days, remainder = divmod(int(seconds), 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes = remainder // 60
    return f"{days}d {hours}h {minutes}m" if days else f"{hours}h {minutes}m"


class HealthWindow(Gtk.ApplicationWindow):
    TABS = ("Health", "Disk", "Memory", "CPU", "Network", "Services", "Uptime", "Energy", "Events", "Settings")

    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="SHEALTH - SHAI Health")
        self.set_default_size(1180, 760)
        self.set_size_request(940, 620)
        self.settings = load_settings()
        self.store = HealthStore()
        self.collector = Collector(self.settings)
        self.sample: dict[str, object] = {}
        self.pages: dict[str, Gtk.Box] = {}
        self.nav: dict[str, Gtk.Button] = {}
        self.sniffnet_checked = 0.0
        self.sniffnet_result: tuple[bool, str, str] = (False, "", "")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        root.append(self.header())
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_vexpand(True); root.append(body)
        body.append(self.sidebar())
        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True); self.stack.set_vexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        body.append(self.stack)
        for name in self.TABS:
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            page.add_css_class("content")
            page.set_hexpand(True)
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_propagate_natural_width(False)
            scroll.set_child(page)
            self.pages[name] = page; self.stack.add_named(scroll, name)
        self.build_settings()
        self.collect_now()
        self.show_tab("Health")
        GLib.timeout_add_seconds(int(self.settings["sample_interval"]), self.sample_timer)
        GLib.timeout_add_seconds(int(self.settings["live_refresh"]), self.refresh_visible)

    def header(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        box.add_css_class("header")
        if BRAND.exists():
            logo = Gtk.Picture.new_for_filename(str(BRAND)); logo.set_size_request(210, 46)
            logo.set_content_fit(Gtk.ContentFit.CONTAIN); box.append(logo)
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        copy.append(label("SHEALTH", "title", False))
        copy.append(label("Read-only host, service, network, and energy health", "subtitle"))
        box.append(copy)
        spacer = Gtk.Box(); spacer.set_hexpand(True); box.append(spacer)
        self.heartbeat = label("Collecting...", "live", False); self.heartbeat.set_xalign(1)
        box.append(self.heartbeat)
        return box

    def sidebar(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        box.add_css_class("sidebar"); box.set_size_request(155, -1)
        for name in self.TABS:
            button = Gtk.Button(label=name); button.add_css_class("nav")
            button.connect("clicked", lambda _b, tab=name: self.show_tab(tab))
            box.append(button); self.nav[name] = button
        return box

    def clear(self, box: Gtk.Box) -> None:
        while child := box.get_first_child(): box.remove(child)

    def show_tab(self, name: str) -> None:
        self.stack.set_visible_child_name(name)
        for tab, button in self.nav.items():
            button.remove_css_class("nav-active")
            if tab == name: button.add_css_class("nav-active")
        self.refresh_page(name)

    def sample_timer(self) -> bool:
        self.collect_now(); return True

    def collect_now(self) -> None:
        self.sample = self.collector.collect()
        self.store.add_sample(self.sample, self.settings)
        stamp = dt.datetime.fromtimestamp(int(self.sample["ts"])).strftime("%H:%M:%S")
        self.heartbeat.set_text(f"Heartbeat healthy · cached {stamp}")
        visible = self.stack.get_visible_child_name() if hasattr(self, "stack") else "Health"
        if visible: self.refresh_page(visible)

    def refresh_visible(self) -> bool:
        name = self.stack.get_visible_child_name()
        if name: self.refresh_page(name)
        return True

    def refresh_page(self, name: str) -> None:
        if not self.sample or name == "Settings": return
        builders = {
            "Health": self.build_health, "Disk": self.build_disk,
            "Memory": self.build_memory, "CPU": self.build_cpu,
            "Network": self.build_network, "Services": self.build_services,
            "Uptime": self.build_uptime, "Energy": self.build_energy,
            "Events": self.build_events,
        }
        builders[name]()

    def heading(self, box: Gtk.Box, title: str, subtitle: str) -> None:
        box.append(label(title, "section-title", False)); box.append(label(subtitle, "muted"))

    def tile(self, title: str, value: str, status: str, tab: str) -> Gtk.Button:
        button = Gtk.Button(); button.add_css_class("tile")
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_widget = label(title, "tile-title", False)
        value_widget = label(value, f"tile-value {status}", False)
        title_widget.set_selectable(False); value_widget.set_selectable(False)
        content.append(title_widget); content.append(value_widget)
        button.set_child(content); button.connect("clicked", lambda *_: self.show_tab(tab))
        button.set_tooltip_text(f"Open {tab}")
        return button

    def chart(
        self,
        points: list[tuple[int, float]],
        title: str,
        unit: str,
        minimum: float,
        maximum: float,
        status_for: object,
    ) -> Gtk.Widget:
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        panel.add_css_class("panel"); panel.set_hexpand(True)
        panel.append(label(title, "section-title", False))
        graph = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7); graph.add_css_class("chart")
        graph.set_size_request(-1, 175)
        axis = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        axis.append(label(f"{maximum:.0f}{unit}", "muted", False))
        axis_spacer = Gtk.Box(); axis_spacer.set_vexpand(True); axis.append(axis_spacer)
        axis.append(label(f"{minimum:.0f}{unit}", "muted", False)); graph.append(axis)
        bars = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bars.set_hexpand(True); bars.set_halign(Gtk.Align.FILL); bars.set_valign(Gtk.Align.FILL)
        if not points:
            empty = label("No cached data yet", "muted", False); empty.set_hexpand(True)
            empty.set_halign(Gtk.Align.CENTER); empty.set_valign(Gtk.Align.CENTER); bars.append(empty)
        for stamp, value in points[-24:]:
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            column.set_hexpand(True); column.set_valign(Gtk.Align.FILL)
            spacer = Gtk.Box(); spacer.set_vexpand(True); column.append(spacer)
            bounded = min(maximum, max(minimum, value))
            height = max(3, round(135 * (bounded - minimum) / max(0.001, maximum - minimum)))
            bar = Gtk.Box(); bar.add_css_class("chart-bar"); bar.add_css_class(f"bar-{status_for(value)}")
            bar.set_size_request(-1, height)
            bar.set_tooltip_text(f"{dt.datetime.fromtimestamp(stamp).strftime('%Y-%m-%d %H:%M')} · {value:.2f}{unit}")
            column.append(bar); bars.append(column)
        graph.append(bars); panel.append(graph)
        if points:
            times = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            start = label(dt.datetime.fromtimestamp(points[-24:][0][0]).strftime("%H:%M"), "muted", False)
            end = label(dt.datetime.fromtimestamp(points[-1][0]).strftime("%H:%M"), "muted", False)
            spacer = Gtk.Box(); spacer.set_hexpand(True)
            times.append(start); times.append(spacer); times.append(end); panel.append(times)
        return panel

    @staticmethod
    def heartbeat_status(value: float) -> str:
        if value > 95:
            return "healthy"
        if value >= 80:
            return "warning"
        return "critical"

    def heartbeat_points(self) -> list[tuple[int, float]]:
        points = []
        for row in self.store.hourly_last(24):
            checks = int(row["checks"] or 0)
            score = 100.0 * (1.0 - int(row["negative"] or 0) / checks) if checks else 100.0
            points.append((int(row["hour"]), max(0.0, min(100.0, score))))
        return points

    def metric_status(self, key: str) -> str:
        value = float(self.sample[key])
        return self.threshold_status(key, value)

    def threshold_status(self, key: str, value: float) -> str:
        critical = float(self.settings[f"{key}_critical"])
        warning = float(self.settings[f"{key}_warning"])
        return "critical" if value >= critical else "warning" if value >= warning else "healthy"

