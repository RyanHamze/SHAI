        box.append(save); self.settings_status = label("", "live"); box.append(self.settings_status)
        notices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5); notices.add_css_class("panel")
        notices.append(label("About and notices", "section-title", False))
        notices.append(label(
            "SHAI's read-only container observation policy is based on Tecnativa Docker Socket Proxy, "
            "used under the Apache License 2.0 and modified in the RyanHamze fork.",
            "muted",
        ))
        notices.append(Gtk.LinkButton.new_with_label(
            "https://github.com/Tecnativa/docker-socket-proxy", "Original project and contributors"
        ))
        notices.append(Gtk.LinkButton.new_with_label(
            "https://github.com/RyanHamze/docker-socket-proxy", "SHAI-maintained fork and changes"
        ))
        box.append(notices)

    def save_settings_clicked(self, _button: Gtk.Button) -> None:
        for key, widget in self.setting_widgets.items():
            if isinstance(widget, Gtk.SpinButton):
                value = widget.get_value(); self.settings[key] = int(value) if key not in {"price_kwh", "idle_watts", "max_watts"} else value
            elif isinstance(widget, Gtk.CheckButton): self.settings[key] = widget.get_active()
            elif isinstance(widget, Gtk.Entry): self.settings[key] = widget.get_text().strip()
        save_settings(self.settings); self.collector.settings = self.settings
        self.settings_status.set_text("Saved locally. New intervals take full effect after reopening SHEALTH.")


class HealthApplication(Gtk.Application):
    def __init__(self) -> None: super().__init__(application_id=APP_ID)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider(); provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self) -> None:
        if os.geteuid() == 0: raise SystemExit("Run SHEALTH as the normal desktop user, without sudo.")
        window = self.props.active_window or HealthWindow(self); window.present()


if __name__ == "__main__":
    raise SystemExit(HealthApplication().run(sys.argv))
