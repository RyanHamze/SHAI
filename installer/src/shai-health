    def build_uptime(self) -> None:
        box = self.pages["Uptime"]; self.clear(box)
        self.heading(box, "Uptime", "Host uptime and start state for monitored host services.")
        boot = dt.datetime.now() - dt.timedelta(seconds=float(self.sample["uptime"]))
        box.append(label(f"OS uptime: {duration(float(self.sample['uptime']))}\nLast boot: {boot.astimezone().strftime('%Y-%m-%d %H:%M:%S %Z')}", "panel"))
        for service, display_name in (("NetworkManager", "Network Manager"), ("sshd", "Secure Shell"), ("docker", "Container engine")):
            rc, output, _ = run(["systemctl", "show", service, "--property=ActiveState,ActiveEnterTimestamp,SubState", "--no-pager"])
            values = {}
            if rc == 0:
                for line_text in output.splitlines():
                    if "=" in line_text:
                        key, value = line_text.split("=", 1); values[key] = value
            active = values.get("ActiveState", "offline" if rc else "unknown")
            substate = values.get("SubState", "dead" if rc else "unknown")
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12); row.add_css_class("row")
            name = label(display_name, "section-title", False); name.set_size_request(180, -1); row.append(name)
            active_label = label(active, "healthy" if active == "active" else "critical", False)
            active_label.set_size_request(80, -1); row.append(active_label)
            substate_label = label(substate, "healthy" if substate == "running" else "critical", False)
            substate_label.set_size_request(80, -1); row.append(substate_label)
            timestamp = values.get("ActiveEnterTimestamp", "not installed or inaccessible")
            detail = label(timestamp, "muted", False); detail.set_hexpand(True); row.append(detail)
            box.append(row)

