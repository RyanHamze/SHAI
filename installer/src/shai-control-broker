#!/usr/bin/env python3
"""SHAI's local capability broker.

This process is deliberately not an LLM gateway.  It exposes a small local API
for sanitized inspection and user-approved, allowlisted actions.  It never
returns secret material to callers.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import secrets
import socket
import subprocess
import threading
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


ETC = Path("/etc/shai")
SECRETS = ETC / "secrets"
VAULT = SECRETS / "aia"
STATE = Path("/var/lib/shai/control")
PROPOSALS = STATE / "proposals.json"
AUDIT = Path("/var/log/shai/control")
WEBUI_TOKEN = SECRETS / "control-webui-token"
APPROVAL_TOKEN = SECRETS / "control-approval-token"
REQUEST_LOCK = threading.RLock()
REGISTRY = ETC / "service-registry.json"
HOST = "127.0.0.1"
PORT = 11500
MAX_PROPOSALS = 100

SAFE_ACTIONS = {
    "home-assistant.call-service",
    "systemd.restart",
    "docker.stack.apply",
}
SAFE_SYSTEMD_UNITS = {
    "shai-aia-model.service",
    "shai-network-snapshot.service",
    "docker.service",
}
SAFE_STACK_SERVICES = {"mosquitto", "home-assistant", "zigbee2mqtt", "open-webui"}
HIGH_IMPACT_DOMAINS = {"lock", "alarm_control_panel", "cover", "valve", "climate", "garage_door"}


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def ensure_paths() -> None:
    for path in (ETC, SECRETS, VAULT, STATE, AUDIT):
        path.mkdir(parents=True, exist_ok=True)
    SECRETS.chmod(0o700); VAULT.chmod(0o700); STATE.chmod(0o750); AUDIT.chmod(0o750)
    if not WEBUI_TOKEN.exists():
        WEBUI_TOKEN.write_text(secrets.token_urlsafe(48) + "\n", encoding="utf-8")
        WEBUI_TOKEN.chmod(0o600)
    if not APPROVAL_TOKEN.exists():
        APPROVAL_TOKEN.write_text(secrets.token_urlsafe(48) + "\n", encoding="utf-8")
        APPROVAL_TOKEN.chmod(0o600)


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path: Path, value: Any, mode: int = 0o640) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.chmod(mode)
    temporary.replace(path)


def audit(event: str, detail: str) -> None:
    path = AUDIT / f"{dt.date.today().isoformat()}.log"
    with path.open("a", encoding="utf-8") as stream:
        stream.write(f"{now()}\t{event}\t{detail.replace(chr(9), ' ').replace(chr(10), ' ')}\n")
    path.chmod(0o640)


def token(path: Path) -> str:
    return path.read_text(encoding="utf-8").strip()


def authorized(headers: Any, required: Path) -> bool:
    supplied = str(headers.get("Authorization", ""))
    return supplied == f"Bearer {token(required)}"


def secret_path(user: str, integration: str) -> Path:
    if not user.replace("-", "").replace("_", "").isalnum() or not integration.replace("-", "").isalnum():
        raise ValueError("invalid secret reference")
    return VAULT / user / f"{integration}.json"


def integration_config(user: str, integration: str) -> dict[str, Any]:
    config = read_json(Path("/home") / user / ".config/shai/aia.json", {})
    values = config.get("integrations", {}).get(integration, {}) if isinstance(config, dict) else {}
    return values if isinstance(values, dict) else {}


def integration_secret(user: str, integration: str) -> dict[str, str]:
    payload = read_json(secret_path(user, integration), {})
    values = payload.get("values", {}) if isinstance(payload, dict) else {}
    return {str(k): str(v) for k, v in values.items()} if isinstance(values, dict) else {}


def test_integration(user: str, integration: str) -> tuple[bool, str]:
    config = integration_config(user, integration)
    if integration != "home-assistant":
        return False, "Broker test is currently available only for Home Assistant"
    url = str(config.get("url", "")).rstrip("/")
    access_token = integration_secret(user, integration).get("token", "")
    if not url or not access_token:
        return False, "Home Assistant is missing a URL or vault-backed token"
    request = urllib.request.Request(f"{url}/api/", headers={"Authorization": f"Bearer {access_token}"})
    try:
        with urllib.request.urlopen(request, timeout=8) as response:
            return response.status == 200, f"Home Assistant API responded with HTTP {response.status}"
    except urllib.error.URLError as exc:
        return False, f"Connection test failed: {exc.reason}"


def sanitized_inventory(user: str) -> dict[str, Any]:
    config = read_json(Path("/home") / user / ".config/shai/aia.json", {})
    integrations = config.get("integrations", {}) if isinstance(config, dict) else {}
    output: dict[str, Any] = {}
    if isinstance(integrations, dict):
        for integration, values in integrations.items():
            if not isinstance(values, dict):
                continue
            output[str(integration)] = {
                key: value for key, value in values.items()
                if key not in {"token", "password", "api_key", "secret"}
            }
            output[str(integration)]["secrets_available"] = secret_path(user, str(integration)).is_file()
    registry = read_json(REGISTRY, {"services": []})
    return {
        "schema": 1,
        "generated_at": now(),
        "user": user,
        "active_model": str(config.get("active_model", "")) if isinstance(config, dict) else "",
        "integrations": output,
        "services": registry.get("services", []) if isinstance(registry, dict) else [],
        "broker": {"mode": "proposal-only", "actions": sorted(SAFE_ACTIONS)},
    }


def openapi_spec() -> dict[str, Any]:
    """Narrow OpenAPI surface intended for Open WebUI's external-tool connector."""
    return {
        "openapi": "3.0.3",
        "info": {"title": "SHAI Local Control", "version": "1", "description": "Read local SHAI state and create proposals. All proposals require Control Center approval."},
        "servers": [{"url": "http://127.0.0.1:11500/v1"}],
        "components": {"securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer"}},
                       "schemas": {"Proposal": {"type": "object", "required": ["action", "arguments", "reason"], "properties": {
                           "action": {"type": "string", "enum": sorted(SAFE_ACTIONS)}, "arguments": {"type": "object"}, "reason": {"type": "string"}}}}},
        "paths": {
            "/inventory": {"get": {"operationId": "getShaiInventory", "summary": "Get sanitized SHAI inventory; never includes passwords or tokens.", "responses": {"200": {"description": "Inventory"}}}},
            "/proposals": {"post": {"operationId": "createShaiProposal", "summary": "Create a SHAI action proposal. It cannot execute until approved in SHAI Control Center.", "security": [{"BearerAuth": []}], "requestBody": {"required": True, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Proposal"}}}}, "responses": {"201": {"description": "Pending proposal"}}}},
        },
    }


def load_proposals() -> list[dict[str, Any]]:
    value = read_json(PROPOSALS, [])
    return value if isinstance(value, list) else []


def save_proposals(items: list[dict[str, Any]]) -> None:
    write_json(PROPOSALS, items[-MAX_PROPOSALS:])


def validate_proposal(payload: dict[str, Any]) -> tuple[bool, str]:
    action = str(payload.get("action", ""))
    arguments = payload.get("arguments", {})
    if action not in SAFE_ACTIONS or not isinstance(arguments, dict):
        return False, "unsupported action or invalid arguments"
    if action == "systemd.restart" and str(arguments.get("unit", "")) not in SAFE_SYSTEMD_UNITS:
        return False, "that systemd unit is not in SHAI's approved restart allowlist"
    if action == "docker.stack.apply":
        selected = arguments.get("services", [])
        if not isinstance(selected, list) or not {str(x) for x in selected} <= SAFE_STACK_SERVICES:
            return False, "the Docker stack request includes an unsupported service"
    if action == "home-assistant.call-service":
        domain = str(arguments.get("domain", "")); service = str(arguments.get("service", ""))
        if not domain or not service or not domain.replace("_", "").isalnum() or not service.replace("_", "").isalnum():
            return False, "Home Assistant domain and service must be simple names"
    return True, ""


def execute(proposal: dict[str, Any]) -> tuple[bool, str]:
    action = str(proposal["action"]); args = proposal["arguments"]; user = str(proposal["user"])
    if action == "systemd.restart":
        unit = str(args["unit"])
        if unit == "shai-aia-model.service":
            result = subprocess.run(
                ["systemctl", "--user", f"--machine={user}@.host", "restart", unit],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            )
        else:
            result = subprocess.run(["systemctl", "restart", unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return result.returncode == 0, result.stdout.strip() or ("restarted" if result.returncode == 0 else "restart failed")
    if action == "docker.stack.apply":
        services = ",".join(sorted({str(x) for x in args["services"]}))
        result = subprocess.run(["/usr/lib/shai-installer/shai-stack-apply", "--install", services], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return result.returncode == 0, result.stdout[-1200:].strip()
    if action == "home-assistant.call-service":
        config = integration_config(user, "home-assistant"); private = integration_secret(user, "home-assistant")
        url = str(config.get("url", "")).rstrip("/")
        access_token = private.get("token", "")
        if not url or not access_token:
            return False, "Home Assistant is not configured with a vault-backed token"
        body = json.dumps(args.get("data", {})).encode("utf-8")
        request = urllib.request.Request(
            f"{url}/api/services/{args['domain']}/{args['service']}", data=body,
            headers={"Authorization": f"Bearer {access_token}", "Content-Type": "application/json"}, method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=12) as response:
                return 200 <= response.status < 300, f"Home Assistant returned HTTP {response.status}"
        except urllib.error.URLError as exc:
            return False, f"Home Assistant call failed: {exc.reason}"
    return False, "unsupported action"


class Handler(BaseHTTPRequestHandler):
    server_version = "SHAIControlBroker/1"

    def log_message(self, _format: str, *_args: object) -> None:
        return

    def reply(self, status: int, value: Any) -> None:
        payload = json.dumps(value, sort_keys=True).encode("utf-8")
        self.send_response(status); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload))); self.end_headers(); self.wfile.write(payload)

    def body(self) -> dict[str, Any]:
        size = int(self.headers.get("Content-Length", "0"))
        if size > 65536:
            raise ValueError("request body is too large")
        value = json.loads(self.rfile.read(size).decode("utf-8"))
        if not isinstance(value, dict):
            raise ValueError("request must be an object")
        return value

    def user(self) -> str:
        value = self.headers.get("X-SHAI-User", "shai")
        if not value.replace("-", "").replace("_", "").isalnum():
            raise ValueError("invalid user")
        return value

    def do_GET(self) -> None:
        try:
            if self.path == "/v1/health":
                return self.reply(200, {"status": "ready", "mode": "proposal-only"})
            if self.path == "/openapi.json":
                return self.reply(200, openapi_spec())
            if self.path == "/v1/inventory":
                return self.reply(200, sanitized_inventory(self.user()))
            if self.path == "/v1/proposals":
                return self.reply(200, {"proposals": load_proposals()})
            if self.path.startswith("/v1/integrations/") and self.path.endswith("/test"):
                integration = self.path.split("/")[3]
                success, detail = test_integration(self.user(), integration)
                return self.reply(200, {"success": success, "detail": detail})
            return self.reply(404, {"error": "not found"})
        except Exception as exc:
            audit("request-error", str(exc)); self.reply(400, {"error": str(exc)})

    def do_POST(self) -> None:
        with REQUEST_LOCK:
            self.handle_post()

    def handle_post(self) -> None:
        try:
            payload = self.body(); user = self.user()
            if self.path == "/v1/proposals":
                if not authorized(self.headers, WEBUI_TOKEN):
                    return self.reply(401, {"error": "operator authorization required"})
                ok, error = validate_proposal(payload)
                if not ok:
                    audit("proposal-rejected", error); return self.reply(400, {"error": error})
                action = str(payload["action"]); arguments = payload["arguments"]
                proposal = {"id": secrets.token_urlsafe(12), "created_at": now(), "user": user, "action": action,
                            "arguments": arguments, "reason": str(payload.get("reason", "No reason supplied"))[:500],
                            "status": "pending", "source": "open-webui"}
                if action == "home-assistant.call-service" and str(arguments.get("domain", "")) in HIGH_IMPACT_DOMAINS:
                    proposal["risk"] = "high"
                else:
                    proposal["risk"] = "normal"
                entries = load_proposals(); entries.append(proposal); save_proposals(entries)
                audit("proposal-created", f"{proposal['id']} {action} {proposal['risk']}")
                return self.reply(201, proposal)
            if self.path.startswith("/v1/proposals/") and self.path.endswith("/approve"):
                if not authorized(self.headers, APPROVAL_TOKEN):
                    return self.reply(401, {"error": "root approval authorization required"})
                proposal_id = self.path.split("/")[3]; entries = load_proposals()
                proposal = next((item for item in entries if item.get("id") == proposal_id), None)
                if not proposal or proposal.get("status") != "pending":
                    return self.reply(404, {"error": "pending proposal not found"})
                success, result = execute(proposal)
                proposal["status"] = "completed" if success else "failed"; proposal["completed_at"] = now(); proposal["result"] = result
                save_proposals(entries); audit("proposal-executed", f"{proposal_id} {proposal['status']} {proposal['action']}")
                return self.reply(200 if success else 502, proposal)
            if self.path.startswith("/v1/proposals/") and self.path.endswith("/reject"):
                if not authorized(self.headers, APPROVAL_TOKEN):
                    return self.reply(401, {"error": "root approval authorization required"})
                proposal_id = self.path.split("/")[3]; entries = load_proposals()
                proposal = next((item for item in entries if item.get("id") == proposal_id), None)
                if not proposal or proposal.get("status") != "pending":
                    return self.reply(404, {"error": "pending proposal not found"})
                proposal["status"] = "rejected"; proposal["completed_at"] = now(); proposal["result"] = "Rejected by local user"
                save_proposals(entries); audit("proposal-rejected-by-user", proposal_id)
                return self.reply(200, proposal)
            return self.reply(404, {"error": "not found"})
        except Exception as exc:
            audit("request-error", str(exc)); self.reply(400, {"error": str(exc)})


def main() -> None:
    parser = argparse.ArgumentParser(); parser.add_argument("--listen", default=f"{HOST}:{PORT}"); args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit("SHAI Control Broker must run as root")
    ensure_paths()
    host, port = args.listen.rsplit(":", 1)
    if host != "127.0.0.1":
        raise SystemExit("SHAI Control Broker may only bind to 127.0.0.1")
    audit("broker-start", f"{host}:{port}")
    ThreadingHTTPServer((host, int(port)), Handler).serve_forever()


if __name__ == "__main__":
    main()
