headerbar label, headerbar .title, headerbar .subtitle { color: #DDFBE0; }
headerbar button, windowcontrols button { background: #1A2B1D; color: #DDFBE0; }
headerbar button:hover, windowcontrols button:hover { background: #304B35; color: #FFFFFF; }
headerbar:backdrop, headerbar:backdrop label { background: #111812; color: #A7B7AA; }
window { background: #0B0F0C; color: #DDFBE0; }
.header { background: #111812; border-bottom: 1px solid #263A2B; padding: 14px 20px; }
.content { padding: 24px; }
.title { color: #DDFBE0; font-size: 24px; font-weight: 700; }
.subtitle { color: #A7B7AA; }
.section { color: #8DF28D; font-size: 16px; font-weight: 700; margin-top: 8px; }
.panel { background: #111812; border: 1px solid #263A2B; border-radius: 6px; padding: 16px; }
.status { background: #111812; border: 1px solid #263A2B; border-radius: 5px; padding: 12px; }
button { background: #162019; color: #DDFBE0; border: 1px solid #354837; border-radius: 4px; padding: 9px 16px; }
