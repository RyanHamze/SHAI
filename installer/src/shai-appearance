def label(text: str, css: str | None = None) -> Gtk.Label:
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_wrap(True)
    if css:
        widget.add_css_class(css)
    return widget


def get_setting(schema: str, key: str) -> str:
    result = subprocess.run(
        ["gsettings", "get", schema, key],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.stdout.strip().strip("'")


def set_setting(schema: str, key: str, value: str | None) -> None:
    command = ["gsettings", "reset" if value is None else "set", schema, key]
    if value is not None:
        command.append(value)
    subprocess.run(command, check=True)


class AppearanceWindow(Gtk.ApplicationWindow):
    SCHEMES = ("System default", "Light", "Dark")
    WALLPAPERS = ("Profile default", "SHAI Grid", "Ubuntu default")
    ACCENTS = ("System default", "green", "blue", "teal", "yellow", "orange", "red", "pink", "purple", "slate")

    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="SHAI Appearance")
        titlebar = Gtk.HeaderBar()
        titlebar.add_css_class("titlebar")
        titlebar.set_title_widget(Gtk.Label(label="SHAI Appearance"))
        titlebar.set_show_title_buttons(True)
        self.set_titlebar(titlebar)
        self.set_default_size(760, 680)
        self.set_size_request(620, 560)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        root.append(self.header())

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.append(scroll)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.add_css_class("content")
        scroll.set_child(content)

        content.append(label("Appearance", "title"))
        content.append(label(
            "Choose the complete SHAI look or Ubuntu's desktop defaults. Changes happen only "
            "after you select Apply appearance.", "subtitle"
        ))

        profile_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        profile_panel.add_css_class("panel")
        profile_panel.append(label("Desktop profile", "section"))
        profile_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        profile_row.add_css_class("linked")
        self.ubuntu_profile = Gtk.ToggleButton(label="Ubuntu Default")
        self.shai_profile = Gtk.ToggleButton(label="SHAI")
        self.shai_profile.set_group(self.ubuntu_profile)
        self.ubuntu_profile.connect("toggled", self.profile_changed)
        self.shai_profile.connect("toggled", self.profile_changed)
        profile_row.append(self.ubuntu_profile)
        profile_row.append(self.shai_profile)
        profile_panel.append(profile_row)
        content.append(profile_panel)

        options = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        options.add_css_class("panel")
        options.append(label("Personalize", "section"))
        self.scheme = self.dropdown_row(options, "Mode", self.SCHEMES)
        self.accent_values = self.supported_accents()
        self.accent = self.dropdown_row(options, "Accent", self.accent_values)
        self.wallpaper = self.dropdown_row(options, "Wallpaper", self.WALLPAPERS)
        content.append(options)

        self.status = label("No changes pending.", "status")
        content.append(self.status)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        apply_button = Gtk.Button(label="Apply appearance")
        apply_button.add_css_class("suggested-action")
        apply_button.connect("clicked", self.apply)
        actions.append(apply_button)
        restore = Gtk.Button(label="Restore pre-SHAI appearance")
        restore.set_tooltip_text("Restore the appearance saved before SHAI first changed it")
        restore.connect("clicked", self.restore_previous)
        actions.append(restore)
        content.append(actions)

        content.append(label(
            "GNOME Shell panel and overview changes may require one logout and login. "
            "No internet connection or sudo access is used by this screen.", "subtitle"
        ))
        self.load_current()

    def header(self) -> Gtk.Widget:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        header.add_css_class("header")
        if BRAND.exists():
            picture = Gtk.Picture.new_for_filename(str(BRAND))
            picture.set_content_fit(Gtk.ContentFit.CONTAIN)
            picture.set_size_request(300, 52)
            header.append(picture)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)
        sponsor = Gtk.LinkButton.new_with_label(
            "https://aabeyllc.com", "Brought to you by Aabey LLC"
        )
        sponsor.add_css_class("sponsor-link")
        header.append(sponsor)
        return header

    @staticmethod
    def dropdown_row(parent: Gtk.Box, name: str, values: tuple[str, ...]) -> Gtk.DropDown:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.append(label(name))
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        row.append(spacer)
        dropdown = Gtk.DropDown.new_from_strings(list(values))
        dropdown.set_size_request(220, -1)
        row.append(dropdown)
        parent.append(row)
        return dropdown

    def supported_accents(self) -> tuple[str, ...]:
        result = subprocess.run(
            ["gsettings", "range", "org.gnome.desktop.interface", "accent-color"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        supported = tuple(value for value in self.ACCENTS[1:] if value in result.stdout)
        return (self.ACCENTS[0],) + (supported or ("green",))

    @staticmethod
    def select(dropdown: Gtk.DropDown, values: tuple[str, ...], value: str) -> None:
        try:
            dropdown.set_selected(values.index(value))
        except ValueError:
            dropdown.set_selected(0)

    def selected(self, dropdown: Gtk.DropDown, values: tuple[str, ...]) -> str:
        return values[dropdown.get_selected()]

    def load_current(self) -> None:
        icon_theme = get_setting("org.gnome.desktop.interface", "icon-theme")
        self.shai_profile.set_active(icon_theme == "SHAI")
        self.ubuntu_profile.set_active(icon_theme != "SHAI")

        scheme = get_setting("org.gnome.desktop.interface", "color-scheme")
        self.select(self.scheme, self.SCHEMES, "Dark" if scheme == "prefer-dark" else "Light")

        accent = get_setting("org.gnome.desktop.interface", "accent-color")
        self.select(self.accent, self.accent_values, accent)

        picture = get_setting("org.gnome.desktop.background", "picture-uri")
        wallpaper = "SHAI Grid" if str(SHAI_WALLPAPER) in picture else "Profile default"
        self.select(self.wallpaper, self.WALLPAPERS, wallpaper)

    def profile_changed(self, button: Gtk.ToggleButton) -> None:
        if not button.get_active() or not hasattr(self, "wallpaper"):
            return
        if button is self.shai_profile:
            self.select(self.scheme, self.SCHEMES, "Dark")
            self.select(self.accent, self.accent_values, "green")
            self.select(self.wallpaper, self.WALLPAPERS, "SHAI Grid")
        else:
            self.select(self.scheme, self.SCHEMES, "System default")
            self.select(self.accent, self.accent_values, "System default")
            self.select(self.wallpaper, self.WALLPAPERS, "Profile default")

    def run_helper(self, executable: str) -> str:
        path = shutil.which(executable)
        if not path:
            raise RuntimeError(f"Missing helper: {executable}")
        result = subprocess.run(
            [path], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
        )
        if result.returncode:
            raise RuntimeError(result.stdout.strip() or f"{executable} failed")
        return result.stdout.strip()

    def apply(self, _button: Gtk.Button) -> None:
        try:
            helper = "shai-theme-apply" if self.shai_profile.get_active() else "shai-theme-default"
            message = self.run_helper(helper)

            scheme = self.selected(self.scheme, self.SCHEMES)
            if scheme == "System default":
                set_setting("org.gnome.desktop.interface", "color-scheme", None)
            else:
                set_setting(
                    "org.gnome.desktop.interface", "color-scheme",
                    "prefer-dark" if scheme == "Dark" else "default",
                )

            accent = self.selected(self.accent, self.accent_values)
            set_setting(
                "org.gnome.desktop.interface", "accent-color",
                None if accent == "System default" else accent,
            )

            wallpaper = self.selected(self.wallpaper, self.WALLPAPERS)
            if wallpaper == "SHAI Grid":
                uri = f"file://{SHAI_WALLPAPER}"
                set_setting("org.gnome.desktop.background", "picture-uri", uri)
                set_setting("org.gnome.desktop.background", "picture-uri-dark", uri)
            elif wallpaper == "Ubuntu default":
                set_setting("org.gnome.desktop.background", "picture-uri", None)
                set_setting("org.gnome.desktop.background", "picture-uri-dark", None)

            self.write_status()
            self.status.set_text(message or "Appearance applied.")
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            self.status.set_text(f"Appearance was not changed completely: {error}")

    def restore_previous(self, _button: Gtk.Button) -> None:
        try:
            self.status.set_text(self.run_helper("shai-theme-reset"))
            self.load_current()
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            self.status.set_text(f"Could not restore the saved appearance: {error}")

    def write_status(self) -> None:
        STATUS.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        payload = {
            "schema": 1,
            "applied_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "theme": "SHAI" if self.shai_profile.get_active() else "Ubuntu default",
            "color_scheme": get_setting("org.gnome.desktop.interface", "color-scheme"),
            "accent": get_setting("org.gnome.desktop.interface", "accent-color"),
            "icons": get_setting("org.gnome.desktop.interface", "icon-theme"),
            "wallpaper": get_setting("org.gnome.desktop.background", "picture-uri"),
            "shell": get_setting("org.gnome.shell.extensions.user-theme", "name"),
        }
        temporary = STATUS.with_suffix(".tmp")
        temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        temporary.chmod(0o600)
        temporary.replace(STATUS)


class AppearanceApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def do_activate(self) -> None:
        AppearanceWindow(self).present()


if __name__ == "__main__":
    raise SystemExit(AppearanceApplication().run())
