@dataclass
class InstalledApp:
    source: str
    package: str
    name: str
    description: str
    disk_mb: int
    ram_mb: int
    protected: bool


def text_label(value: str, css: str | None = None, wrap: bool = True) -> Gtk.Label:
    widget = Gtk.Label(label=value, xalign=0)
    widget.set_wrap(wrap)
    widget.set_selectable(False)
    if css:
        widget.add_css_class(css)
    return widget


def cart_label(value: str, css: str | None = None) -> Gtk.Label:
    widget = text_label(value, css)
    widget.set_max_width_chars(CART_TEXT_CHARS)
    return widget


def command(args: list[str]) -> str:
    result = subprocess.run(
        args, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    return result.stdout.strip()


def daily_log_path() -> Path:
    return LOG_DIR / f"{dt.date.today().isoformat()}.log"


def load_architecture() -> tuple[str, str]:
    for path, source in ((SHAPP_CONFIG, "SHAPP"), (SETUP_CHOICES, "SHAI Setup")):
        try:
            value = json.loads(path.read_text(encoding="utf-8")).get("architecture")
        except (OSError, json.JSONDecodeError, AttributeError):
            continue
        if value in {"direct-host", "managed-stack"}:
            return value, source
    return "direct-host", "SHAI default"


def installed_containers() -> set[str]:
    try:
        data = json.loads(STACK_STATE.read_text(encoding="utf-8"))
        return {str(item) for item in data.get("services", [])}
    except (OSError, json.JSONDecodeError, AttributeError):
        return set()


def save_architecture(value: str) -> None:
    if value not in {"direct-host", "managed-stack"}:
        raise ValueError("unsupported architecture")
    SHAPP_CONFIG.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = SHAPP_CONFIG.with_suffix(".tmp")
    temporary.write_text(
        json.dumps({"schema": 1, "architecture": value}, indent=2) + "\n",
        encoding="utf-8",
    )
    temporary.chmod(0o600)
    temporary.replace(SHAPP_CONFIG)


def append_log(action: str, source: str, item: str, detail: str) -> None:
    LOG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    fields = [action, source, item, detail]
    cleaned = [str(field).replace("\t", " ").replace("\n", " ") for field in fields]
    timestamp = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    with daily_log_path().open("a", encoding="utf-8") as stream:
        stream.write("\t".join([timestamp, *cleaned]) + "\n")
    daily_log_path().chmod(0o600)


def installed_apt_packages() -> set[str]:
    output = command(["dpkg-query", "-W", "-f=${binary:Package}\t${db:Status-Abbrev}\n"])
    return {
        line.split("\t", 1)[0].split(":", 1)[0]
        for line in output.splitlines()
        if "\tii" in line
    }


def installed_snaps() -> set[str]:
    output = command(["snap", "list"])
    return {line.split()[0] for line in output.splitlines()[1:] if line.split()}


def protected_patterns() -> list[re.Pattern[str]]:
    try:
        lines = PROTECTED.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    return [re.compile(line) for line in lines if line and not line.startswith("#")]


def desktop_value(parser: configparser.ConfigParser, key: str, fallback: str = "") -> str:
    section = parser["Desktop Entry"]
    locale = os.environ.get("LANG", "").split(".", 1)[0]
    for candidate in (f"{key}[{locale}]", f"{key}[{locale.split('_', 1)[0]}]", key):
        if candidate in section:
            return section.get(candidate, fallback)
    return fallback


def apt_package_for(desktop: Path) -> str | None:
    output = command(["dpkg-query", "-S", str(desktop)])
    for line in output.splitlines():
        if ": " in line:
            return line.split(": ", 1)[0].split(":", 1)[0]
    return None


def apt_size(package: str) -> int:
    output = command(["dpkg-query", "-W", "-f=${Installed-Size}", package])
    try:
        return max(1, round(int(output) / 1024))
    except ValueError:
        return 0


def apt_description(package: str, fallback: str) -> str:
    description = command(["dpkg-query", "-W", "-f=${Description}", package])
    if not description:
        return fallback
    normalized = " ".join(
        line.strip() for line in description.splitlines() if line.strip() and line.strip() != "."
    )
    if len(normalized) <= len(fallback):
        return fallback
    return normalized if len(normalized) <= 420 else normalized[:417].rstrip() + "..."


def fallback_ram_estimate(disk_mb: int, source: str) -> int:
    """Return a conservative planning estimate, not measured current usage."""
    if disk_mb <= 5:
        estimate = 32
    elif disk_mb <= 50:
        estimate = 64
    elif disk_mb <= 200:
        estimate = 128
    else:
        estimate = 256
    return max(128, estimate) if source == "snap" else estimate


def discover_apps(
    patterns: list[re.Pattern[str]], catalog: list[dict[str, object]]
) -> list[InstalledApp]:
    protected_snaps = {"firefox", "snap-store", "firmware-updater", "desktop-security-center"}
    catalog_ram = {
        str(package): max(1, int(item["ram_mb"]) // len(item["packages"]))
        for item in catalog
        for package in item["packages"]
    }
    discovered: dict[tuple[str, str], InstalledApp] = {}
    locations = (
        ("apt", Path("/usr/share/applications")),
        ("apt", Path("/usr/local/share/applications")),
        ("snap", Path("/var/lib/snapd/desktop/applications")),
        ("local", Path.home() / ".local/share/applications"),
    )
    snaps = installed_snaps()
    for source, directory in locations:
        if not directory.is_dir():
            continue
        for desktop in sorted(directory.glob("*.desktop")):
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read(desktop, encoding="utf-8")
                section = parser["Desktop Entry"]
            except (OSError, UnicodeError, KeyError, configparser.Error):
                continue
            if section.get("Type", "Application") != "Application":
                continue
            if section.getboolean("Hidden", fallback=False) or section.getboolean("NoDisplay", fallback=False):
                continue
            name = desktop_value(parser, "Name", desktop.stem)
            description = desktop_value(parser, "Comment", "Installed desktop application")
            if source == "apt":
                package = apt_package_for(desktop)
                if not package:
                    continue
                description = apt_description(package, description)
                protected = package == "shai-installer" or any(p.search(package) for p in patterns)
                size = apt_size(package)
            elif source == "snap":
                package = desktop.name.split("_", 1)[0]
                if package not in snaps:
                    continue
                protected = package in protected_snaps
                size = 0
            else:
                package = desktop.name
                protected = True
                size = 0
            ram = catalog_ram.get(package, fallback_ram_estimate(size, source))
            key = (source, package)
            if key not in discovered:
                discovered[key] = InstalledApp(
                    source, package, name, description, size, ram, protected
                )
    return sorted(discovered.values(), key=lambda app: app.name.casefold())


def log_discovered_apps(apps: list[InstalledApp], reason: str) -> None:
    append_log("DISCOVERY", "shapp", "installed-app-scan", f"{reason}; {len(apps)} apps")
    for app in apps:
        append_log(
            "DISCOVERED",
            app.source,
            app.package,
            f"{app.name}; disk={app.disk_mb}MB; estimated_ram={app.ram_mb}MB",
        )


def system_capacity_mb() -> tuple[int, int, int, int]:
    disk = shutil.disk_usage("/")
    values: dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            key, value = line.split(":", 1)
            values[key] = int(value.strip().split()[0]) // 1024
    except (OSError, ValueError, IndexError):
        values = {"MemTotal": 0, "MemAvailable": 0}
    disk_total = disk.total // (1024 * 1024)
    disk_used = disk.used // (1024 * 1024)
    ram_total = values.get("MemTotal", 0)
    ram_used = max(0, ram_total - values.get("MemAvailable", 0))
    return disk_used, disk_total, ram_used, ram_total


def resource_text(name: str, used_mb: int, total_mb: int) -> str:
    percent = round((used_mb / total_mb) * 100) if total_mb else 0
    return f"{name} {used_mb / 1024:.1f}/{total_mb / 1024:.1f} GB used ({percent}%)"


class ShappWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="SHAPP - SHAI App Manager")
        titlebar = Gtk.HeaderBar()
        titlebar.add_css_class("titlebar")
        titlebar.set_title_widget(Gtk.Label(label="SHAPP - SHAI App Manager"))
        titlebar.set_show_title_buttons(True)
        self.set_titlebar(titlebar)
        self.set_default_size(1180, 760)
        self.set_size_request(900, 620)
        self.catalog = json.loads(CATALOG.read_text(encoding="utf-8"))["apps"]
        self.architecture_mode, self.architecture_source = load_architecture()
        self.architecture_refreshing = False
        self.patterns = protected_patterns()
        self.apt_installed = installed_apt_packages()
        self.snap_installed = installed_snaps()
        self.container_installed = installed_containers()
        self.managed_installed = {path.stem for path in (Path('/var/lib/shai/apps') / os.environ.get('USER', '')).glob('*.json')}
        self.installed_apps = discover_apps(self.patterns, self.catalog)
        for item in self.catalog:
            service = item.get("container_service")
            if service in self.container_installed:
                display_name = str(item['name']) + (' (runtime staged; not activated)' if service == 'matter-server' else '')
                self.installed_apps.append(InstalledApp(
                    "container", str(service), display_name,
                    str(item["description"]), int(item["disk_mb"]),
                    int(item["ram_mb"]), False,
                ))
        self.installed_apps.sort(key=lambda app: app.name.casefold())
        for item in self.catalog:
            if item['id'] in self.managed_installed:
                self.installed_apps.append(InstalledApp('managed', item['id'], item['name'], item['description'], int(item['disk_mb']), int(item['ram_mb']), False))
        log_discovered_apps(self.installed_apps, "SHAPP opened")
        self.baseline: dict[str, bool] = {}
        self.desired: dict[str, bool] = {}
        self.app_checks: list[tuple[Gtk.CheckButton, list[str]]] = []
        self.catalog_controls: list[
            tuple[dict[str, object], Gtk.Widget, Gtk.CheckButton, Gtk.Label]
        ] = []
        self.installed_checks: list[tuple[Gtk.CheckButton, str]] = []
        self.refreshing = False
        self.plan_id = ""
        self.applying = False
        self.completion_path: Path | None = None
        self.active_tab = "recommended"

        for package in self.apt_installed:
            self.baseline[f"apt:{package}"] = True
            self.desired[f"apt:{package}"] = True
        for app_id in self.managed_installed:
            self.baseline[f'managed:{app_id}'] = True
            self.desired[f'managed:{app_id}'] = True
        for package in self.snap_installed:
            self.baseline[f"snap:{package}"] = True
            self.desired[f"snap:{package}"] = True
        for service in self.container_installed:
            self.baseline[f"container:{service}"] = True
            self.desired[f"container:{service}"] = True
        for item in self.catalog:
            for package in item["packages"]:
                key = f"apt:{package}"
                installed = package in self.apt_installed
                self.baseline.setdefault(key, installed)
                self.desired.setdefault(key, installed)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        root.append(self.build_header())
        root.append(self.build_tabs())

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        body.add_css_class("content")
        body.set_vexpand(True)
        root.append(body)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        left.set_hexpand(True)
        left.add_css_class("list-panel")
        body.append(left)
        self.search = Gtk.SearchEntry(placeholder_text="Search installed applications")
        self.search.connect("search-changed", lambda *_: self.rebuild_installed())
        self.search.set_visible(False)
        left.append(self.search)
        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        left.append(self.stack)
        self.stack.add_named(self.build_catalog_view("recommended"), "recommended")
        self.stack.add_named(self.build_catalog_view("optional"), "optional")
        self.installed_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        installed_scroll = Gtk.ScrolledWindow()
        installed_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        installed_scroll.set_child(self.installed_box)
        self.stack.add_named(installed_scroll, "installed")
        self.rebuild_installed()
        self.stack.add_named(self.build_architecture_view(), "architecture")

        self.cart = self.build_cart()
        self.cart.set_size_request(CART_WIDTH, -1)
        self.cart.set_hexpand(False)
        self.cart.set_halign(Gtk.Align.END)
        body.append(self.cart)
        self.show_tab("recommended")
        self.refresh_cart()
        GLib.timeout_add_seconds(5, self.refresh_resource_state)

