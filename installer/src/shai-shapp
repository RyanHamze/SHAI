    def sync_checks(self) -> None:
        self.refreshing = True
        for check, packages in self.app_checks:
            check.set_active(all(self.desired.get(package, False) for package in packages))
        for check, key in self.installed_checks:
            check.set_active(self.desired.get(key, True))
        self.refreshing = False

    def changes(self) -> tuple[list[dict[str, object]], list[InstalledApp]]:
        installs = []
        for item in self.catalog:
            keys = self.item_keys(item)
            if not self.backend_available(item) or not keys:
                continue
            if all(self.desired.get(key, False) for key in keys) and any(
                not self.baseline.get(key, False) for key in keys
            ):
                installs.append(item)
        removals = [
            app for app in self.installed_apps
            if self.baseline.get(f"{app.source}:{app.package}", False)
            and not self.desired.get(f"{app.source}:{app.package}", True)
        ]
        removal_keys = {f"{app.source}:{app.package}" for app in removals}
        for item in self.catalog:
            keys = self.item_keys(item)
            for key in keys:
                source, package = key.split(":", 1)
                if self.baseline.get(key, False) and not self.desired.get(key, True) and key not in removal_keys:
                    removals.append(InstalledApp(
                        source,
                        package,
                        str(item["name"]),
                        str(item["description"]),
                        max(1, int(item["disk_mb"]) // len(keys)),
                        max(1, int(item["ram_mb"]) // len(keys)),
                        False,
                    ))
                    removal_keys.add(key)
        return installs, removals

    def change_totals(
        self,
        installs: list[dict[str, object]],
        removals: list[InstalledApp],
    ) -> tuple[int, int, dict[str, int]]:
        disk = sum(int(item["disk_mb"]) for item in installs)
        ram = sum(int(item["ram_mb"]) for item in installs)
        catalog_by_package = {}
        for item in self.catalog:
            for key in self.item_keys(item):
                catalog_by_package[key] = item
        counted_ram: set[str] = set()
        removal_ram: dict[str, int] = {}
        for app in removals:
            if app.source != 'container':
                disk -= app.disk_mb
            item = catalog_by_package.get(f"{app.source}:{app.package}")
            amount = app.ram_mb
            if item:
                if str(item["id"]) in counted_ram:
                    amount = 0
                else:
                    amount = int(item["ram_mb"])
                    counted_ram.add(str(item["id"]))
            ram -= amount
            removal_ram[f"{app.source}:{app.package}"] = amount
        return disk, ram, removal_ram

    def update_capacity_controls(
        self,
        disk_change: int,
        ram_change: int,
        capacity: tuple[int, int, int, int],
    ) -> bool:
        disk_used, disk_total, ram_used, ram_total = capacity
        final_disk = max(0, disk_used + disk_change)
        final_ram = max(0, ram_used + ram_change)
        stack_failures = self.stack_capacity_restrictions(ram_total)
        capacity_ok = final_disk <= disk_total and final_ram <= ram_total and not stack_failures

        self.header_disk.set_text(resource_text("Disk", disk_used, disk_total))
        self.header_ram.set_text(resource_text("RAM", ram_used, ram_total))
        self.disk_total.set_text(
            f"Disk {disk_change:+d} MB -> {final_disk / 1024:.1f}/{disk_total / 1024:.1f} GB"
        )
        self.ram_total.set_text(
            f"RAM {ram_change:+d} MB -> est. {final_ram / 1024:.1f}/{ram_total / 1024:.1f} GB"
        )
        for label, exceeded in (
            (self.disk_total, final_disk > disk_total or any('disk' in failure or '/var/lib' in failure for failure in stack_failures)),
            (self.ram_total, final_ram > ram_total or any('RAM' in failure for failure in stack_failures)),
        ):
            label.remove_css_class("danger")
            if exceeded:
                label.add_css_class("danger")

        for item, row, check, status in self.catalog_controls:
            packages = self.item_keys(item)
            backend_available = self.backend_available(item)
            status.remove_css_class("online")
            status.remove_css_class("locked")
            status.remove_css_class("restriction")
            if not backend_available:
                check.set_sensitive(False)
                row.add_css_class("unavailable")
                status.set_text(self.catalog_status(item, False))
                status.add_css_class("locked")
                continue

            baseline_installed = all(self.baseline.get(key, False) for key in packages)
            selected = all(self.desired.get(key, False) for key in packages)
            projected_disk = final_disk + (0 if selected else int(item["disk_mb"]))
            projected_ram = final_ram + (0 if selected else int(item["ram_mb"]))
            restrictions = self.stack_capacity_restrictions(ram_total, item)
            if projected_disk > disk_total:
                available_disk = max(0, disk_total - final_disk)
                restrictions.append(
                    f"needs {int(item['disk_mb'])} MB disk; {available_disk} MB available"
                )
            if projected_ram > ram_total:
                available_ram = max(0, ram_total - final_ram)
                restrictions.append(
                    f"needs about {int(item['ram_mb'])} MB RAM; {available_ram} MB available"
                )
            blocked = bool(restrictions) and not selected and not baseline_installed
            check.set_sensitive(not blocked)
            if restrictions and (blocked or selected):
                row.add_css_class("unavailable")
                status.set_text("Cannot fit: " + "; ".join(restrictions))
                status.add_css_class("restriction")
            else:
                row.remove_css_class("unavailable")
                status.set_text(str(item.get("status", "Available")))
                status.add_css_class("online")
        return capacity_ok

    def refresh_resource_state(self) -> bool:
        self.refresh_cart()
        return True

    def refresh_cart(self) -> None:
        while child := self.cart_items.get_first_child():
            self.cart_items.remove(child)
        installs, removals = self.changes()
        disk, ram, removal_ram = self.change_totals(installs, removals)
        for item in installs:
            self.cart_items.append(self.pending_row(
                f"INSTALL  {item['name']}\n+{item['disk_mb']} MB disk · +{item['ram_mb']} MB RAM",
                "install",
                self.remove_install_from_cart,
                item,
            ))
        for app in removals:
            ram_removed = removal_ram[f"{app.source}:{app.package}"]
            disk_detail = 'data/images preserved' if app.source == 'container' else f'-{app.disk_mb} MB disk'
            self.cart_items.append(self.pending_row(
                f"UNINSTALL  {app.name}\n{disk_detail} · "
                f"-{ram_removed} MB RAM",
                "remove",
                self.remove_uninstall_from_cart,
                app,
            ))
        count = len(installs) + len(removals)
        if count == 0:
            self.cart_items.append(cart_label("Your software selection matches the current system.", "muted"))
        capacity_ok = self.update_capacity_controls(disk, ram, system_capacity_mb())
        self.cart_title.set_text(f"{count} pending change{'s' if count != 1 else ''}")
        self.cart_title.remove_css_class("danger")
        if not capacity_ok:
            self.cart_title.add_css_class("danger")
            self.cart_title.set_tooltip_text("Capacity exceeded; remove a selection")
        else:
            self.cart_title.set_tooltip_text(None)
        self.apply_button.set_sensitive(count > 0 and capacity_ok and not self.applying)

    def open_ubuntu_store(self, _button: Gtk.Button) -> None:
