    def build_architecture_view(self) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page.set_margin_end(8)
        page.append(text_label("Application architecture", "section-title"))
        page.append(text_label(
            "Setup provides the initial choice. Changing it here affects future SHAPP installs only; "
            "it does not migrate, remove, or redeploy existing services.",
            "app-detail",
        ))
        self.direct_architecture = Gtk.CheckButton(
            label="Install audited applications directly in Ubuntu"
        )
        self.direct_architecture.add_css_class("choice")
        self.managed_architecture = Gtk.CheckButton(
            label="Use one SHAI-managed Docker stack with separate service containers"
        )
        self.managed_architecture.set_group(self.direct_architecture)
        self.managed_architecture.add_css_class("choice")
        if self.architecture_mode == "managed-stack":
            self.managed_architecture.set_active(True)
        else:
            self.direct_architecture.set_active(True)
        self.direct_architecture.connect(
            "toggled", self.architecture_changed, "direct-host"
        )
        self.managed_architecture.connect(
            "toggled", self.architecture_changed, "managed-stack"
        )
        page.append(self.direct_architecture)
        page.append(text_label(
            "Host-native Ubuntu packages are available now. Additional direct-host installers "
            "become selectable only after their install and uninstall paths pass validation.",
            "muted",
        ))
        page.append(self.managed_architecture)
        page.append(text_label(
            "Docker is not installed or changed by this selector. Container-backed entries remain "
            "available only for services with reviewed container recipes. Network and radio setup may still be required.",
            "muted",
        ))
        self.architecture_state = text_label("", "online")
        self.architecture_state.add_css_class("live-setting")
        page.append(self.architecture_state)
        self.update_architecture_state()
        return page

    def update_architecture_state(self) -> None:
        label = (
            "Direct Ubuntu installation"
            if self.architecture_mode == "direct-host"
            else "SHAI-managed Docker stack"
        )
        self.architecture_state.set_text(
            f"LIVE AUTOSAVE · Current: {label} · selected by {self.architecture_source}"
        )

    def architecture_changed(
        self, button: Gtk.CheckButton, architecture: str
    ) -> None:
        if self.architecture_refreshing or not button.get_active():
            return
        if architecture == self.architecture_mode:
            return
        previous = self.architecture_mode
        self.architecture_refreshing = True
        self.direct_architecture.set_active(previous == "direct-host")
        self.managed_architecture.set_active(previous == "managed-stack")
        self.architecture_refreshing = False

        dialog = Gtk.Dialog(
            title="Change application architecture?",
            transient_for=self,
            modal=True,
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        confirm = dialog.add_button("Yes, change architecture", Gtk.ResponseType.OK)
        confirm.add_css_class("suggested-action")
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(18)
        box.set_margin_end(18)
        box.append(text_label(
            "You have changed how applications get installed on this PC.",
            "section-title",
        ))
        box.append(text_label(
            "This live setting affects future SHAPP installs. It does not migrate or remove "
            "applications already installed. SHAPP will restart so the catalog can be rebuilt "
            "for the new architecture.",
            "app-detail",
        ))
        dialog.connect("response", self.architecture_confirmation, architecture)
        dialog.present()

    def architecture_confirmation(
        self, dialog: Gtk.Dialog, response: int, architecture: str
    ) -> None:
        dialog.close()
        if response != Gtk.ResponseType.OK:
            self.show_status("Architecture change cancelled. No setting was changed.")
            return
        self.architecture_mode = architecture
        self.architecture_source = "SHAPP live autosave"
        save_architecture(architecture)
        append_log("ARCHITECTURE", "shapp", architecture, "Live setting; SHAPP restart")
        self.update_architecture_state()
        self.show_status("Architecture saved. Restarting SHAPP with the new catalog mode.")
        subprocess.Popen(
            ["bash", "-lc", "sleep 0.5; exec /usr/bin/shai-shapp"],
            start_new_session=True,
        )
        self.get_application().quit()

    def catalog_status(self, item: dict[str, object], available: bool) -> str:
        if available:
            if self.architecture_mode == "managed-stack" and item.get("container_service"):
                return "Advanced Docker service · persistent data · private SHAI bridge"
            return str(item.get("status", "Available"))
        if item.get('host_backend') == 'veracrypt' and platform.machine().lower() not in {'x86_64', 'amd64'}:
            return 'Reviewed VeraCrypt installer requires amd64 Ubuntu'
        if self.architecture_mode == 'managed-stack' and item.get('container_service'):
            if platform.machine().lower() not in {'x86_64', 'amd64', 'aarch64', 'arm64'}:
                return 'Docker backend requires amd64 or arm64 hardware'
            if (os.cpu_count() or 0) < 2:
                return 'Docker backend requires at least 2 logical CPUs'
        mode = "Direct Ubuntu" if self.architecture_mode == "direct-host" else "Managed Docker"
        if self.architecture_mode == 'direct-host' and item.get('container_service'):
            return f"Requires Advanced Docker architecture | {item.get('status', '')}"
        return f"{mode} installer pending · {item.get('status', 'backend unavailable')}"

    def item_keys(self, item: dict[str, object]) -> list[str]:
        service = item.get("container_service")
        if self.architecture_mode == "managed-stack" and service:
            return [f"container:{service}"]
        if item.get('host_backend'):
            return [f"managed:{item['id']}"]
        return [f"apt:{package}" for package in item["packages"]]

    def backend_available(self, item: dict[str, object]) -> bool:
        if item.get('host_backend') and not (self.architecture_mode == 'managed-stack' and item.get('container_service')):
            if item.get('host_backend') == 'veracrypt':
                return platform.machine().lower() in {'x86_64', 'amd64'}
            return True
        if self.architecture_mode == "managed-stack" and item.get("container_service"):
            if platform.machine().lower() not in {'x86_64', 'amd64', 'aarch64', 'arm64'} or (os.cpu_count() or 0) < 2:
                return False
            if item.get("container_service") in {"zigbee2mqtt", 'zwavejs'}:
                directory = Path("/dev/serial/by-id")
                return directory.is_dir() and len(list(directory.glob("*"))) == 1
            return True
        return bool(item.get("available", True)) and bool(item["packages"])

    def stack_capacity_restrictions(self, ram_total: int, extra: dict[str, object] | None = None) -> list[str]:
        if self.architecture_mode != 'managed-stack':
            return []
        selected = set()
        installing = False
        for item in self.catalog:
            service = item.get('container_service')
            key = f'container:{service}'
            if service and self.desired.get(key, self.baseline.get(key, False)):
                selected.add(str(service))
                installing |= not self.baseline.get(key, False)
        if extra and extra.get('container_service'):
            service = str(extra['container_service'])
            selected.add(service)
            installing |= not self.baseline.get(f'container:{service}', False)
        if not installing:
            return []
        if 'zigbee2mqtt' in selected:
            selected.add('mosquitto')
        try:
            catalog = json.loads(STACK_CATALOG.read_text(encoding='utf-8'))['services']
            required_ram = 2048 + sum(int(catalog[key]['minimum_ram_mb']) for key in selected)
            required_disk = 10240 + sum(int(catalog[key]['minimum_disk_mb']) for key in selected)
            free_disk = shutil.disk_usage('/var/lib').free // (1024 * 1024)
        except (OSError, ValueError, KeyError, TypeError):
            return ['Docker capacity assessment unavailable']
        failures = []
        if ram_total < required_ram:
            failures.append(f'Docker workload plus Ubuntu reserve needs {required_ram} MB RAM')
        if free_disk < required_disk:
            failures.append(f'Docker workload plus safety reserve needs {required_disk} MB free on /var/lib')
        return failures

