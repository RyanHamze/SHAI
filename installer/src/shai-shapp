    def terminal_command(self, plan: Path) -> list[str] | None:
        completion = shlex.quote(str(plan.with_suffix('.exit')))
        exit_trap = f'rc=$?; trap - EXIT; printf "%s\\n" "$rc" > {completion}'
        script = (
            f"trap {shlex.quote(exit_trap)} EXIT; "
            "trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; "
            f"sudo /usr/bin/shai-shapp-apply {shlex.quote(str(plan))}; "
            f"rc=$?; printf '%s\\n' \"$rc\" > {completion}; trap - EXIT; echo; "
            "if [ $rc -eq 0 ]; then echo 'SHAPP completed successfully.'; "
            "else echo \"SHAPP stopped with exit code $rc.\"; fi; "
            "echo 'This window will remain open for review. Press Enter to close.'; read; exit $rc"
        )
        if shutil.which("ptyxis"):
            return ["ptyxis", "--standalone", "--title", "SHAPP - Apply Changes", "--", "bash", "-lc", script]
        if shutil.which("gnome-terminal"):
            return ["gnome-terminal", "--title=SHAPP - Apply Changes", "--", "bash", "-lc", script]
        terminal = shutil.which("x-terminal-emulator")
        return [terminal, "-e", "bash", "-lc", script] if terminal else None

    def apply_changes(self, _button: Gtk.Button) -> None:
        if self.applying:
            return
        installs, removals = self.changes()
        if not installs and not removals:
            return
        disk, ram, _ = self.change_totals(installs, removals)
        if not self.update_capacity_controls(disk, ram, system_capacity_mb()):
            self.show_status("Capacity exceeded; remove a selection before applying.")
            return
        plan_id = str(uuid.uuid4())
        plan_data = {
            "schema": 4,
            "plan_id": plan_id,
            "target_user": os.environ.get("USER", ""),
            "architecture": self.architecture_mode,
            "install": [str(item["id"]) for item in installs],
            "remove_apt": sorted({app.package for app in removals if app.source == "apt"}),
            "remove_snap": sorted({app.package for app in removals if app.source == "snap"}),
            "remove_container": sorted({app.package for app in removals if app.source == "container"}),
            "remove_managed": sorted({app.package for app in removals if app.source == "managed"}),
        }
        cache = Path.home() / ".cache/shai"
        cache.mkdir(parents=True, exist_ok=True, mode=0o700)
        plan = cache / f"shapp-{plan_id}.json"
        plan.write_text(json.dumps(plan_data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        plan.chmod(0o600)
        for item in installs:
            append_log("STAGED_INSTALL", "catalog", str(item["id"]), str(item["name"]))
        for app in removals:
            append_log("STAGED_UNINSTALL", app.source, app.package, app.name)
        command_line = self.terminal_command(plan)
        if command_line is None:
            self.show_status("No supported terminal is available. No changes were made.")
            return
        try:
            subprocess.Popen(command_line, start_new_session=True)
        except OSError as exc:
            self.show_status(f"Could not open the terminal: {exc}")
            return
        self.plan_id = plan_id
        self.completion_path = plan.with_suffix('.exit')
        self.applying = True
        self.apply_button.set_sensitive(False)
        self.show_status("Visible terminal opened. Enter sudo authentication there.")
        GLib.timeout_add_seconds(1, self.poll_result)

    def poll_result(self) -> bool:
        try:
            result = json.loads(RESULT.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            result = {}
        if result.get("plan_id") != self.plan_id:
            if self.completion_path is not None:
                try:
                    code = int(self.completion_path.read_text(encoding='utf-8').strip())
                except (OSError, ValueError):
                    return True
                self.applying = False
                self.show_status(f'Terminal operation ended (exit {code}) without a completion record. Review the terminal; you can retry. A running backend blocks duplicate applies.')
                self.refresh_cart()
                return False
            return True
        self.applying = False
        message = str(result.get("message", "Package operation finished."))
        log_file = str(result.get("log_file", daily_log_path()))
        self.show_status(f"{message}\nDaily log: {log_file}")
        if result.get("status") == "success":
            self.apt_installed = installed_apt_packages()
            self.snap_installed = installed_snaps()
            self.container_installed = installed_containers()
            self.managed_installed = {path.stem for path in (Path('/var/lib/shai/apps') / os.environ.get('USER', '')).glob('*.json')}
            self.baseline = {f"apt:{package}": True for package in self.apt_installed}
            self.baseline.update({f"snap:{package}": True for package in self.snap_installed})
            self.baseline.update({f"container:{service}": True for service in self.container_installed})
            self.baseline.update({f"managed:{app_id}": True for app_id in self.managed_installed})
            self.desired = dict(self.baseline)
            self.installed_apps = discover_apps(self.patterns, self.catalog)
            for item in self.catalog:
                if item['id'] in self.managed_installed:
                    self.installed_apps.append(InstalledApp('managed', item['id'], item['name'], item['description'], int(item['disk_mb']), int(item['ram_mb']), False))
            for item in self.catalog:
                service = item.get("container_service")
                if service in self.container_installed:
                    display_name = str(item['name']) + (' (runtime staged; not activated)' if service == 'matter-server' else '')
                    self.installed_apps.append(InstalledApp(
                        "container", str(service), display_name,
                        str(item["description"]), int(item["disk_mb"]),
                        int(item["ram_mb"]), False,
                    ))
            self.installed_apps.sort(key=lambda app: app.name.casefold())
            log_discovered_apps(self.installed_apps, "SHAPP refreshed after changes")
            self.rebuild_installed()
            self.sync_checks()
            self.refresh_cart()
        else:
            append_log("FAILED", "shapp", self.plan_id, message)
            self.refresh_cart()
        return False


class ShappApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def do_activate(self) -> None:
        if os.geteuid() == 0:
            raise SystemExit("Run SHAPP as the normal desktop user, without sudo.")
        window = self.props.active_window or ShappWindow(self)
        window.present()


def main() -> int:
    if not CATALOG.exists():
        raise SystemExit(f"SHAPP catalog is missing: {CATALOG}")
    return ShappApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
