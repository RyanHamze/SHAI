#!/usr/bin/env python3
"""Privileged SHAI Control Center approval helper; invoked through pkexec."""
from __future__ import annotations

import json
import os
import sys
import urllib.request
import urllib.error
from pathlib import Path

TOKEN = Path("/etc/shai/secrets/control-approval-token")

def main() -> None:
    if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[2] not in {"approve", "reject"}:
        raise SystemExit("usage: shai-control-approve PROPOSAL_ID approve|reject")
    proposal_id, choice = sys.argv[1:]
    if not proposal_id.replace("-", "").replace("_", "").isalnum(): raise SystemExit("invalid proposal ID")
    request = urllib.request.Request(
        f"http://127.0.0.1:11500/v1/proposals/{proposal_id}/{choice}", data=b"{}",
        headers={"Authorization": f"Bearer {TOKEN.read_text(encoding='utf-8').strip()}"}, method="POST",
    )
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=180) as response:
            print(json.dumps(json.loads(response.read().decode("utf-8")), indent=2))
    except urllib.error.HTTPError as exc:
        detail = json.loads(exc.read().decode("utf-8"))
        raise SystemExit(str(detail.get("result", detail.get("error", str(exc)))))
    except OSError as exc:
        raise SystemExit(f"Control broker unavailable: {exc}")

if __name__ == "__main__": main()
