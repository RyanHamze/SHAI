#!/usr/bin/env python3
"""Refresh only verified SHAI launchers; never trust arbitrary desktop files."""
import argparse
import ast
import configparser
import os
from pathlib import Path
import pwd
import shutil
import stat
import subprocess
import sys

APPLICATIONS = Path('/usr/share/applications')
STATE = Path('/var/lib/shai-installer')
LAUNCHERS = {
    'shai-shapp.desktop': 'shai-shapp.desktop',
    'shai-health.desktop': 'com.aabey.shai.Health.desktop',
    'shai-aia.desktop': 'com.aabey.shai.AIA.desktop',
    'shai-web-connectivity-toggle.desktop': 'shai-web-connectivity-toggle.desktop',
    'shai-setup.desktop': 'shai-setup.desktop',
}
LEGACY = {
    'shai-home.desktop': {'shai-wave-a-shell home', 'shai-setup'},
    'shai-appearance.desktop': {'shai-appearance'},
    'shai-setup.desktop': {'shai-setup'},
}

def desktop_exec(path):
    if path.is_symlink() or not path.is_file():
        return None
    config = configparser.ConfigParser(interpolation=None)
    try:
        config.read_string(path.read_text())
        return config['Desktop Entry']['Exec']
    except (OSError, UnicodeError, configparser.Error, KeyError):
        return None

def remove_known(path, commands):
    if desktop_exec(path) in commands:
        path.unlink()
        print(f'Removed obsolete SHAI shortcut: {path}', flush=True)

def trusted_candidate(path, canonical, uid):
    if path.is_symlink() or canonical.is_symlink() or not path.is_file() or not canonical.is_file():
        return False
    own, source = path.stat(), canonical.stat()
    return (own.st_uid == uid and not own.st_mode & 0o022
            and source.st_uid == 0 and not source.st_mode & 0o022
            and path.read_bytes() == canonical.read_bytes())

def sync_user():
    home = Path.home().resolve()
    if shutil.which('xdg-user-dir'):
        value = subprocess.check_output(['xdg-user-dir', 'DESKTOP'], text=True).strip()
        desktop = Path(value).resolve() if value else home / 'Desktop'
    else:
        desktop = home / 'Desktop'
    if desktop == home or not desktop.is_relative_to(home):
        raise SystemExit('Desktop is not a dedicated directory within this user home; no shortcut changes made')
    completed = (STATE / 'applied-version').is_file()
    if desktop.is_dir():
        for name, commands in LEGACY.items():
            if name != 'shai-setup.desktop' or completed:
                remove_known(desktop / name, commands)
        if desktop.stat().st_mode & 0o022:
            raise SystemExit('Desktop is writable by another user; fix its permissions before trusting launchers')
        for name, source in LAUNCHERS.items():
            path = desktop / name
            if not path.exists():
                continue
            if not trusted_candidate(path, APPLICATIONS / source, os.getuid()):
                print(f'Not trusting modified or unsafe launcher: {path}', flush=True)
                continue
            path.chmod(0o755)
            subprocess.run(['gio', 'set', '-t', 'string', str(path), 'metadata::trusted', 'true'], check=True)
            result = subprocess.check_output(['gio', 'info', '-a', 'metadata::trusted', str(path)], text=True,
                                             env={**os.environ, 'LC_ALL': 'C'})
            if 'metadata::trusted: true' not in result:
                raise SystemExit(f'Trust metadata did not persist for {path}; use Allow Launching in the desktop menu')
            print(f'Verified trusted launcher: {name}', flush=True)
    result = subprocess.run(['gsettings', 'get', 'org.gnome.shell', 'favorite-apps'], text=True, capture_output=True)
    if result.returncode == 0:
        value = result.stdout.strip()
        favorites = ast.literal_eval(value[4:] if value.startswith('@as ') else value)
        obsolete = {'shai-home.desktop', 'shai-appearance.desktop'}
        if completed:
            obsolete.add('shai-setup.desktop')
        updated = [item for item in favorites if item not in obsolete]
        if updated != favorites:
            subprocess.run(['gsettings', 'set', 'org.gnome.shell', 'favorite-apps', repr(updated)], check=True)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--user')
    args = parser.parse_args()
    if os.geteuid() == 0:
        if not args.user:
            raise SystemExit('Specify the desktop user with --user')
        account = pwd.getpwnam(args.user)
        if account.pw_uid < 1000:
            raise SystemExit('A regular desktop user is required')
        for name in ('shai-home.desktop', 'shai-appearance.desktop'):
            remove_known(APPLICATIONS / name, LEGACY[name])
        runtime = f'/run/user/{account.pw_uid}'
        subprocess.run(['runuser', '-u', account.pw_name, '--', 'env', f'HOME={account.pw_dir}',
                        f'XDG_RUNTIME_DIR={runtime}', f'DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus',
                        sys.executable, __file__], check=True)
    else:
        if args.user and args.user != pwd.getpwuid(os.getuid()).pw_name:
            raise SystemExit('Cannot change another desktop user')
        sync_user()

if __name__ == '__main__':
    main()
