#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shai-theme"
readonly PREVIOUS="$STATE_DIR/previous.json"
readonly GTK_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"

if [[ ${EUID} -eq 0 ]]; then
    printf 'Run shai-theme-reset as the desktop user, not with sudo.\n' >&2
    exit 1
fi
[[ -f "$PREVIOUS" ]] || { printf 'No saved SHAI theme state was found.\n'; exit 0; }
[[ ! -L "$GTK_FILE" ]] || { printf 'Refusing to replace symbolic link: %s\n' "$GTK_FILE" >&2; exit 1; }

python3 - "$PREVIOUS" "$GTK_FILE" "$STATE_DIR/gtk.css.before" <<'PY'
import json
import pathlib
import shutil
import subprocess
import sys

state_path = pathlib.Path(sys.argv[1])
gtk_file = pathlib.Path(sys.argv[2])
gtk_backup = pathlib.Path(sys.argv[3])
data = json.loads(state_path.read_text(encoding="utf-8"))
locations = {
    "color_scheme": ("org.gnome.desktop.interface", "color-scheme"),
    "icon_theme": ("org.gnome.desktop.interface", "icon-theme"),
    "accent_color": ("org.gnome.desktop.interface", "accent-color"),
    "picture_uri": ("org.gnome.desktop.background", "picture-uri"),
    "picture_uri_dark": ("org.gnome.desktop.background", "picture-uri-dark"),
    "picture_options": ("org.gnome.desktop.background", "picture-options"),
    "enabled_extensions": ("org.gnome.shell", "enabled-extensions"),
    "shell_theme": ("org.gnome.shell.extensions.user-theme", "name"),
}
for name, value in data.get("settings", {}).items():
    if value is None or name not in locations:
        continue
    subprocess.run(["gsettings", "set", *locations[name], value], check=False)

if data.get("gtk_css_existed") and gtk_backup.is_file():
    gtk_file.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(gtk_backup, gtk_file)
else:
    gtk_file.unlink(missing_ok=True)
PY

rm -f -- "$PREVIOUS" "$STATE_DIR/status.json"
printf 'Previous desktop theme settings restored. Log out and back in to finish.\n'
