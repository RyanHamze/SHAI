#!/usr/bin/env python3
"""Honest setup-stage shells for SHAI Home, SHAPP, SHAI Health, and AIA."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, Gtk  # noqa: E402


STATE = Path(
    os.environ.get("SHAI_SETUP_STATE", "/var/lib/shai-installer/setup-choices.json")
)
BRAND = Path(
    os.environ.get("SHAI_BRAND_LOCKUP", "/usr/share/shai/branding/shai-lockup-dark.svg")
)
SUMMARY = Path(
    os.environ.get("SHAI_SYSTEM_SUMMARY", "/var/lib/shai-installer/system-summary.txt")
)
CSS = b"""
window { background: #0B0F0C; color: #DDFBE0; }
.header { background: #111812; border-bottom: 1px solid #263A2B; padding: 14px 20px; }
.content { padding: 24px; }
.title { color: #DDFBE0; font-size: 24px; font-weight: 700; }
.subtitle { color: #93A89A; }
.status { background: #111812; border: 1px solid #263A2B; border-radius: 5px; padding: 14px; }
.green { color: #33EE33; font-weight: 700; }
.warning { background: #241F10; border: 1px solid #8F7628; color: #FFE49A; border-radius: 5px; padding: 12px; }
button { background: #162019; color: #DDFBE0; border: 1px solid #354837; border-radius: 4px; padding: 9px 16px; }
button.suggested-action { background: #33EE33; color: #071008; border-color: #33EE33; font-weight: 700; }
button.sponsor-link { background: transparent; color: #8DF28D; border: 0; padding: 5px; }
"""


def label(text: str, css: str | None = None) -> Gtk.Label:
    item = Gtk.Label(label=text, xalign=0)
    item.set_wrap(True)
    if css:
        item.add_css_class(css)
    return item


def read_state() -> dict[str, object]:
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


class ShellWindow(Gtk.ApplicationWindow):
    TITLES = {
        "home": "SHAI Home",
        "shapp": "SHAPP - SHAI App Manager",
        "health": "SHAI Health",
        "aia": "AIA - AI Advisor",
    }

    def __init__(self, app: Gtk.Application, mode: str) -> None:
        title = self.TITLES.get(mode, "SHAI")
        super().__init__(application=app, title=title)
        self.mode = mode
        self.state = read_state()
        self.set_default_size(900, 600)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        root.append(self.header())
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.add_css_class("content")
        root.append(content)
        getattr(self, f"build_{mode}", self.build_home)(content)

    def header(self) -> Gtk.Widget:
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        header.add_css_class("header")
        if BRAND.exists():
            picture = Gtk.Picture.new_for_filename(str(BRAND))
            picture.set_content_fit(Gtk.ContentFit.CONTAIN)
            picture.set_size_request(300, 52)
            picture.set_halign(Gtk.Align.START)
            header.append(picture)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)
        sponsor = Gtk.LinkButton.new_with_label(
            "https://aabeyllc.com", "Brought to you by Aabey LLC"
        )
        sponsor.add_css_class("sponsor-link")
        header.append(sponsor)
        return header

    def choices(self) -> str:
        architecture = self.state.get("architecture", "not recorded")
        if architecture == "managed-stack":
            architecture = "One SHAI-managed Docker stack (advanced)"
        elif architecture == "direct-host":
            architecture = "Direct Ubuntu installation (simple)"
        return (
            f"Architecture: {architecture}\n"
            f"Smart home: {'Yes' if self.state.get('smart_home') else 'No'}\n"
            f"Local AI: {'Yes' if self.state.get('local_ai') else 'No'}\n"
            f"Offline by default: {'Yes' if self.state.get('offline_mode') else 'No'}\n"
            f"Theme: SHAI desktop theme"
        )

    def button(self, text: str, mode: str, primary: bool = False) -> Gtk.Button:
        button = Gtk.Button(label=text)
        if primary:
            button.add_css_class("suggested-action")
        button.connect("clicked", lambda *_: self.launch(mode))
        return button

    @staticmethod
    def launch(mode: str) -> None:
        executable = shutil.which("shai-appearance" if mode == "appearance" else "shai-wave-a-shell")
        if executable:
            command = [executable] if mode == "appearance" else [executable, mode]
            subprocess.Popen(command, start_new_session=True)

    def build_home(self, content: Gtk.Box) -> None:
        content.append(label("SHAI Home", "title"))
        content.append(label(
            "Your Ubuntu installation has completed SHAI Setup.", "subtitle"
        ))
        content.append(label(self.choices(), "status"))
        try:
            summary_text = SUMMARY.read_text(encoding="utf-8")
        except OSError:
            summary_text = "The completed-system summary is unavailable."
        summary = Gtk.TextView()
        summary.set_editable(False)
        summary.set_cursor_visible(False)
        summary.set_monospace(True)
        summary.set_vexpand(True)
        summary.set_size_request(-1, 260)
        summary.get_buffer().set_text(summary_text)
        content.append(summary)
        content.append(label(
            "Setup installed the tested base profile, v2 desktop theme, Web Offline toggle, "
            "and app launchers. Live Home Assistant, device, AI, port, firewall, and update "
            "panels arrive in their implementation waves and are not simulated here.",
            "warning",
        ))
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.append(self.button("Open SHAPP", "shapp", True))
        row.append(self.button("Open SHAI Health", "health"))
        row.append(self.button("Appearance", "appearance"))
        if self.state.get("local_ai"):
            row.append(self.button("Open AIA", "aia"))
        content.append(row)

    def build_shapp(self, content: Gtk.Box) -> None:
        content.append(label("SHAPP - application selection comes next", "title"))
        content.append(label(
            "Setup saved the main architecture. SHAPP will be where you select Home Assistant, "
            "Mosquitto, Zigbee2MQTT, Z-Wave JS, ESPHome, Matter, Node-RED, media, voice, backup, "
            "and privacy tools.",
            "subtitle",
        ))
        content.append(label(self.choices(), "status"))
        content.append(label(
            "No optional application, Docker Engine, container image, AI runtime, or model was "
            "installed during setup. This honest handoff prevents unfinished controls from making "
            "changes before the SHAPP catalog and lifecycle engine are built and tested.",
            "warning",
        ))

    def build_health(self, content: Gtk.Box) -> None:
        content.append(label("SHAI Health", "title"))
        content.append(label("Base-profile status", "subtitle"))
        content.append(label(
            "Setup result: Applied and validated\n"
            "Monitoring service: Not installed during setup\n"
            "Recovery rules: Disabled\n"
            "Home automation services: Selected later in SHAPP",
            "status",
        ))
        content.append(label(
            "The full monitor, expected-port registry, diagnostics, and explicitly approved "
            "recovery rules are part of the SHAI Health implementation wave.",
            "warning",
        ))

    def build_aia(self, content: Gtk.Box) -> None:
        content.append(label("AIA - AI Advisor", "title"))
        content.append(label("Local AI was selected as an intended capability.", "subtitle"))
        content.append(label(
            "Runtime: Not installed\nModel: None\nVoice tools: None\nNetwork access: Off",
            "status",
        ))
        content.append(label(
            "AIA will later assess CPU, RAM, GPU/VRAM, storage, and smart-home reserves before "
            "recommending No AI or reviewed local models. Setup never downloads model weights.",
            "warning",
        ))


class ShellApplication(Gtk.Application):
    def __init__(self, mode: str) -> None:
        safe_mode = mode if mode in ShellWindow.TITLES else "home"
        self.mode = safe_mode
        super().__init__(
            application_id=f"com.aabey.shai.{safe_mode.title()}",
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def do_activate(self) -> None:
        window = ShellWindow(self, self.mode)
        window.present()


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else "home"
    return ShellApplication(mode).run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
