#!/usr/bin/env python3
"""Unprivileged loopback inference gateway with shared local context, never a shell."""
import hmac
import http.client
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import subprocess
import sys
import threading
import time

KEY = Path.home() / '.local/state/shai/aia/server-api-key'
HELPER = Path('/usr/lib/shai-installer/shai-context')
context = None
MAX_BODY = 2097152
BACKEND_PORT = 11435

def verify_backend(connection):
    """Verify the established peer socket belongs to this user's model service.

    A loopback port alone is not server identity: another UID could bind it
    while the real service is down. Check before sending any key or chat data.
    """
    result = subprocess.run(['systemctl', '--user', 'show', 'shai-aia-model.service',
                             '--property=MainPID', '--property=ActiveState'],
                            capture_output=True, text=True, timeout=4, check=False)
    fields = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    pid = fields.get('MainPID', '0')
    if result.returncode or fields.get('ActiveState') != 'active' or not pid.isdigit() or int(pid) <= 0:
        raise ValueError('Model service identity unavailable')
    process = Path('/proc') / pid
    if process.stat().st_uid != os.getuid():
        raise ValueError('Wrong model service owner')
    client_port = connection.sock.getsockname()[1]
    local = f'0100007F:{BACKEND_PORT:04X}'
    remote = f'0100007F:{client_port:04X}'
    deadline = time.monotonic() + 1
    while time.monotonic() < deadline:
        for line in Path('/proc/self/net/tcp').read_text().splitlines()[1:]:
            row = line.split()
            if len(row) >= 10 and row[1:4] == [local, remote, '01']:
                if int(row[7]) != os.getuid():
                    # Linux can expose UID 0/inode 0 before accept() assigns
                    # the server socket. Retry, but never send data unverified.
                    continue
                target = 'socket:[' + row[9] + ']'
                for descriptor in (process / 'fd').iterdir():
                    try:
                        if os.readlink(descriptor) == target:
                            return
                    except FileNotFoundError:
                        continue
        time.sleep(0.02)
    raise ValueError('Inference peer does not belong to the model service')

class LocalServer(ThreadingHTTPServer):
    daemon_threads = True
    def __init__(self, *args, **kwargs):
        self.slots = threading.BoundedSemaphore(4)
        super().__init__(*args, **kwargs)

    def process_request(self, request, address):
        request.settimeout(5)
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, address)
        except BaseException:
            self.slots.release()
            raise

    def process_request_thread(self, request, address):
        try:
            super().process_request_thread(request, address)
        finally:
            self.slots.release()

def key_value():
    if KEY.is_symlink() or not KEY.is_file() or KEY.stat().st_mode & 0o077:
        raise ValueError('private inference credential is missing or unsafe')
    value = KEY.read_text().strip()
    if not value:
        raise ValueError('private inference credential is empty')
    return value

def spec():
    return {'openapi': '3.0.3', 'info': {'title': 'SHAI Local Memory', 'version': '1'},
            'servers': [{'url': 'http://127.0.0.1:11437'}],
            'components': {'securitySchemes': {'BearerAuth': {'type': 'http', 'scheme': 'bearer'}}},
            'security': [{'BearerAuth': []}],
            'paths': {'/v1/shai/context': {'get': {'operationId': 'getShaiContext',
                       'summary': 'Read current sanitized AIA configuration, integrations, SHEALTH, SHAPP, system state and memory. No credentials or raw logs.',
                       'responses': {'200': {'description': 'Current local context'}}}},
                      '/v1/shai/memory': {'get': {'operationId': 'getShaiMemory',
                       'summary': 'Read shared local notes and the private memory location',
                       'responses': {'200': {'description': 'Local memory'}}}}}}

class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.0'
    def log_message(self, *_args):
        pass  # Never log chat bodies, headers or credentials.

    def reply(self, status, value):
        payload = json.dumps(value).encode()
        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(payload)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(payload)

    def authenticate(self):
        try:
            key = key_value()
        except (OSError, ValueError):
            self.reply(503, {'error': 'Private inference credential unavailable; repair through AIA'})
            return None
        supplied = self.headers.get('Authorization', '')
        if not hmac.compare_digest(supplied.encode(), ('Bearer ' + key).encode()):
            self.reply(401, {'error': 'Inference authorization required'})
            return None
        return key

    def do_GET(self):
        if self.path == '/openapi.json':
            return self.reply(200, spec())
        key = self.authenticate()
        if key is None:
            return
        if self.path in {'/v1/shai/context', '/v1/shai/memory'}:
            try:
                data = context.refresh()
                if self.path.endswith('/memory'):
                    data = {'generated_at': data['generated_at'], 'storage': data['storage'], 'notes': data['notes']}
                return self.reply(200, data)
            except (OSError, ValueError, TypeError):
                return self.reply(503, {'error': 'Local context cannot be refreshed; inspect local memory permissions/configuration'})
        if self.path not in {'/health', '/v1/models'}:
            return self.reply(404, {'error': 'Unknown local endpoint'})
        self.forward('GET', self.path, None, key)

    def do_POST(self):
        key = self.authenticate()
        if key is None:
            return
        if self.path != '/v1/chat/completions':
            return self.reply(404, {'error': 'No write/configuration/command endpoint is exposed here'})
        try:
            length = int(self.headers.get('Content-Length', '0'))
            if not 0 < length <= MAX_BODY or self.headers.get('Transfer-Encoding'):
                raise ValueError('Invalid request size')
            body = json.loads(self.rfile.read(length))
            messages = body.get('messages') if isinstance(body, dict) else None
            if not isinstance(messages, list) or not messages or len(messages) > 100:
                raise ValueError('Chat messages are required')
            if any(not isinstance(item, dict) or item.get('role') not in {'system', 'user', 'assistant', 'tool'} for item in messages):
                raise ValueError('Invalid chat role')
        except (ValueError, TypeError, OSError):
            return self.reply(400, {'error': 'Invalid chat payload; no inference performed'})
        try:
            body['messages'] = context.inject(messages, context.refresh())
            payload = json.dumps(body).encode()
            if len(payload) > MAX_BODY:
                raise ValueError('Context and chat exceed request limit')
        except (ValueError, TypeError, OSError):
            return self.reply(503, {'error': 'Shared local context unavailable or too large. Inspect shai-context.service and local memory permissions; no inference performed'})
        self.forward('POST', '/v1/chat/completions', payload, key)

    def forward(self, method, path, body, key):
        # Fixed upstream: request data cannot choose a host, filesystem path or command.
        connection = http.client.HTTPConnection('127.0.0.1', BACKEND_PORT, timeout=180)
        started = False
        try:
            connection.connect()
            verify_backend(connection)
            connection.request(method, path, body, {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json'})
            response = connection.getresponse()
            self.send_response(response.status)
            self.send_header('Content-Type', response.getheader('Content-Type', 'application/json'))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('Connection', 'close')
            self.end_headers()
            started = True
            # read1 preserves streamed Open WebUI tokens instead of buffering the whole answer.
            while chunk := response.read1(8192):
                self.wfile.write(chunk)
                self.wfile.flush()
        except (OSError, ValueError, subprocess.SubprocessError, http.client.HTTPException):
            if not started:
                self.reply(502, {'error': 'Local model backend unavailable or identity check failed; inspect shai-aia-model.service'})
        finally:
            connection.close()
            self.close_connection = True

def main():
    global context
    if os.geteuid() == 0:
        raise SystemExit('Run shared context as the desktop user, not root')
    try:
        key_value()
        loader = importlib.machinery.SourceFileLoader('shai_local_context', str(HELPER))
        context = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(context)
        context.refresh()
    except (OSError, ValueError, TypeError):
        print('SHAI local memory startup failed. Inspect the private key, context helper and memory permissions; repair in AIA before restarting.', file=sys.stderr)
        raise SystemExit(78)
    server = LocalServer(('127.0.0.1', 11437), Handler)
    server.serve_forever()

if __name__ == '__main__':
    main()
