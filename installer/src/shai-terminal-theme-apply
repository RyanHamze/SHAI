#!/usr/bin/env bash
set -Eeuo pipefail

readonly PALETTE_SOURCE="/usr/lib/shai-installer/assets/shai.palette"
readonly PALETTE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/org.gnome.Ptyxis/palettes"

if [[ ${EUID} -eq 0 ]]; then
    printf 'Run shai-terminal-theme-apply as the desktop user, not with sudo.\n' >&2
    exit 1
fi
[[ -f "$PALETTE_SOURCE" ]] || { printf 'SHAI terminal palette is missing.\n' >&2; exit 1; }

install -d -m 0700 "$PALETTE_DIR"
install -m 0644 "$PALETTE_SOURCE" "$PALETTE_DIR/shai.palette"

profile_ids() {
    python3 - "$1" <<'PY'
import ast
import sys

raw = sys.argv[1]
if raw.startswith("@as "):
    raw = raw[4:]
for item in ast.literal_eval(raw):
    print(item)
PY
}

if gsettings list-schemas | grep -Fxq org.gnome.Ptyxis; then
    profiles="$(gsettings get org.gnome.Ptyxis profile-uuids 2>/dev/null || printf '[]')"
    while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        gsettings set "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" palette shai
        gsettings set "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" opacity 1.0
    done < <(profile_ids "$profiles")
fi

if gsettings list-schemas | grep -Fxq org.gnome.Terminal.ProfilesList; then
    profiles="$(gsettings get org.gnome.Terminal.ProfilesList list 2>/dev/null || printf '[]')"
    while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        path="org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:$uuid/"
        gsettings set "$path" use-theme-colors false
        gsettings set "$path" foreground-color '#33EE33'
        gsettings set "$path" background-color '#000000'
    done < <(profile_ids "$profiles")
fi

printf 'SHAI terminal theme applied: black background and #33EE33 foreground.\n'
